tion\n    confs   = r.boxes.conf.cpu().numpy()\n    classes = r.boxes.cls.cpu().numpy().astype(int)\n    best_i  = int(np.argmax(confs))\n    best_cls = classes[best_i]      # 0=Meningioma, 1=Glioma, 2=Pituitary\n    best_conf = float(confs[best_i])\n\n    # Remap YOLO class → mat label\n    # YOLO: 0→Meningioma(1), 1→Glioma(2), 2→Pituitary(3)\n    pred_mat_class = best_cls + 1  # 1, 2, or 3\n\n    # Extract mask for best detection\n    seg_mask = None\n    if r.masks is not None:\n        masks_np = r.masks.data.cpu().numpy()   # (N, H, W) binary\n        seg_mask = masks_np[best_i]             # (H, W)\n\n    return pred_mat_class, best_conf, seg_mask, r\n\n\nprint('predict_single() helper defined.')","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 11. Helper — Gate Function\n\nSince YOLO only knows the 4 MRI classes, we need a lightweight **Non-MRI gate**:  \nif YOLO's maximum detection confidence across all predictions is below `GATE_CONF_THRESH`, we label the image as Non-MRI.\n\nThis works because real MRI tumour scans produce confident detections, while random/non-MRI images produce only low-confidence noise.","metadata":{}},{"cell_type":"markdown","source":"## 12. Test Set Inference\n\nFull gated pipeline on the locked test set:\n\n1. Load image from `.mat`  \n2. Run YOLOv11n-seg  \n3. Gate: low confidence → Non-MRI  \n4. Collect predictions, segmentation masks, and ground truth for metrics","metadata":{}},{"cell_type":"code","source":"# ── Helper to prep image for inference ──\ndef mat_to_bgr(mat_path, size=640):\n    img, mask, lbl = load_mat(mat_path)\n    img_rs   = cv2.resize(img,  (size, size), interpolation=cv2.INTER_LINEAR)\n    mask_rs  = cv2.resize(mask, (size, size), interpolation=cv2.INTER_NEAREST)\n    img_norm = (img_rs - img_rs.min()) / (img_rs.max() - img_rs.min() + 1e-8)\n    img_u8   = (img_norm * 255).astype(np.uint8)\n    img_bgr  = cv2.cvtColor(img_u8, cv2.COLOR_GRAY2BGR)\n    return img_bgr, (mask_rs > 0).astype(np.float32), lbl\n\ndef compute_seg_metrics(pred_mask, gt_mask):\n    \"\"\"Compute Dice, IoU, sensitivity, specificity on binary masks.\"\"\"\n    p = (pred_mask > 0.5).astype(np.float32).flatten()\n    t = (gt_mask   > 0.5).astype(np.float32).flatten()\n    inter = (p * t).sum()\n    TP = inter\n    FP = p.sum() - TP\n    FN = t.sum() - TP\n    TN = len(p) - TP - FP - FN\n    dice = (2*TP + 1e-6) / (p.sum() + t.sum() + 1e-6)\n    iou  = (TP + 1e-6) / (TP + FP + FN + 1e-6)\n    sens = (TP + 1e-6) / (TP + FN + 1e-6)\n    spec = (TN + 1e-6) / (TN + FP + 1e-6)\n    prec = (TP + 1e-6) / (TP + FP + 1e-6)\n    return dict(dice=dice, iou=iou, sensitivity=sens, specificity=spec, precision=prec)\n\n# ── Full test inference ──\nprint('Running inference on test set...')\nprint(f'  MRI samples  : {len(test_mri_files)}')\nprint(f'  NonMRI samples: {len(test_nonmri_files)}')\n\nall_true, all_pred   = [], []\nmri_true, mri_pred   = [], []\nseg_metrics_list     = []\nconf_list            = []\nviz_samples          = {}\n\n# ── MRI test samples ──\nfor mat_path, true_lbl in tqdm(zip(test_mri_files, test_mri_labels), total=len(test_mri_files)):\n    try:\n        img_bgr, gt_mask, _ = mat_to_bgr(mat_path)\n    except:\n        continue\n\n    pred_cls, max_conf, seg_mask, raw_r = predict_single(model_best, img_bgr)\n    conf_list.append(max_conf)\n\n    all_true.append(true_lbl)\n    all_pred.append(pred_cls)\n    mri_true.append(true_lbl)\n    mri_pred.append(pred_cls)\n\n    # Resize predicted mask to match GT size\n    if seg_mask is not None:\n        seg_resized = cv2.resize(seg_mask.astype(np.float32),\n                                 (IMG_SIZE, IMG_SIZE),\n                                 interpolation=cv2.INTER_NEAREST)\n    else:\n        seg_resized = np.zeros((IMG_SIZE, IMG_SIZE), dtype=np.float32)\n\n    m = compute_seg_metrics(seg_resized, gt_mask)\n    m['true_class'] = true_lbl\n    seg_metrics_list.append(m)\n\n    # Store one sample per class for visualization\n    if true_lbl not in viz_samples:\n        viz_samples[true_lbl] = {\n            'img'     : img_bgr,\n            'gt_mask' : gt_mask,\n            'pred_mask': seg_resized,\n            'pred_cls': pred_cls,\n            'conf'    : max_conf,\n        }\n\n# ── NonMRI test samples ──\nfor mat_path in tqdm(test_nonmri_files, desc='NonMRI'):\n    try:\n        img_bgr, _, _ = mat_to_bgr(mat_path)\n    except:\n        continue\n    _, max_conf, _, _ = predict_single(model_best, img_bgr)\n    # Gate: low confidence → Non-MRI\n    pred_cls = NON_MRI_LABEL if max_conf < GATE_CONF_THRESH else 0\n    all_true.append(NON_MRI_LABEL)\n    all_pred.append(pred_cls)\n\nprint(f'\\nInference complete on {len(all_true)} test images.')","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 13. Classification Metrics","metadata":{}},{"cell_type":"code","source":"# ── Gate (MRI vs NonMRI) ──\ngate_true = [1 if l < NON_MRI_LABEL else 0 for l in all_true]\ngate_pred = [1 if p < NON_MRI_LABEL else 0 for p in all_pred]\ngate_acc  = accuracy_score(gate_true, gate_pred)\ngate_f1   = f1_score(gate_true, gate_pred, zero_division=0)\n\n# ── 4-class MRI ──\nacc_4  = accuracy_score(mri_true, mri_pred)\nf1_4   = f1_score(mri_true, mri_pred, average='macro', zero_division=0)\nprec_4 = precision_score(mri_true, mri_pred, average='macro', zero_division=0)\nrec_4  = recall_score(mri_true, mri_pred, average='macro', zero_division=0)\nkappa  = cohen_kappa_score(mri_true, mri_pred)\nmcc    = matthews_corrcoef(mri_true, mri_pred)\n\n# ── 5-class overall ──\noa5 = accuracy_score(all_true, all_pred)\nof5 = f1_score(all_true, all_pred, average='macro',\n               labels=list(range(5)), zero_division=0)\n\nprint('='*65)\nprint('  FINAL TEST RESULTS — YOLOv11n-seg on BriscMat')\nprint('='*65)\nprint(f'\\n  GATE (MRI vs NonMRI):')\nprint(f'    Accuracy : {gate_acc:.4f}')\nprint(f'    F1       : {gate_f1:.4f}')\nprint(f'\\n  OVERALL (5-class gated pipeline):')\nprint(f'    Accuracy : {oa5:.4f}')\nprint(f'    F1 Macro : {of5:.4f}')\nprint(f'\\n  MRI CLASSIFICATION (4-class):')\nprint(f'    Accuracy  : {acc_4:.4f}')\nprint(f'    F1 Macro  : {f1_4:.4f}')\nprint(f'    Precision : {prec_4:.4f}')\nprint(f'    Recall    : {rec_4:.4f}')\nprint(f'    Kappa     : {kappa:.4f}')\nprint(f'    MCC       : {mcc:.4f}')\nprint('='*65)\n\nprint('\\n  Per-class report (MRI 4-class):')\n# Remap: mri_pred uses labels 0,1,2,3\nprint(classification_report(mri_true, mri_pred,\n                             target_names=MRI_CLASS_NAMES,\n                             labels=[0,1,2,3],\n                             zero_division=0))","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 14. Confusion Matrices","metadata":{}},{"cell_type":"code","source":"fig, axes = plt.subplots(1, 2, figsize=(16, 6))\n\n# Gate\ncm_gate = confusion_matrix(gate_true, gate_pred)\nsns.heatmap(cm_gate, annot=True, fmt='d', cmap='Purples',\n            xticklabels=['NonMRI','MRI'],\n            yticklabels=['NonMRI','MRI'], ax=axes[0])\naxes[0].set_title('Gate: MRI vs NonMRI', fontweight='bold')\naxes[0].set_xlabel('Predicted'); axes[0].set_ylabel('True')\n\n# 4-class MRI\ncm4 = confusion_matrix(mri_true, mri_pred, labels=[0,1,2,3])\nsns.heatmap(cm4, annot=True, fmt='d', cmap='Blues',\n            xticklabels=MRI_CLASS_NAMES,\n            yticklabels=MRI_CLASS_NAMES, ax=axes[1])\naxes[1].set_title('MRI 4-class Classification (YOLOv11n-seg)', fontweight='bold')\naxes[1].set_xlabel('Predicted'); axes[1].set_ylabel('True')\naxes[1].tick_params(axis='x', rotation=15)\n\nplt.suptitle('Confusion Matrices — Test Set', fontsize=14, fontweight='bold')\nplt.tight_layout(); plt.show()","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 15. Segmentation Metrics","metadata":{}},{"cell_type":"code","source":"import pandas as pd\n\nseg_df = pd.DataFrame(seg_metrics_list)\n\nprint('='*60)\nprint('  SEGMENTATION METRICS (MRI samples, test set)')\nprint('='*60)\nfor col in ['dice','iou','sensitivity','specificity','precision']:\n    print(f'  {col:<20}: {seg_df[col].mean():.4f}  (std={seg_df[col].std():.4f})')\n\nprint('\\n  Per-class Dice breakdown:')\nfor c, name in enumerate(MRI_CLASS_NAMES):\n    vals = seg_df[seg_df['true_class'] == c]['dice']\n    if len(vals):\n        print(f'  {name:<15}: mean={vals.mean():.4f}  median={vals.median():.4f}  std={vals.std():.4f}')\n\n# Distribution plots\nfig, axes = plt.subplots(2, 3, figsize=(18, 10))\nseg_cols = ['dice','iou','sensitivity','specificity','precision']\ncolors   = ['#43A047','#1E88E5','#E53935','#8E24AA','#FF6F00']\n\nfor (col, color), ax in zip(zip(seg_cols, colors), axes.flat):\n    ax.hist(seg_df[col].values, bins=30, color=color, edgecolor='white', alpha=0.85)\n    ax.axvline(seg_df[col].mean(), color='black', linestyle='--',\n               linewidth=2, label=f'Mean={seg_df[col].mean():.3f}')\n    ax.set_title(col.capitalize(), fontweight='bold')\n    ax.set_xlabel('Score'); ax.set_ylabel('Count')\n    ax.legend(); ax.grid(True, alpha=0.3)\n\naxes[1, 2].axis('off')   # spare slot\nplt.suptitle('Segmentation Metric Distributions — YOLOv11n-seg Test Set',\n             fontsize=14, fontweight='bold')\nplt.tight_layout(); plt.show()\n\n# Per-class Dice box plot\nfig, ax = plt.subplots(figsize=(10, 5))\nbox_data = [seg_df[seg_df['true_class'] == c]['dice'].values for c in range(4)]\nbp = ax.boxplot(box_data, patch_artist=True)\nfor patch, color in zip(bp['boxes'], CLASS_COLORS[:4]):\n    patch.set_facecolor(color); patch.set_alpha(0.7)\nax.set_xticklabels(MRI_CLASS_NAMES)\nax.set_ylabel('Dice Score')\nax.set_title('Per-class Dice Distribution — YOLOv11n-seg', fontweight='bold')\nax.grid(True, alpha=0.3)\nplt.tight_layout(); plt.show()","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 16. Pictorial Results — One Sample Per Class","metadata":{}},{"cell_type":"code","source":"fig, axes = plt.subplots(len(viz_samples), 4, figsize=(20, len(viz_samples)*4))\nif len(viz_samples) == 1:\n    axes = axes[np.newaxis]\n\ncol_titles = ['Input Image', 'Ground Truth Mask', 'Predicted Mask', 'Overlay']\nfor j, t in enumerate(col_titles):\n    axes[0, j].set_title(t, fontsize=11, fontweight='bold', pad=8)\n\nfor row, lbl in enumerate(sorted(viz_samples.keys())):\n    s = viz_samples[lbl]\n    img      = cv2.cvtColor(s['img'], cv2.COLOR_BGR2GRAY)\n    img_norm = img / 255.0\n    gt_mask  = s['gt_mask']\n    pred_mask= s['pred_mask']\n    pred_cls = s['pred_cls']\n    conf     = s['conf']\n    correct  = (lbl == pred_cls)\n    color    = '#2E7D32' if correct else '#C62828'\n\n    # Col 0\n    axes[row, 0].imshow(img_norm, cmap='gray')\n    axes[row, 0].set_ylabel(\n        f'TRUE: {MRI_CLASS_NAMES[lbl]}\\nPRED: {MRI_CLASS_NAMES[pred_cls]}\\nConf: {conf:.3f}',\n        color=color, fontsize=9, fontweight='bold'\n    )\n\n    # Col 1\n    axes[row, 1].imshow(gt_mask, cmap='hot', vmin=0, vmax=1)\n    axes[row, 1].set_title(f'GT pixels: {int(gt_mask.sum())}', fontsize=8)\n\n    # Col 2\n    axes[row, 2].imshow(pred_mask, cmap='hot', vmin=0, vmax=1)\n    axes[row, 2].set_title(f'Pred pixels: {int(pred_mask.sum())}', fontsize=8)\n\n    # Col 3: Overlay\n    ov = np.stack([img_norm]*3, axis=-1)\n    ov[pred_mask > 0.5] = [1.0, 0.2, 0.2]    # red = predicted\n    missed = (gt_mask > 0.5) & ~(pred_mask > 0.5)\n    ov[missed] = [0.15, 1.0, 0.15]            # green = missed\n    axes[row, 3].imshow(ov)\n\n    # Badge\n    badge = '✓ CORRECT' if correct else '✗ WRONG'\n    axes[row, 0].text(0.98, 0.02, badge,\n                      transform=axes[row, 0].transAxes,\n                      ha='right', va='bottom', fontsize=9, fontweight='bold',\n                      color=color,\n                      bbox=dict(boxstyle='round', facecolor='white', alpha=0.8))\n\n    for ax in axes[row]: ax.axis('off')\n\nred_p   = mpatches.Patch(color=[1,0.2,0.2], label='Predicted Tumour')\ngreen_p = mpatches.Patch(color=[0.15,1,0.15], label='Missed GT Region')\nfig.legend(handles=[red_p, green_p], loc='lower center', ncol=2, fontsize=11)\n\nplt.suptitle('Pictorial Results — YOLOv11n-seg | One Sample Per MRI Class',\n             fontsize=14, fontweight='bold', y=1.01)\nplt.tight_layout()\nplt.savefig('pictorial_results_yolo.png', dpi=150, bbox_inches='tight')\nplt.show()\nprint('Saved pictorial_results_yolo.png')","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 17. YOLO Built-in Validation\n\nRun the official Ultralytics `val()` to get YOLO's own mAP metrics  \n(box mAP50, mask mAP50, mAP50-95) on the test split.","metadata":{}},{"cell_type":"code","source":"val_results = model_best.val(\n    data   = yaml_path,\n    split  = 'test',\n    imgsz  = IMG_SIZE,\n    batch  = BATCH_SIZE,\n    device = 0 if device == 'cuda' else 'cpu',\n    verbose= True,\n)\n\nprint('\\n── YOLO Official Val Metrics ──')\nprint(f'Box  mAP@50    : {val_results.box.map50:.4f}')\nprint(f'Box  mAP@50-95 : {val_results.box.map:.4f}')\nprint(f'Mask mAP@50    : {val_results.seg.map50:.4f}')\nprint(f'Mask mAP@50-95 : {val_results.seg.map:.4f}')","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 18. Single Image Inference Function\n\nConvenience wrapper to run the full pipeline on any `.mat` file or NumPy array.","metadata":{}},{"cell_type":"code","source":"def predict_image_yolo(source, verbose=True):\n    \"\"\"\n    Full gated YOLOv11n-seg inference on a single image.\n\n    Args:\n        source : str path to .mat file OR numpy array (H, W) float/uint8\n        verbose: print + show results\n\n    Returns dict with keys:\n        label, label_name, confidence, seg_mask, is_mri\n    \"\"\"\n    if isinstance(source, str) and source.endswith('.mat'):\n        img_bgr, gt_mask, true_lbl = mat_to_bgr(source)\n    else:\n        arr = np.array(source, dtype=np.float32)\n        arr = (arr - arr.min()) / (arr.max() - arr.min() + 1e-8)\n        img_u8  = (arr * 255).astype(np.uint8)\n        img_bgr = cv2.cvtColor(img_u8, cv2.COLOR_GRAY2BGR) if img_u8.ndim == 2 else img_u8\n        gt_mask = None; true_lbl = None\n\n    pred_cls, max_conf, seg_mask, raw_r = predict_single(model_best, img_bgr)\n\n    # Gate: NonMRI if no detection and confidence is zero\n    is_mri = not (max_conf < GATE_CONF_THRESH and pred_cls == 0)\n    final_cls = pred_cls if is_mri else NON_MRI_LABEL\n\n    result = {\n        'label'     : final_cls,\n        'label_name': ALL_CLASS_NAMES[final_cls],\n        'confidence': max_conf,\n        'seg_mask'  : seg_mask,\n        'is_mri'    : is_mri,\n    }\n\n    if verbose:\n        print(f'  Is MRI    : {is_mri}')\n        print(f'  Prediction: {ALL_CLASS_NAMES[final_cls]}  (conf={max_conf:.3f})')\n        if true_lbl is not None:\n            correct = (final_cls == true_lbl)\n            print(f'  True label: {ALL_CLASS_NAMES[true_lbl]}')\n            print(f'  Correct   : {\"✓\" if correct else \"✗\"}')\n\n        # Quick plot\n        img_gray = cv2.cvtColor(img_bgr, cv2.COLOR_BGR2GRAY) / 255.0\n        n_panels = 3 if seg_mask is None else 4\n        fig, axes = plt.subplots(1, n_panels, figsize=(5*n_panels, 4))\n        axes[0].imshow(img_gray, cmap='gray')\n        axes[0].set_title(f'Input\\nConf={max_conf:.3f}', fontweight='bold')\n        if gt_mask is not None:\n            axes[1].imshow(gt_mask, cmap='hot'); axes[1].set_title('GT Mask')\n        else:\n            axes[1].axis('off')\n        if seg_mask is not None:\n            seg_r = cv2.resize(seg_mask.astype(np.float32), (IMG_SIZE, IMG_SIZE))\n            axes[2].imshow(seg_r, cmap='hot'); axes[2].set_title('Pred Mask')\n            ov = np.stack([img_gray]*3, -1)\n            ov[seg_r > 0.5] = [1.0, 0.2, 0.2]\n            axes[3].imshow(ov)\n            axes[3].set_title(f'Overlay\\n{ALL_CLASS_NAMES[final_cls]}')\n        for ax in axes: ax.axis('off')\n        plt.tight_layout(); plt.show()\n\n    return result\n\n\n# ── Demo on first test file ──\nif test_mri_files:\n    print(f'Demo: {test_mri_files[0]}')\n    r = predict_image_yolo(test_mri_files[0], verbose=True)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 19. Comprehensive Metrics Summary","metadata":{}},{"cell_type":"code","source":"print('='*70)\nprint('  FINAL SUMMARY — YOLOv11n-seg on BriscMat Test Set')\nprint('='*70)\n\nrows = [\n    ('MODEL', '', ''),\n    ('  Architecture',   'YOLOv11n-seg (pretrained)',     'Fine-tuned from COCO weights'),\n    ('  Parameters',     '~1.9M',                        'Nano variant, fastest/lightest'),\n    ('GATE (MRI vs NonMRI)', '', ''),\n    ('  Accuracy',       f'{gate_acc:.4f}',               ''),\n    ('  F1',             f'{gate_f1:.4f}',                ''),\n    ('5-CLASS OVERALL', '', ''),\n    ('  Accuracy',       f'{oa5:.4f}',                    ''),\n    ('  F1 Macro',       f'{of5:.4f}',                    ''),\n    ('4-CLASS MRI CLASSIFICATION', '', ''),\n    ('  Accuracy',       f'{acc_4:.4f}',                  ''),\n    ('  F1 Macro',       f'{f1_4:.4f}',                   ''),\n    ('  Precision',      f'{prec_4:.4f}',                 ''),\n    ('  Recall',         f'{rec_4:.4f}',                  ''),\n    ('  Cohen Kappa',    f'{kappa:.4f}',                  '>0.6 = substantial agreement'),\n    ('  MCC',            f'{mcc:.4f}',                    'Balanced metric'),\n    ('SEGMENTATION (MRI)', '', ''),\n    ('  Dice (mean)',    f\"{seg_df['dice'].mean():.4f}\",   ''),\n    ('  IoU (mean)',     f\"{seg_df['iou'].mean():.4f}\",    ''),\n    ('  Sensitivity',   f\"{seg_df['sensitivity'].mean():.4f}\", ''),\n    ('  Specificity',   f\"{seg_df['specificity'].mean():.4f}\", ''),\n    ('  Precision',     f\"{seg_df['precision'].mean():.4f}\",   ''),\n]\n\nfor metric, value, note in rows:\n    if value == '':\n        print(f'\\n  ── {metric} ──')\n    else:\n        note_str = f'   # {note}' if note else ''\n        print(f'  {metric:<30} {value:<12}{note_str}')\n\nprint('\\n' + '='*70)","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Paste each \"# %%\" block as a new cell at the END of your YOLO notebook.\n# Needs from the notebook: model_best, predict_single, mat_to_bgr, device,\n# train_files/train_labels, val_files/val_labels, test_mri_files/test_mri_labels,\n# MRI_CLASS_NAMES, IMG_SIZE.\n\n# %% 1. Install (run once, in its own cell)\n# !pip install timm -q\n\n# %% 2. Imports and settings\nimport numpy as np, cv2, torch, torch.nn as nn, timm, pandas as pd\nimport torchvision.transforms as T\nfrom torch.utils.data import Dataset, DataLoader\nfrom sklearn.metrics import (accuracy_score, f1_score, recall_score,\n                             roc_auc_score, classification_report,\n                             confusion_matrix)\nfrom tqdm import tqdm\n\nCROP      = 224\nPAD       = 0.15\nSEEDS     = [42, 43, 44]\nEP_HEAD   = 3\nEP_FT     = 12\nBATCH     = 32\nBACKBONE  = 'convnextv2_tiny'\nNUM_CLS   = 4             # 0 No Tumor, 1 Meningioma, 2 Glioma, 3 Pituitary\nMEAN, STD = [0.485, 0.456, 0.406], [0.229, 0.224, 0.225]\n\n# %% 3. Crop stage\ndef bbox_from_mask(mask, pad=PAD, min_size=48):\n    ys, xs = np.where(mask > 0.5)\n    if len(ys) == 0:\n        return None\n    H, W = mask.shape\n    y0, y1, x0, x1 = ys.min(), ys.max() + 1, xs.min(), xs.max() + 1\n    py, px = int((y1 - y0) * pad), int((x1 - x0) * pad)\n    y0, y1, x0, x1 = max(0, y0 - py), min(H, y1 + py), max(0, x0 - px), min(W, x1 + px)\n    if (y1 - y0) < min_size or (x1 - x0) < min_size:\n        cy, cx = (y0 + y1) // 2, (x0 + x1) // 2\n        h = min_size // 2\n        y0, y1, x0, x1 = max(0, cy - h), min(H, cy + h), max(0, cx - h), min(W, cx + h)\n    return y0, y1, x0, x1\n\ndef make_crop(img_bgr, box_mask):\n    box = bbox_from_mask(box_mask) if box_mask is not None else None\n    if box is not None:\n        y0, y1, x0, x1 = box\n        img_bgr = img_bgr[y0:y1, x0:x1]\n    return cv2.resize(img_bgr, (CROP, CROP), interpolation=cv2.INTER_LINEAR)\n\ndef build_items(files, labels, use_pred):\n    \"\"\"use_pred=False: crop from GT mask (training / oracle test).\n       use_pred=True : crop from YOLO prediction (real pipeline).\"\"\"\n    items = []\n    for f, l in tqdm(list(zip(files, labels)), desc=f'crops pred={use_pred}'):\n        try:\n            img_bgr, gt, _ = mat_to_bgr(f)\n        except Exception:\n            continue\n        if use_pred:\n            _, _, pm, _ = predict_single(model_best, img_bgr)\n            box_mask = None if pm is None else (\n                cv2.resize(pm.astype(np.float32), (IMG_SIZE, IMG_SIZE),\n                           interpolation=cv2.INTER_NEAREST) > 0.5)\n        else:\n            box_mask = gt if l > 0 else None\n        items.append((make_crop(img_bgr, box_mask), int(l)))\n    return items\n\ntrain_items     = build_items(train_files, train_labels, use_pred=False)\nval_items       = build_items(val_files,   val_labels,   use_pred=False)\ntest_items_gt   = build_items(test_mri_files, test_mri_labels, use_pred=False)\ntest_items_pred = build_items(test_mri_files, test_mri_labels, use_pred=True)\n\n# %% 4. Dataset and loaders\ntf_train = T.Compose([T.ToPILImage(), T.RandomHorizontalFlip(),\n                      T.RandomRotation(10), T.ColorJitter(0.2, 0.2),\n                      T.ToTensor(), T.Normalize(MEAN, STD)])\ntf_eval  = T.Compose([T.ToTensor(), T.Normalize(MEAN, STD)])\n\nclass CropDS(Dataset):\n    def __init__(self, items, train):\n        self.items, self.tf = items, (tf_train if train else tf_eval)\n    def __len__(self): return len(self.items)\n    def __getitem__(self, i):\n        crop, lbl = self.items[i]\n        return self.tf(crop), lbl\n\ndef loader(items, train):\n    return DataLoader(CropDS(items, train), batch_size=BATCH, shuffle=train,\n                      num_workers=2, pin_memory=True)\n\n# %% 5. Model, training and evaluation\ndef build_model():\n    return timm.create_model(BACKBONE, pretrained=True, num_classes=NUM_CLS).to(device)\n\n@torch.no_grad()\ndef predict(model, items):\n    model.eval()\n    ys, ps, pr = [], [], []\n    for x, y in loader(items, False):\n        p = torch.softmax(model(x.to(device)), 1).cpu().numpy()\n        ys += y.tolist(); ps += p.argmax(1).tolist(); pr.append(p)\n    return np.array(ys), np.array(ps), np.concatenate(pr)\n\ndef val_f1(model, items):\n    y, p, _ = predict(model, items)\n    return f1_score(y, p, average='macro', zero_division=0)\n\ndef train_one(seed):\n    torch.manual_seed(seed); np.random.seed(seed)\n    model = build_model()\n    counts = np.bincount([l for _, l in train_items], minlength=NUM_CLS)\n    w = torch.tensor(counts.sum() / (NUM_CLS * counts), dtype=torch.float32, device=device)\n    crit = nn.CrossEntropyLoss(weight=w, label_smoothing=0.1)\n    scaler = torch.cuda.amp.GradScaler(enabled=(device == 'cuda'))\n    best, best_state = -1, None\n    tl = loader(train_items, True)\n\n    for phase, epochs, lr in [('head', EP_HEAD, 1e-3), ('full', EP_FT, 1e-4)]:\n        for n, p in model.named_parameters():\n            p.requires_grad = True if phase == 'full' else n.startswith('head')\n        opt = torch.optim.AdamW([p for p in model.parameters() if p.requires_grad],\n                                lr=lr, weight_decay=0.05)\n        sched = torch.optim.lr_scheduler.CosineAnnealingLR(opt, T_max=epochs)\n        for ep in range(epochs):\n            model.train()\n            for x, y in tl:\n                x, y = x.to(device), y.to(device)\n                opt.zero_grad()\n                with torch.autocast(device_type='cuda', enabled=(device == 'cuda')):\n                    loss = crit(model(x), y)\n                scaler.scale(loss).backward(); scaler.step(opt); scaler.update()\n            sched.step()\n            f1 = val_f1(model, val_items)\n            if f1 > best:\n                best = f1\n                best_state = {k: v.detach().clone() for k, v in model.state_dict().items()}\n            print(f'seed {seed} | {phase} ep {ep+1:02d} | val macro-F1 {f1:.4f} (best {best:.4f})')\n    model.load_state_dict(best_state)\n    return model\n\ndef evaluate(model, items, name):\n    y, p, pr = predict(model, items)\n    r = dict(setting=name,\n             acc=accuracy_score(y, p),\n             f1=f1_score(y, p, average='macro', zero_division=0),\n             recall=recall_score(y, p, average='macro', zero_division=0),\n             auc=roc_auc_score(y, pr, multi_class='ovr'))\n    return r, (y, p)\n\nmodels, rows = [], []\nfor s in SEEDS:\n    m = train_one(s)\n    models.append(m)\n    for items, name in [(test_items_gt, 'GT-mask crop (oracle)'),\n                        (test_items_pred, 'YOLO-mask crop (pipeline)')]:\n        r, _ = evaluate(m, items, name); r['seed'] = s; rows.append(r)\n\nres = pd.DataFrame(rows)\nprint(res.groupby('setting')[['acc', 'f1', 'recall', 'auc']].agg(['mean', 'std']).round(4))\n\n# %% 6. Per-class report and confusion matrix (first seed, real pipeline)\ny, p = evaluate(models[0], test_items_pred, 'pipeline')[1]\nprint(classification_report(y, p, target_names=MRI_CLASS_NAMES, zero_division=0))\nprint(confusion_matrix(y, p, labels=list(range(NUM_CLS))))\ntorch.save(models[0].state_dict(), 'convnextv2_tiny_best.pt')","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Paste as two new cells AFTER the classification cells (blocks 1-6) have run.\n# Reuses: build_items outputs (train_items, val_items, test_items_gt,\n# test_items_pred), loader, predict, val_f1, evaluate, SEEDS, EP_HEAD, EP_FT,\n# NUM_CLS, device, timm, torch, nn, np, pd.\n\n# %% 8. Patched train_one (freezes the right head for ANY backbone)\nimport time, gc\n\ndef train_one(seed):\n    torch.manual_seed(seed); np.random.seed(seed)\n    model = build_model()                      # reads the global BACKBONE\n    head_ids = {id(p) for p in model.get_classifier().parameters()}\n    counts = np.bincount([l for _, l in train_items], minlength=NUM_CLS)\n    w = torch.tensor(counts.sum() / (NUM_CLS * counts), dtype=torch.float32, device=device)\n    crit = nn.CrossEntropyLoss(weight=w, label_smoothing=0.1)\n    scaler = torch.cuda.amp.GradScaler(enabled=(device == 'cuda'))\n    best, best_state = -1, None\n    tl = loader(train_items, True)\n\n    for phase, epochs, lr in [('head', EP_HEAD, 1e-3), ('full', EP_FT, 1e-4)]:\n        for p in model.parameters():\n            p.requires_grad = (phase == 'full')\n        for p in model.get_classifier().parameters():\n            p.requires_grad = True\n        opt = torch.optim.AdamW([p for p in model.parameters() if p.requires_grad],\n                                lr=lr, weight_decay=0.05)\n        sched = torch.optim.lr_scheduler.CosineAnnealingLR(opt, T_max=epochs)\n        for ep in range(epochs):\n            model.train()\n            for x, y in tl:\n                x, y = x.to(device), y.to(device)\n                opt.zero_grad()\n                with torch.autocast(device_type='cuda', enabled=(device == 'cuda')):\n                    loss = crit(model(x), y)\n                scaler.scale(loss).backward(); scaler.step(opt); scaler.update()\n            sched.step()\n            f1 = val_f1(model, val_items)\n            if f1 > best:\n                best = f1\n                best_state = {k: v.detach().clone() for k, v in model.state_dict().items()}\n            print(f'{BACKBONE} | seed {seed} | {phase} ep {ep+1:02d} | '\n                  f'val macro-F1 {f1:.4f} (best {best:.4f})')\n    model.load_state_dict(best_state)\n    return model\n\n# %% 9. Run the comparison\nBACKBONES = {\n    'ConvNeXt-V2 Tiny'   : 'convnextv2_tiny',\n    'Swin-T'             : 'swin_tiny_patch4_window7_224',\n    'EfficientNetV2-S'   : 'tf_efficientnetv2_s',\n    'ResNet50'           : 'resnet50',\n}\nCMP_SEEDS = [42]            # 1 seed to save time; use SEEDS for all three\n\ncmp_rows = []\nfor label, timm_name in BACKBONES.items():\n    BACKBONE = timm_name                     # build_model reads this global\n    for s in CMP_SEEDS:\n        t0 = time.time()\n        m = train_one(s)\n        n_params = sum(p.numel() for p in m.parameters()) / 1e6\n        for items, setting in [(test_items_gt,   'GT-mask crop (oracle)'),\n                               (test_items_pred, 'YOLO-mask crop (pipeline)')]:\n            r, _ = evaluate(m, items, setting)\n            r.update(model=label, seed=s, params_M=round(n_params, 1),\n                     minutes=round((time.time() - t0) / 60, 1))\n            cmp_rows.append(r)\n        torch.save(m.state_dict(), f'best_{timm_name}_seed{s}.pt')\n        del m; gc.collect(); torch.cuda.empty_cache()\n\ncmp = pd.DataFrame(cmp_rows)\ntable = (cmp.groupby(['model', 'setting'])[['acc', 'f1', 'recall', 'auc', 'params_M', 'minutes']]\n            .mean().round(4))\nprint(table)\ntable.to_csv('classifier_comparison.csv')","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Paste each \"# %%\" block as a new cell AFTER classifier_comparison.py has run.\n# It reloads the checkpoints saved there (best_<model>_seed42.pt), so no retraining.\n# Reuses: BACKBONES, NUM_CLS, MRI_CLASS_NAMES, device, predict, test_items_gt,\n# test_items_pred, timm, torch, np, pd.\n\n# %% 10. Load checkpoints and collect test predictions\nimport matplotlib.pyplot as plt, seaborn as sns, gc\nfrom sklearn.metrics import (accuracy_score, f1_score, recall_score, precision_score,\n                             roc_auc_score, confusion_matrix, roc_curve, auc)\nfrom sklearn.preprocessing import label_binarize\n\nSETTINGS = ['GT-mask crop (oracle)', 'YOLO-mask crop (pipeline)']\nITEMS    = {SETTINGS[0]: test_items_gt, SETTINGS[1]: test_items_pred}\npreds = {}                                    # (model label, setting) -> (y, p, probs)\n\nfor label, timm_name in BACKBONES.items():\n    m = timm.create_model(timm_name, pretrained=False, num_classes=NUM_CLS).to(device)\n    m.load_state_dict(torch.load(f'best_{timm_name}_seed42.pt', map_location=device))\n    for setting in SETTINGS:\n        preds[(label, setting)] = predict(m, ITEMS[setting])\n    del m; gc.collect(); torch.cuda.empty_cache()\nprint('Collected predictions for', len(preds), 'model/setting pairs')\n\n# %% 11. Confusion matrices (rows = true class, colour = row-normalised, text = counts)\nmodels_ = list(BACKBONES.keys())\nfig, axes = plt.subplots(len(SETTINGS), len(models_),\n                         figsize=(4.6 * len(models_), 4.4 * len(SETTINGS)))\nfor i, setting in enumerate(SETTINGS):\n    for j, name in enumerate(models_):\n        y, p, _ = preds[(name, setting)]\n        cm = confusion_matrix(y, p, labels=list(range(NUM_CLS)))\n        cm_norm = cm / cm.sum(axis=1, keepdims=True).clip(min=1)\n        sns.heatmap(cm_norm, annot=cm, fmt='d', cmap='Blues', vmin=0, vmax=1,\n                    cbar=False, ax=axes[i, j],\n                    xticklabels=MRI_CLASS_NAMES, yticklabels=MRI_CLASS_NAMES)\n        acc = accuracy_score(y, p)\n        axes[i, j].set_title(f'{name}\\n{setting}\\nacc {acc:.3f}', fontsize=10, fontweight='bold')\n        axes[i, j].set_xlabel('Predicted'); axes[i, j].set_ylabel('True')\n        axes[i, j].tick_params(axis='x', rotation=30)\nplt.tight_layout(); plt.savefig('confusion_matrices.png', dpi=150, bbox_inches='tight'); plt.show()\n\n# %% 12. Overall metrics table and bar chart\ndef metric_row(y, p, pr):\n    return dict(accuracy=accuracy_score(y, p),\n                precision=precision_score(y, p, average='macro', zero_division=0),\n                recall=recall_score(y, p, average='macro', zero_division=0),\n                f1=f1_score(y, p, average='macro', zero_division=0),\n                auc=roc_auc_score(y, pr, multi_class='ovr'))\n\nrows_ = []\nfor (name, setting), (y, p, pr) in preds.items():\n    r = metric_row(y, p, pr); r.update(model=name, setting=setting); rows_.append(r)\nmt = pd.DataFrame(rows_).set_index(['model', 'setting']).round(4)\nprint(mt)\nmt.to_csv('all_model_metrics.csv')\n\npipe = mt.xs(SETTINGS[1], level='setting')\nlo = max(0.0, np.floor((pipe.values.min() - 0.02) * 20) / 20)    # truncated y-axis\nax = pipe.plot(kind='bar', figsize=(10, 4.5), rot=0, width=0.8, edgecolor='white')\nax.set_ylim(lo, 1.0); ax.set_ylabel('Score')\nax.set_title(f'Test metrics, YOLO-mask crops (y-axis starts at {lo:.2f})', fontweight='bold')\nax.grid(axis='y', alpha=0.3); ax.legend(ncol=5, loc='lower center', fontsize=9)\nplt.tight_layout(); plt.savefig('metrics_comparison.png', dpi=150); plt.show()\n\n# %% 13. Per-class F1 and the cost of segmentation errors\npc = {}\nfor (name, setting), (y, p, _) in preds.items():\n    pc[(name, setting)] = f1_score(y, p, average=None, labels=list(range(NUM_CLS)),\n                                   zero_division=0)\npc = pd.DataFrame(pc, index=MRI_CLASS_NAMES).T.round(4)\npc.index.names = ['model', 'setting']\nprint(pc)\n\nfig, ax = plt.subplots(figsize=(7, 4))\nsns.heatmap(pc.xs(SETTINGS[1], level='setting'), annot=True, fmt='.3f',\n            cmap='YlGnBu', vmin=0.5, vmax=1, ax=ax)\nax.set_title('Per-class F1 (YOLO-mask crops)', fontweight='bold')\nplt.tight_layout(); plt.savefig('per_class_f1.png', dpi=150); plt.show()\n\ndrop = (mt['f1'].xs(SETTINGS[0], level='setting')\n        - mt['f1'].xs(SETTINGS[1], level='setting')).round(4)\nprint('\\nMacro-F1 lost when using YOLO masks instead of GT masks:\\n', drop)\n\n# %% 14. Micro-average ROC curves (YOLO-mask crops)\nfig, ax = plt.subplots(figsize=(6, 5))\nfor name in models_:\n    y, _, pr = preds[(name, SETTINGS[1])]\n    yb = label_binarize(y, classes=list(range(NUM_CLS)))\n    fpr, tpr, _ = roc_curve(yb.ravel(), pr.ravel())\n    ax.plot(fpr, tpr, lw=2, label=f'{name} (AUC {auc(fpr, tpr):.3f})')\nax.plot([0, 1], [0, 1], 'k--', lw=1)\nax.set_xlabel('False positive rate'); ax.set_ylabel('True positive rate')\nax.set_title('Micro-average ROC', fontweight='bold'); ax.legend(loc='lower right')\nax.grid(alpha=0.3); plt.tight_layout(); plt.savefig('roc_comparison.png', dpi=150); plt.show()\n\n# %% 15. Full image vs crops (only if you ran baseline_full_image_comparison.py)\nif 'res' in globals() and 'Full image (no segmentation)' in set(res['setting']):\n    order = ['Full image (no segmentation)', 'GT-mask crop (oracle)', 'YOLO-mask crop (pipeline)']\n    g = res.groupby('setting')[['acc', 'f1', 'recall', 'auc']].agg(['mean', 'std']).loc[order]\n    means = g.xs('mean', axis=1, level=1)\n    stds  = g.xs('std',  axis=1, level=1).fillna(0)\n    lo2 = max(0.0, np.floor((means.values.min() - 0.02) * 20) / 20)\n    ax = means.plot(kind='bar', yerr=stds, capsize=3, figsize=(9, 4.5), rot=10, width=0.8)\n    ax.set_ylim(lo2, 1.0); ax.grid(axis='y', alpha=0.3)\n    ax.set_title(f'ConvNeXt-V2 Tiny by input type, mean ± std (y-axis starts at {lo2:.2f})',\n                 fontweight='bold')\n    plt.tight_layout(); plt.savefig('input_comparison.png', dpi=150); plt.show()\nelse:\n    print('Skipped: run baseline_full_image_comparison.py first to compare input types.')","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Paste as ONE new cell AFTER the classification cells (blocks 1-6) have run.\n# It reuses train_one, evaluate, make_crop, mat_to_bgr, SEEDS and the `rows` list.\n\n# %% 7. Baseline: ConvNeXt-V2 on the FULL image (no segmentation)\ndef build_full(files, labels):\n    items = []\n    for f, l in tqdm(list(zip(files, labels)), desc='full images'):\n        try:\n            img_bgr, _, _ = mat_to_bgr(f)\n        except Exception:\n            continue\n        items.append((make_crop(img_bgr, None), int(l)))   # no box -> whole slice\n    return items\n\nfull_train = build_full(train_files, train_labels)\nfull_val   = build_full(val_files,   val_labels)\nfull_test  = build_full(test_mri_files, test_mri_labels)\n\ncrop_train, crop_val = train_items, val_items              # keep the crop data\n\ntrain_items, val_items = full_train, full_val              # train_one reads these globals\nfor s in SEEDS:\n    m = train_one(s)\n    r, _ = evaluate(m, full_test, 'Full image (no segmentation)')\n    r['seed'] = s\n    rows.append(r)\n\ntrain_items, val_items = crop_train, crop_val              # restore\n\nres = pd.DataFrame(rows)\norder = ['Full image (no segmentation)',\n         'GT-mask crop (oracle)',\n         'YOLO-mask crop (pipeline)']\nsummary = (res.groupby('setting')[['acc', 'f1', 'recall', 'auc']]\n              .agg(['mean', 'std']).round(4).loc[order])\nprint(summary)\nsummary.to_csv('input_comparison.csv')","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"BACKBONE = 'convnextv2_tiny'\nrows = [r for r in rows if r['setting'] != 'Full image (no segmentation)']\n\ndef build_full(files, labels):\n    items = []\n    for f, l in tqdm(list(zip(files, labels)), desc='full images'):\n        try:\n            img_bgr, _, _ = mat_to_bgr(f)\n        except Exception:\n            continue\n        items.append((make_crop(img_bgr, None), int(l)))\n    return items\n\nfull_train = build_full(train_files, train_labels)\nfull_val   = build_full(val_files,   val_labels)\nfull_test  = build_full(test_mri_files, test_mri_labels)\n\ncrop_train, crop_val = train_items, val_items\n\ntrain_items, val_items = full_train, full_val\nfor s in SEEDS:\n    m = train_one(s)\n    r, _ = evaluate(m, full_test, 'Full image (no segmentation)')\n    r['seed'] = s\n    rows.append(r)\n\ntrain_items, val_items = crop_train, crop_val\n\nres = pd.DataFrame(rows)\norder = ['Full image (no segmentation)',\n         'GT-mask crop (oracle)',\n         'YOLO-mask crop (pipeline)']\nsummary = (res.groupby('setting')[['acc', 'f1', 'recall', 'auc']]\n              .agg(['mean', 'std']).round(4).loc[order])\nprint(summary)\nsummary.to_csv('input_comparison.csv')","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Paste each \"# %%\" block as a new cell at the END of your notebook.\n# Needs from the notebook: train_files/train_labels, val_files/val_labels, mat_to_bgr,\n# make_crop, train_one, predict, predict_single, compute_seg_metrics, write_yolo_dataset,\n# full_test, test_items_gt, test_mri_files, test_mri_labels, NUM_CLS, CROP, IMG_SIZE,\n# BATCH_SIZE, RUNS_DIR, MRI_CLASS_NAMES, device, timm, torch, yaml, YOLO.\n#\n# Design: the 5,000 MRI images (train + val) are split into K folds. Each image is\n# predicted once by a model that never saw it (out-of-fold, OOF). The original test\n# set stays locked and is also scored by every fold model.\n# Every fold is saved to disk, so you can stop and resume after a session timeout.\n#\n# Rough time on a T4 (K=5): classifiers ~2 h (full image + GT crop),\n# YOLO per fold ~1.5 h extra (optional, block 6).\n\n# %% 1. Settings\nimport numpy as np, pandas as pd, cv2, gc, os, shutil, scipy.io\nfrom tqdm import tqdm\nfrom pathlib import Path\nfrom sklearn.model_selection import StratifiedGroupKFold, StratifiedKFold\nfrom sklearn.metrics import accuracy_score, f1_score, recall_score, roc_auc_score\nfrom scipy.stats import binomtest\n\nK          = 5\nCV_SEED    = 42\nINNER_VAL  = 10            # inner validation = 1/INNER_VAL of each training part (model selection)\nCV_DIR     = '/kaggle/working/cv'\nFOLDS_TO_RUN = list(range(K))      # e.g. [0, 1] to run only some folds now\nRUN_YOLO_FOLDS = False             # True = also train YOLO per fold (block 6)\nYOLO_EPOCHS    = 15\nos.makedirs(CV_DIR, exist_ok=True)\n\n# %% 2. Build the folds (patient-aware if patient IDs exist)\npool_files  = list(train_files) + list(val_files)\npool_labels = np.array(list(train_labels) + list(val_labels))\nN = len(pool_files)\n\nprint('Keys in one .mat file:', [k for k in scipy.io.loadmat(pool_files[0]).keys()\n                                 if not k.startswith('__')])\n\ndef get_pid(f):\n    try:\n        d = scipy.io.loadmat(f)\n    except Exception:\n        return None\n    for key in ('cjdata.PID', 'PID', 'pid', 'patient_id', 'PatientID'):\n        if key in d:\n            return str(np.array(d[key]).flat[0])\n    return None\n\npids = [get_pid(f) for f in tqdm(pool_files, desc='patient ids')]\nhave_pid = all(p is not None for p in pids)\ngroups = np.array(pids) if have_pid else None\n\nif have_pid:\n    print(f'Patient IDs found: {len(set(pids))} patients for {N} images -> group-aware folds.')\n    splitter = StratifiedGroupKFold(n_splits=K, shuffle=True, random_state=CV_SEED)\n    folds = list(splitter.split(np.zeros(N), pool_labels, groups))\n    for tr, te in folds:\n        assert not (set(groups[tr]) & set(groups[te])), 'patient appears in train and test'\nelse:\n    print('WARNING: no patient IDs found. Folds are image-level, so images from the same '\n          'patient can sit in both train and test. Report this as a limitation.')\n    splitter = StratifiedKFold(n_splits=K, shuffle=True, random_state=CV_SEED)\n    folds = list(splitter.split(np.zeros(N), pool_labels))\n\nfor k, (tr, te) in enumerate(folds):\n    print(f'fold {k}: train {len(tr)}, held-out {len(te)}, held-out per class',\n          np.bincount(pool_labels[te], minlength=NUM_CLS).tolist())\n\ndef inner_split(k):\n    \"\"\"Split fold k's training part into (train, validation). Validation only picks\n    the best epoch; the held-out fold is never used for that.\"\"\"\n    tr = np.asarray(folds[k][0])\n    if have_pid:\n        sp = StratifiedGroupKFold(INNER_VAL, shuffle=True, random_state=CV_SEED + k)\n        a, b = next(sp.split(tr, pool_labels[tr], groups[tr]))\n    else:\n        sp = StratifiedKFold(INNER_VAL, shuffle=True, random_state=CV_SEED + k)\n        a, b = next(sp.split(tr, pool_labels[tr]))\n    return tr[a], tr[b]\n\n# %% 3. Cache full-image and GT-crop inputs once\npool_full, pool_crop = [], []\nfor f, l in tqdm(list(zip(pool_files, pool_labels)), desc='building inputs'):\n    img_bgr, gt, _ = mat_to_bgr(f)\n    pool_full.append((make_crop(img_bgr, None), int(l)))\n    pool_crop.append((make_crop(img_bgr, gt if l > 0 else None), int(l)))\ny_test = np.array([l for _, l in full_test])\n\n# %% 4. Cross-validate the two classifiers (ConvNeXt-V2 Tiny)\ndef run_cv(name, pool_items, test_items):\n    global train_items, val_items, BACKBONE\n    BACKBONE = 'convnextv2_tiny'\n    saved = (train_items, val_items)\n    for k in FOLDS_TO_RUN:\n        path = f'{CV_DIR}/{name}_fold{k}.npz'\n        if os.path.exists(path):\n            print(f'{name} fold {k}: already done, skipping'); continue\n        inner_tr, inner_val = inner_split(k)\n        train_items = [pool_items[i] for i in inner_tr]\n        val_items   = [pool_items[i] for i in inner_val]\n        print(f'===== {name} | fold {k} | train {len(train_items)} val {len(val_items)} =====')\n        m = train_one(CV_SEED + k)\n        te = np.asarray(folds[k][1])\n        _, _, P_oof  = predict(m, [pool_items[i] for i in te])\n        _, _, P_test = predict(m, test_items)\n        torch.save(m.state_dict(), f'{CV_DIR}/{name}_fold{k}.pt')\n        np.savez(path, te=te, P_oof=P_oof, P_test=P_test)\n        del m; gc.collect(); torch.cuda.empty_cache()\n    train_items, val_items = saved\n\nrun_cv('full',   pool_full, full_test)        # whole image in, no segmentation\nrun_cv('oracle', pool_crop, test_items_gt)    # crop from ground-truth mask\n\n# %% 5. Results for the two classifiers (fold-wise mean +/- SD, pooled OOF)\ndef metrics_row(y, P):\n    p = P.argmax(1)\n    return dict(acc=accuracy_score(y, p),\n                f1=f1_score(y, p, average='macro', zero_division=0),\n                recall=recall_score(y, p, average='macro', zero_division=0),\n                auc=roc_auc_score(y, P, multi_class='ovr'))\n\ndef summarize(rows, title):\n    df = pd.DataFrame(rows)\n    out = df.groupby('system')[['acc', 'f1', 'recall', 'auc']].agg(['mean', 'std']).round(4)\n    print(f'\\n{title}\\n', out.to_string())\n    return df, out\n\nrows_oof, rows_test = [], []\nfor name, label in [('full', 'Full image'), ('oracle', 'GT crop (oracle)')]:\n    for k in FOLDS_TO_RUN:\n        d = np.load(f'{CV_DIR}/{name}_fold{k}.npz')\n        rows_oof.append(dict(system=label, fold=k, **metrics_row(pool_labels[d['te']], d['P_oof'])))\n        rows_test.append(dict(system=label, fold=k, **metrics_row(y_test, d['P_test'])))\n\ndf_oof,  tab_oof  = summarize(rows_oof,  f'{K}-fold, held-out folds (each image predicted by a model that never saw it)')\ndf_test, tab_test = summarize(rows_test, 'Locked test set, one score per fold model')\ntab_oof.to_csv('cv_classifiers_oof.csv'); tab_test.to_csv('cv_classifiers_test.csv')\n\n# %% 6. OPTIONAL: YOLO per fold -> real pipeline (crop, routed) with segmentation metrics\n# Set RUN_YOLO_FOLDS = True in block 1 and re-run block 1 first. Each fold trains YOLO\n# on that fold's training images only, so held-out masks are honest.\ndef crops_from_yolo(files, labels, ymodel):\n    items, has, ycls, dice = [], [], [], []\n    for f, l in zip(files, labels):\n        img_bgr, gt, _ = mat_to_bgr(f)\n        pc, _, pm, _ = predict_single(ymodel, img_bgr)\n        if pm is None:\n            box, seg = None, np.zeros((IMG_SIZE, IMG_SIZE), np.float32)\n        else:\n            seg = cv2.resize(pm.astype(np.float32), (IMG_SIZE, IMG_SIZE),\n                             interpolation=cv2.INTER_NEAREST)\n            box = seg > 0.5\n        items.append((make_crop(img_bgr, box), int(l)))\n        has.append(pm is not None); ycls.append(pc)\n        dice.append(compute_seg_metrics(seg, gt)['dice'] if l > 0 else np.nan)\n    return items, np.array(has), np.array(ycls), np.array(dice)\n\ndef load_cls(path):\n    mdl = timm.create_model('convnextv2_tiny', pretrained=False, num_classes=NUM_CLS).to(device)\n    mdl.load_state_dict(torch.load(path, map_location=device))\n    return mdl.eval()\n\nif RUN_YOLO_FOLDS:\n    for k in FOLDS_TO_RUN:\n        path = f'{CV_DIR}/yolo_fold{k}.npz'\n        if os.path.exists(path):\n            print(f'yolo fold {k}: already done, skipping'); continue\n        inner_tr, inner_val = inner_split(k)\n        root = f'/kaggle/working/yolo_cv_fold{k}'\n        write_yolo_dataset([pool_files[i] for i in inner_tr],  pool_labels[inner_tr].tolist(),  'train', root)\n        write_yolo_dataset([pool_files[i] for i in inner_val], pool_labels[inner_val].tolist(), 'val',   root)\n        with open(f'{root}/dataset.yaml', 'w') as fh:\n            yaml.dump(dict(path=root, train='images/train', val='images/val', nc=3,\n                           names=['Meningioma', 'Glioma', 'Pituitary']), fh)\n        res = YOLO('yolo11n-seg.pt').train(\n            data=f'{root}/dataset.yaml', epochs=YOLO_EPOCHS, imgsz=IMG_SIZE, batch=BATCH_SIZE,\n            device=0 if device == 'cuda' else 'cpu', project=RUNS_DIR, name=f'cv_fold{k}',\n            exist_ok=True, optimizer='AdamW', lr0=0.001, lrf=0.01, warmup_epochs=5,\n            weight_decay=0.0005, flipud=0.5, fliplr=0.5, mosaic=1.0, mixup=0.1,\n            copy_paste=0.1, degrees=15, translate=0.1, scale=0.5, overlap_mask=False,\n            patience=20, plots=False, verbose=False, seed=CV_SEED + k)\n        ymodel = YOLO(f'{res.save_dir}/weights/best.pt')\n        shutil.rmtree(root, ignore_errors=True)\n\n        te = np.asarray(folds[k][1])\n        items_oof, has_oof, ycls_oof, dice_oof = crops_from_yolo(\n            [pool_files[i] for i in te], pool_labels[te], ymodel)\n        items_te, has_te, ycls_te, dice_te = crops_from_yolo(\n            test_mri_files, test_mri_labels, ymodel)\n\n        cls_model = load_cls(f'{CV_DIR}/oracle_fold{k}.pt')     # trained on GT crops\n        _, _, P_pipe_oof  = predict(cls_model, items_oof)\n        _, _, P_pipe_test = predict(cls_model, items_te)\n        np.savez(path, te=te, has_oof=has_oof, has_test=has_te, ycls_oof=ycls_oof,\n                 ycls_test=ycls_te, dice_oof=dice_oof, dice_test=dice_te,\n                 P_pipe_oof=P_pipe_oof, P_pipe_test=P_pipe_test)\n        del ymodel, cls_model; gc.collect(); torch.cuda.empty_cache()\n\n# %% 7. All systems side by side (needs block 6 for the pipeline rows)\ndef fold_systems(k, split):\n    key = 'P_oof' if split == 'oof' else 'P_test'\n    out = {'Full image': np.load(f'{CV_DIR}/full_fold{k}.npz')[key],\n           'GT crop (oracle)': np.load(f'{CV_DIR}/oracle_fold{k}.npz')[key]}\n    yp = f'{CV_DIR}/yolo_fold{k}.npz'\n    if os.path.exists(yp):\n        d = np.load(yp); H = d['has_' + ('oof' if split == 'oof' else 'test')][:, None]\n        Pp = d['P_pipe_' + ('oof' if split == 'oof' else 'test')]\n        Pf = out['Full image']\n        out['YOLO crop (pipeline)'] = Pp\n        out['Routed (no mask -> full)'] = np.where(H, Pp, Pf)\n        out['Routed + average'] = np.where(H, (Pp + Pf) / 2, Pf)\n    return out\n\n# pooled out-of-fold predictions: one prediction per image, N images\npooled = {}\nfor k in FOLDS_TO_RUN:\n    te = np.load(f'{CV_DIR}/full_fold{k}.npz')['te']\n    for name, P in fold_systems(k, 'oof').items():\n        pooled.setdefault(name, np.zeros((N, NUM_CLS)))[te] = P\ncovered = np.zeros(N, bool)\nfor k in FOLDS_TO_RUN:\n    covered[np.load(f'{CV_DIR}/full_fold{k}.npz')['te']] = True\ny_cov = pool_labels[covered]\n\nprint(f'\\nPooled out-of-fold results ({covered.sum()} images)')\npool_tab = pd.DataFrame({n: metrics_row(y_cov, P[covered]) for n, P in pooled.items()}).T.round(4)\nprint(pool_tab.to_string()); pool_tab.to_csv('cv_pooled_oof.csv')\n\ndef mcnemar(y, pa, pb):\n    a_ok, b_ok = pa == y, pb == y\n    oa, ob = int((a_ok & ~b_ok).sum()), int((~a_ok & b_ok).sum())\n    return oa, ob, (binomtest(oa, oa + ob, 0.5).pvalue if oa + ob else 1.0)\n\ndef boot_f1_diff(y, pa, pb, n=1000, seed=0):\n    rng = np.random.RandomState(seed); d = []\n    for _ in range(n):\n        i = rng.randint(0, len(y), len(y))\n        d.append(f1_score(y[i], pb[i], average='macro', zero_division=0)\n                 - f1_score(y[i], pa[i], average='macro', zero_division=0))\n    return np.percentile(d, [2.5, 97.5])\n\nbase = pooled['Full image'][covered].argmax(1)\nprint('\\nEach system vs the full-image classifier (pooled OOF)')\nfor name, P in pooled.items():\n    if name == 'Full image': continue\n    p = P[covered].argmax(1)\n    oa, ob, pv = mcnemar(y_cov, base, p)\n    lo, hi = boot_f1_diff(y_cov, base, p)\n    print(f'{name:28s} full-only-right {oa:4d}  system-only-right {ob:4d}  '\n          f'McNemar p={pv:.4f}  macro-F1 change CI [{lo:+.3f}, {hi:+.3f}]')\n\n# fold-wise mean +/- SD for every available system, on held-out folds and locked test\nfor split, label in [('oof', 'held-out folds'), ('test', 'locked test set')]:\n    rows = []\n    for k in FOLDS_TO_RUN:\n        y = pool_labels[np.load(f'{CV_DIR}/full_fold{k}.npz')['te']] if split == 'oof' else y_test\n        for name, P in fold_systems(k, split).items():\n            rows.append(dict(system=name, fold=k, **metrics_row(y, P)))\n    summarize(rows, f'Fold-wise mean and SD on the {label}')\n\n# segmentation quality per fold (only if block 6 was run)\ndice_rows = []\nfor k in FOLDS_TO_RUN:\n    yp = f'{CV_DIR}/yolo_fold{k}.npz'\n    if os.path.exists(yp):\n        d = np.load(yp)\n        dice_rows.append(dict(fold=k, dice_tumour=np.nanmean(d['dice_oof']),\n                              mask_found=d['has_oof'].mean(),\n                              missed_tumours=int(((~d['has_oof']) & (pool_labels[d['te']] > 0)).sum())))\nif dice_rows:\n    dd = pd.DataFrame(dice_rows)\n    print('\\nYOLO per fold (held-out images)\\n', dd.round(4).to_string(index=False))\n    print(f\"Tumour Dice: {dd.dice_tumour.mean():.4f} +/- {dd.dice_tumour.std():.4f}\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Paste each \"# %%\" block as a new cell at the END of your notebook.\n# Needs from the notebook: models, full_test, test_items_pred, test_mri_files,\n# tf_eval, predict, mat_to_bgr, device, CROP, NUM_CLS, MRI_CLASS_NAMES, timm, torch.\n# No extra pip install: Grad-CAM is implemented here with plain PyTorch hooks.\n\n# %% 1. Imports\nimport numpy as np, cv2, torch, torch.nn.functional as F, pandas as pd, timm\nimport matplotlib.pyplot as plt\nfrom tqdm import tqdm\n\n# %% 2. Save the full-image model\n# IMPORTANT: run this right after the full-image baseline cell, BEFORE anything\n# reassigns `m`. After that cell, `m` is the seed-44 full-image ConvNeXt-V2.\ntorch.save(m.state_dict(), 'convnextv2_full_seed44.pt')\n\n# If `m` was already overwritten, retrain once instead (about 10 minutes):\n#   crop_train, crop_val = train_items, val_items\n#   train_items, val_items = full_train, full_val\n#   BACKBONE = 'convnextv2_tiny'\n#   m = train_one(44)\n#   train_items, val_items = crop_train, crop_val\n#   torch.save(m.state_dict(), 'convnextv2_full_seed44.pt')\n\n# %% 3. Load models and the Grad-CAM class\ndef load_model(timm_name, path):\n    mdl = timm.create_model(timm_name, pretrained=False, num_classes=NUM_CLS).to(device)\n    mdl.load_state_dict(torch.load(path, map_location=device))\n    return mdl.eval()\n\nfull_model = load_model('convnextv2_tiny', 'convnextv2_full_seed44.pt')\ncrop_model = models[0].eval()          # ConvNeXt-V2 trained on GT-mask crops\nBB = 'convnextv2_tiny'\n\ndef target_layer(model, timm_name):\n    \"\"\"Last feature stage of each backbone.\"\"\"\n    if 'convnext' in timm_name:     return model.stages[-1]      # B,C,H,W\n    if 'swin' in timm_name:         return model.layers[-1]      # B,H,W,C (auto-handled)\n    if 'resnet' in timm_name:       return model.layer4[-1]\n    if 'efficientnet' in timm_name: return model.conv_head\n    raise ValueError(f'No target layer defined for {timm_name}')\n\nclass GradCAM:\n    def __init__(self, model, layer):\n        self.model, self.act, self.grad = model.eval(), None, None\n        self.h = layer.register_forward_hook(self._fwd)\n\n    def _fwd(self, mod, inp, out):\n        self.act = out\n        if out.requires_grad:\n            out.register_hook(lambda g: setattr(self, 'grad', g))\n\n    def remove(self):\n        self.h.remove()\n\n    def __call__(self, x, target=None):\n        \"\"\"x: (B,3,H,W) normalised tensor. target=None explains the predicted class.\n        Returns cams (B,CROP,CROP) in [0,1], explained classes, softmax probs.\"\"\"\n        x = x.to(device).requires_grad_(True)\n        self.model.zero_grad(set_to_none=True)\n        logits = self.model(x)\n        probs = logits.softmax(1).detach().cpu().numpy()\n        cls = (logits.argmax(1) if target is None\n               else torch.full((len(x),), int(target), device=device))\n        logits.gather(1, cls[:, None]).sum().backward()\n        a, g = self.act.detach(), self.grad.detach()\n        nf = self.model.num_features\n        if a.shape[1] != nf and a.shape[-1] == nf:     # channels-last (Swin)\n            a, g = a.permute(0, 3, 1, 2), g.permute(0, 3, 1, 2)\n        w = g.mean((2, 3), keepdim=True)\n        cam = F.relu((w * a).sum(1, keepdim=True))\n        cam = F.interpolate(cam, size=(CROP, CROP), mode='bilinear', align_corners=False)[:, 0]\n        cam = cam / (cam.amax((1, 2), keepdim=True) + 1e-8)\n        return cam.cpu().numpy(), cls.cpu().numpy(), probs\n\n# %% 4. Ground-truth tumour masks for the test set (at classifier resolution)\ndef load_gt(files):\n    out = []\n    for f in tqdm(files, desc='GT masks'):\n        _, gt, _ = mat_to_bgr(f)\n        out.append(cv2.resize(gt, (CROP, CROP), interpolation=cv2.INTER_NEAREST) > 0.5)\n    return out\n\ntest_gts = load_gt(test_mri_files)\nassert len(test_gts) == len(full_test), 'file/item mismatch: a file was skipped'\ntest_labels = np.array([l for _, l in full_test])\n\n# %% 5. Quantitative attention score: how much Grad-CAM falls inside the tumour?\n# inside   = share of total Grad-CAM energy that lies inside the GT tumour mask\n# area     = share of the image covered by the tumour (the chance level)\n# enrich   = inside / area  (above 1 means attention is concentrated on the tumour)\n# pointing = does the single hottest pixel fall inside the tumour?\ndef cam_scores(cam, gt):\n    area = float(gt.mean())\n    inside = float(cam[gt].sum() / (cam.sum() + 1e-8))\n    pt = bool(gt[np.unravel_index(cam.argmax(), cam.shape)])\n    return inside, area, pt\n\ndef eval_cam(model, timm_name, items, gts, bs=32):\n    cg = GradCAM(model, target_layer(model, timm_name))\n    rows, preds = [], []\n    for s in tqdm(range(0, len(items), bs), desc='Grad-CAM'):\n        batch = items[s:s + bs]\n        x = torch.stack([tf_eval(c) for c, _ in batch])\n        cams, cls, _ = cg(x)\n        for j, (_, l) in enumerate(batch):\n            i = s + j\n            preds.append(int(cls[j]))\n            gt = gts[i]\n            if l > 0 and gt.any():\n                ins, area, pt = cam_scores(cams[j], gt)\n                rows.append(dict(idx=i, cls=int(l), correct=int(cls[j] == l),\n                                 inside=ins, area=area, enrich=ins / max(area, 1e-8),\n                                 pointing=int(pt)))\n    cg.remove()\n    return pd.DataFrame(rows), np.array(preds)\n\ndef summarize(df, name):\n    g = df.groupby('cls').agg(n=('idx', 'count'), inside=('inside', 'mean'),\n                              area=('area', 'mean'), enrich=('enrich', 'median'),\n                              pointing=('pointing', 'mean'))\n    g.index = [MRI_CLASS_NAMES[i] for i in g.index]\n    g.loc['All tumours'] = [len(df), df.inside.mean(), df.area.mean(),\n                            df.enrich.median(), df.pointing.mean()]\n    g.insert(0, 'model', name)\n    return g.round(3)\n\ndf_full, preds_full = eval_cam(full_model, BB, full_test, test_gts)\ntab_full = summarize(df_full, 'Full image')\nprint(tab_full)\n\n# Correct vs wrong predictions: does the model look elsewhere when it fails?\nprint(df_full.groupby('correct')[['inside', 'enrich', 'pointing']].mean().round(3))\n\n# %% 6. Same score for another model (e.g. the fusion model) - reuse for comparison\n# Example (once you have a new model and its test items):\n#   df_new, _ = eval_cam(new_model, 'convnextv2_tiny', new_test_items, test_gts)\n#   tab = pd.concat([tab_full, summarize(df_new, 'Fusion')])\n#   tab.to_csv('gradcam_attention_scores.csv')\ntab_full.to_csv('gradcam_attention_scores.csv')\n\n# %% 7. Visualisation helpers\ndef overlay(crop_bgr, cam, gt=None):\n    rgb = cv2.cvtColor(crop_bgr, cv2.COLOR_BGR2RGB)\n    heat = cv2.cvtColor(cv2.applyColorMap((cam * 255).astype(np.uint8), cv2.COLORMAP_JET),\n                        cv2.COLOR_BGR2RGB)\n    out = (0.55 * rgb + 0.45 * heat).astype(np.uint8)\n    if gt is not None and gt.any():\n        cnts, _ = cv2.findContours(gt.astype(np.uint8), cv2.RETR_EXTERNAL,\n                                   cv2.CHAIN_APPROX_SIMPLE)\n        cv2.drawContours(out, cnts, -1, (255, 255, 255), 1)    # white = GT tumour outline\n    return out\n\ndef show_cases(model, timm_name, items, idxs, gts=None, title='', fname=None, ncols=4):\n    cg = GradCAM(model, target_layer(model, timm_name))\n    x = torch.stack([tf_eval(items[i][0]) for i in idxs])\n    cams, cls, probs = cg(x)\n    cg.remove()\n    nrows = int(np.ceil(len(idxs) / ncols))\n    fig, axes = plt.subplots(nrows, ncols, figsize=(4 * ncols, 4.2 * nrows))\n    for ax in np.atleast_1d(axes).flat:\n        ax.axis('off')\n    for k, i in enumerate(idxs):\n        ax = np.atleast_1d(axes).flat[k]\n        gt = gts[i] if gts is not None else None\n        ax.imshow(overlay(items[i][0], cams[k], gt))\n        true, pred = MRI_CLASS_NAMES[items[i][1]], MRI_CLASS_NAMES[cls[k]]\n        ax.set_title(f'True: {true}\\nPred: {pred} ({probs[k][cls[k]]:.2f})', fontsize=10,\n                     color='#2E7D32' if true == pred else '#C62828')\n    plt.suptitle(title, fontsize=13, fontweight='bold')\n    plt.tight_layout()\n    if fname:\n        plt.savefig(fname, dpi=150, bbox_inches='tight')\n    plt.show()\n\n# %% 8. Pre-selected examples (fixed random seed, so the choice is not cherry-picked)\nrng = np.random.RandomState(0)\n\ndef pick(preds, labels, per=2):\n    sel = []\n    for c in range(NUM_CLS):\n        ok  = [i for i in range(len(labels)) if labels[i] == c and preds[i] == c]\n        bad = [i for i in range(len(labels)) if labels[i] == c and preds[i] != c]\n        for pool in (ok, bad):\n            if pool:\n                sel += rng.choice(pool, min(per, len(pool)), replace=False).tolist()\n    return sel\n\nsel = pick(preds_full, test_labels)\nshow_cases(full_model, BB, full_test, sel, gts=test_gts,\n           title='Grad-CAM, full-image ConvNeXt-V2 (white outline = GT tumour)',\n           fname='gradcam_full_image.png')\n\n# %% 9. Failure analysis: glioma predicted as No Tumor by the real pipeline\n# Uses the crop-trained model on the YOLO-mask inputs (what the pipeline sees).\n# No GT overlay here: when YOLO finds a mask the input is a crop, so the outline\n# would not line up with the image.\ny_pipe, p_pipe, _ = predict(crop_model, test_items_pred)\nfail = np.where((y_pipe == 2) & (p_pipe == 0))[0]\nprint(f'Glioma -> No Tumor failures: {len(fail)}')\nshow_cases(crop_model, BB, test_items_pred, fail[:8].tolist(),\n           title='Pipeline failures: glioma predicted as No Tumor',\n           fname='gradcam_glioma_failures.png')\n\n# %% 10. Shortcut check for the oracle model (No Tumor vs tumour crops)\n# If heatmaps for No Tumor images sit on borders or background instead of brain\n# tissue, the model may be using \"uncropped\" as the cue for No Tumor.\ny_gt, p_gt, _ = predict(crop_model, test_items_gt)\nnt = np.where(y_gt == 0)[0]\nshow_cases(crop_model, BB, test_items_gt, rng.choice(nt, 8, replace=False).tolist(),\n           title='Oracle crop model: No Tumor images',\n           fname='gradcam_notumor_shortcut.png')","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Paste each \"# %%\" block as a new cell at the END of your notebook.\n# Needs from the notebook (all already defined if you ran the Grad-CAM cells):\n#   model_best, predict_single, mat_to_bgr, predict, test_mri_files,\n#   test_items_pred, full_test, crop_model, full_model, MRI_CLASS_NAMES.\n# If crop_model / full_model are gone, reload them as in the Grad-CAM cells.\n\n# %% 1. Imports\nimport numpy as np, pandas as pd\nfrom tqdm import tqdm\nfrom scipy.stats import binomtest\nfrom sklearn.metrics import (accuracy_score, f1_score, recall_score,\n                             roc_auc_score, confusion_matrix)\n\n# %% 2. Did YOLO find a mask? (same files, same order as test_items_pred / full_test)\nhas_mask, yolo_cls = [], []\nfor f in tqdm(test_mri_files, desc='YOLO masks'):\n    img_bgr, _, _ = mat_to_bgr(f)\n    pc, _, pm, _ = predict_single(model_best, img_bgr)\n    has_mask.append(pm is not None)\n    yolo_cls.append(pc)                       # 0 = no detection, 1-3 = tumour class\nhas_mask, yolo_cls = np.array(has_mask), np.array(yolo_cls)\n\nassert len(has_mask) == len(test_items_pred) == len(full_test), 'order mismatch'\ny = np.array([l for _, l in full_test])\n\nprint(f'YOLO found a mask in {has_mask.mean():.1%} of test images')\nct = pd.crosstab(pd.Series(y, name='true').map(dict(enumerate(MRI_CLASS_NAMES))),\n                 pd.Series(has_mask, name='mask found'))\nprint(ct)\n\n# %% 3. Class probabilities from both classifiers (same test images)\n_, _, P_crop = predict(crop_model, test_items_pred)   # input = YOLO crop, or full image if no mask\n_, _, P_full = predict(full_model, full_test)         # input = full image\n\n# %% 4. The systems to compare\nH = has_mask[:, None]\nsystems = {\n    'Crop only (current pipeline)'            : P_crop,\n    'Full image only'                         : P_full,\n    'Routed: mask -> crop, no mask -> full'   : np.where(H, P_crop, P_full),\n    'Routed + average when a mask is found'   : np.where(H, (P_crop + P_full) / 2, P_full),\n}\n\ndef metrics(y, P):\n    p = P.argmax(1)\n    pc = f1_score(y, p, average=None, labels=list(range(len(MRI_CLASS_NAMES))), zero_division=0)\n    row = dict(acc=accuracy_score(y, p),\n               f1=f1_score(y, p, average='macro', zero_division=0),\n               recall=recall_score(y, p, average='macro', zero_division=0),\n               auc=roc_auc_score(y, P, multi_class='ovr'),\n               glioma_as_NoTumor=int(((y == 2) & (p == 0)).sum()))\n    row.update({f'F1 {n}': v for n, v in zip(MRI_CLASS_NAMES, pc)})\n    return row\n\ntab = pd.DataFrame({k: metrics(y, P) for k, P in systems.items()}).T\nprint(tab.round(4).to_string())\ntab.round(4).to_csv('routing_results.csv')\n\n# %% 5. Is the difference real? McNemar test and bootstrap CI on macro-F1\ndef mcnemar(y, pa, pb):\n    a_ok, b_ok = pa == y, pb == y\n    only_a = int((a_ok & ~b_ok).sum())        # A right, B wrong\n    only_b = int((~a_ok & b_ok).sum())        # B right, A wrong\n    n = only_a + only_b\n    return only_a, only_b, (binomtest(only_a, n, 0.5).pvalue if n else 1.0)\n\ndef boot_f1_diff(y, pa, pb, n=1000, seed=0):\n    rng = np.random.RandomState(seed)\n    d = []\n    for _ in range(n):\n        i = rng.randint(0, len(y), len(y))\n        d.append(f1_score(y[i], pb[i], average='macro', zero_division=0)\n                 - f1_score(y[i], pa[i], average='macro', zero_division=0))\n    return np.percentile(d, [2.5, 97.5])\n\nnames = list(systems)\npred = {k: P.argmax(1) for k, P in systems.items()}\npairs = [(names[0], names[2]),     # current pipeline vs routed\n         (names[2], names[1]),     # routed vs full image only\n         (names[0], names[1])]     # current pipeline vs full image only\nfor a, b in pairs:\n    oa, ob, pv = mcnemar(y, pred[a], pred[b])\n    lo, hi = boot_f1_diff(y, pred[a], pred[b])\n    print(f'{a}  ->  {b}\\n   only-A-right {oa}, only-B-right {ob}, McNemar p = {pv:.4f}, '\n          f'macro-F1 change 95% CI [{lo:+.3f}, {hi:+.3f}]\\n')\n\n# %% 6. Confusion matrix of the routed system\nPr = pred[names[2]]\ncm = confusion_matrix(y, Pr, labels=list(range(len(MRI_CLASS_NAMES))))\nprint(pd.DataFrame(cm, index=[f'true {n}' for n in MRI_CLASS_NAMES],\n                   columns=[f'pred {n}' for n in MRI_CLASS_NAMES]))\n\n# Accuracy split by whether YOLO found a mask: where does each classifier win?\nfor name, P in systems.items():\n    p = P.argmax(1)\n    print(f'{name:42s}  mask found: {np.mean(p[has_mask] == y[has_mask]):.3f}'\n          f'   no mask: {np.mean(p[~has_mask] == y[~has_mask]):.3f}')\n\n# %% 7. Optional: report the YOLO-only classifier next to these (no probabilities, so no AUC)\np_yolo = yolo_cls\nprint(f'YOLO top-box class: acc {accuracy_score(y, p_yolo):.4f}, '\n      f'macro-F1 {f1_score(y, p_yolo, average=\"macro\", zero_division=0):.4f}')","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ============================================================\n# LIME + SHAP (with Grad-CAM comparison) - single cell\n# Run AFTER the Grad-CAM cells. Needs: full_model, full_train, full_test,\n# test_gts, test_labels, df_full, preds_full, GradCAM, target_layer,\n# cam_scores, overlay, pick, tf_eval, BB, NUM_CLS, MRI_CLASS_NAMES, device\n# ============================================================\nimport subprocess, sys, inspect\nsubprocess.run([sys.executable, '-m', 'pip', 'install', 'lime', 'shap', 'scikit-image', '-q'])\n\nimport numpy as np, cv2, torch, pandas as pd\nimport matplotlib.pyplot as plt\nfrom tqdm import tqdm\nfrom skimage.segmentation import slic\nfrom lime import lime_image\nimport shap\n\n# ---------------- Settings ----------------\nLIME_SAMPLES  = 1000     # perturbed images per explanation\nLIME_SEGMENTS = 60       # approx. number of superpixels\nLIME_COMPACT  = 0.1      # SLIC compactness (try 0.01-1)\nSHAP_BG       = 64       # background images for SHAP\nSHAP_NSAMPLES = 100      # expected-gradients samples per image\nSHAP_SIGMA    = 2        # Gaussian smoothing of SHAP map (0 = off)\nXAI_BATCH     = 64\nN_PER_CLASS   = 30       # tumour test images per class (use 3 for a quick test)\n\n# ---------------- LIME ----------------\nlime_explainer = lime_image.LimeImageExplainer(random_state=0)\n_lime_params = inspect.signature(lime_explainer.explain_instance).parameters\n_slic_params = inspect.signature(slic).parameters\n\ndef lime_segments(im):\n    kw = dict(n_segments=LIME_SEGMENTS, compactness=LIME_COMPACT)\n    if 'start_label' in _slic_params:\n        kw['start_label'] = 0\n    if 'channel_axis' in _slic_params:\n        kw['channel_axis'] = -1\n    elif 'multichannel' in _slic_params:\n        kw['multichannel'] = True\n    return slic(im, **kw)\n\ndef lime_predict_fn(model):\n    @torch.no_grad()\n    def fn(imgs):\n        out = []\n        for s in range(0, len(imgs), XAI_BATCH):\n            x = torch.stack([tf_eval(np.clip(im, 0, 255).astype(np.uint8))\n                             for im in imgs[s:s + XAI_BATCH]])\n            out.append(model(x.to(device)).softmax(1).cpu().numpy())\n        return np.concatenate(out)\n    return fn\n\ndef lime_map(model, crop):\n    kw = dict(top_labels=1, hide_color=0, num_samples=LIME_SAMPLES,\n              batch_size=XAI_BATCH, segmentation_fn=lime_segments)\n    if 'progress_bar' in _lime_params:        # only newer LIME versions have this\n        kw['progress_bar'] = False\n    exp = lime_explainer.explain_instance(crop, lime_predict_fn(model), **kw)\n    c = exp.top_labels[0]\n    w = np.zeros(exp.segments.max() + 1, np.float32)\n    for sid, wt in exp.local_exp[c]:\n        w[sid] = wt\n    m = np.maximum(w[exp.segments], 0)\n    return m / (m.max() + 1e-8), c\n\n# ---------------- SHAP ----------------\ndef make_shap_explainer(model, items, n=SHAP_BG, seed=0):\n    idx = np.random.RandomState(seed).choice(len(items), min(n, len(items)), replace=False)\n    bg = torch.stack([tf_eval(items[i][0]) for i in idx]).to(device)\n    return shap.GradientExplainer(model.eval(), bg)\n\ndef shap_maps(model, explainer, crops):\n    x = torch.stack([tf_eval(c) for c in crops]).to(device)\n    with torch.no_grad():\n        pred = model(x).argmax(1).cpu().numpy()\n    sv = explainer.shap_values(x, nsamples=SHAP_NSAMPLES, rseed=0)\n    maps = []\n    for j, c in enumerate(pred):\n        a = sv[c][j] if isinstance(sv, list) else sv[j, ..., c]   # old/new shap formats\n        m = np.asarray(a).sum(0).astype(np.float32)\n        if SHAP_SIGMA:\n            m = cv2.GaussianBlur(m, (0, 0), SHAP_SIGMA)\n        m = np.maximum(m, 0)\n        maps.append(m / (m.max() + 1e-8))\n    return np.stack(maps), pred\n\nshap_expl = make_shap_explainer(full_model, full_train)\n\n# ---------------- Quantitative comparison ----------------\nrng_x = np.random.RandomState(1)\nsub = []\nfor c in range(1, NUM_CLS):\n    pool = [i for i in range(len(test_labels)) if test_labels[i] == c and test_gts[i].any()]\n    sub += rng_x.choice(pool, min(N_PER_CLASS, len(pool)), replace=False).tolist()\nprint(f'{len(sub)} tumour test images')\n\ndef score_row(i, m, pred):\n    ins, area, pt = cam_scores(m, test_gts[i])\n    l = int(full_test[i][1])\n    return dict(idx=i, cls=l, correct=int(pred == l), inside=ins, area=area,\n                enrich=ins / max(area, 1e-8), pointing=int(pt))\n\nrows = []\nfor i in tqdm(sub, desc='LIME'):\n    m, c = lime_map(full_model, full_test[i][0])\n    rows.append(score_row(i, m, c))\ndf_lime = pd.DataFrame(rows)\n\nrows = []\nfor s in tqdm(range(0, len(sub), 8), desc='SHAP'):\n    ids = sub[s:s + 8]\n    maps, pred = shap_maps(full_model, shap_expl, [full_test[i][0] for i in ids])\n    for k, i in enumerate(ids):\n        rows.append(score_row(i, maps[k], pred[k]))\ndf_shap = pd.DataFrame(rows)\n\ndf_gc = df_full.set_index('idx').loc[sub].reset_index()\n\ndef summ(df, name):\n    return dict(method=name, n=len(df), inside=df.inside.mean(), area=df.area.mean(),\n                enrich_median=df.enrich.median(), pointing=df.pointing.mean())\n\nxai_tab = pd.DataFrame([summ(df_gc, 'Grad-CAM'), summ(df_lime, 'LIME'),\n                        summ(df_shap, 'SHAP')]).round(3)\nprint(xai_tab.to_string(index=False))\n\nper_class = {}\nfor name, df in [('Grad-CAM', df_gc), ('LIME', df_lime), ('SHAP', df_shap)]:\n    g = df.groupby('cls').agg({'inside': 'mean', 'enrich': 'median', 'pointing': 'mean'})\n    g.index = [MRI_CLASS_NAMES[i] for i in g.index]\n    per_class[name] = g\nper_class = pd.concat(per_class, axis=1).round(3)\nprint('\\n', per_class)\n\nfor name, df in [('Grad-CAM', df_gc), ('LIME', df_lime), ('SHAP', df_shap)]:\n    print(f'\\n{name}: correct vs wrong')\n    print(df.groupby('correct')[['inside', 'enrich', 'pointing']].mean().round(3))\n\nxai_tab.to_csv('xai_attention_scores.csv', index=False)\nper_class.to_csv('xai_attention_scores_per_class.csv')\n\n# ---------------- Side-by-side figure ----------------\ndef outline(crop_bgr, gt):\n    out = cv2.cvtColor(crop_bgr, cv2.COLOR_BGR2RGB).copy()\n    if gt is not None and gt.any():\n        cnts, _ = cv2.findContours(gt.astype(np.uint8), cv2.RETR_EXTERNAL,\n                                   cv2.CHAIN_APPROX_SIMPLE)\n        cv2.drawContours(out, cnts, -1, (255, 255, 255), 1)\n    return out\n\ndef show_xai(model, items, idxs, gts, title, fname):\n    crops = [items[i][0] for i in idxs]\n    cg = GradCAM(model, target_layer(model, BB))\n    cams, cls, probs = cg(torch.stack([tf_eval(c) for c in crops]))\n    cg.remove()\n    smaps, _ = shap_maps(model, shap_expl, crops)\n    lmaps = [lime_map(model, c)[0] for c in tqdm(crops, desc='LIME figure')]\n\n    cols = ['Input', 'Grad-CAM', 'LIME', 'SHAP']\n    fig, axes = plt.subplots(len(idxs), 4, figsize=(14, 3.6 * len(idxs)))\n    axes = np.atleast_2d(axes)\n    for k, i in enumerate(idxs):\n        gt = gts[i] if gts is not None else None\n        panels = [outline(crops[k], gt),\n                  overlay(crops[k], cams[k], gt),\n                  overlay(crops[k], lmaps[k], gt),\n                  overlay(crops[k], smaps[k], gt)]\n        true, pred = MRI_CLASS_NAMES[items[i][1]], MRI_CLASS_NAMES[cls[k]]\n        for j, p in enumerate(panels):\n            axes[k, j].imshow(p); axes[k, j].axis('off')\n            if k == 0:\n                axes[k, j].set_title(cols[j], fontsize=12, fontweight='bold')\n        axes[k, 0].text(0.02, 0.98, f'True: {true}\\nPred: {pred} ({probs[k][cls[k]]:.2f})',\n                        transform=axes[k, 0].transAxes, va='top', fontsize=9, fontweight='bold',\n                        color='#2E7D32' if true == pred else '#C62828',\n                        bbox=dict(boxstyle='round', facecolor='white', alpha=0.85))\n    plt.suptitle(title, fontsize=13, fontweight='bold')\n    plt.tight_layout()\n    plt.savefig(fname, dpi=150, bbox_inches='tight')\n    plt.show()\n\nrng = np.random.RandomState(0)\nsel_xai = pick(np.array(preds_full), test_labels, per=1)\nshow_xai(full_model, full_test, sel_xai, test_gts,\n         'Grad-CAM vs LIME vs SHAP, full-image ConvNeXt-V2 (white outline = GT tumour)',\n         'xai_comparison.png')","metadata":{"trusted":true},"outputs":[],"execution_count":null}]}