ection import train_test_split\n","from sklearn.metrics import (\n","    accuracy_score, f1_score, precision_score, recall_score,\n","    classification_report, confusion_matrix,\n","    roc_auc_score, cohen_kappa_score, matthews_corrcoef\n",")\n","import matplotlib.pyplot as plt\n","import matplotlib.patches as mpatches\n","import seaborn as sns\n","from tqdm import tqdm\n","\n","import torch\n","from ultralytics import YOLO\n","\n","print(f'PyTorch   : {torch.__version__}')\n","print(f'CUDA      : {torch.cuda.is_available()}')\n","device = 'cuda' if torch.cuda.is_available() else 'cpu'\n","print(f'Device    : {device}')\n","\n","torch.manual_seed(42)\n","np.random.seed(42)"]},{"cell_type":"markdown","id":"33035c4f","metadata":{"papermill":{"duration":0.007768,"end_time":"2026-10-14T10:14:56.053174+00:00","exception":false,"start_time":"2026-10-14T10:14:56.045406+00:00","status":"completed"},"tags":[]},"source":["## 3. Configuration\n","\n","All paths and hyperparameters in one place.  \n","Adjust `BASE_PATH` to point to your BriscMat dataset root."]},{"cell_type":"code","execution_count":6,"id":"43081132","metadata":{"execution":{"iopub.execute_input":"2026-10-14T10:14:56.07004Z","iopub.status.busy":"2026-10-14T10:14:56.069656Z","iopub.status.idle":"2026-10-14T10:14:56.075823Z","shell.execute_reply":"2026-10-14T10:14:56.074911Z"},"papermill":{"duration":0.01622,"end_time":"2026-10-14T10:14:56.077485+00:00","exception":false,"start_time":"2026-10-14T10:14:56.061265+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Configuration loaded.\n","  Dataset root : /kaggle/input/datasets/vivanrv/briscmat-brain-tumour-mri-dataset-2026/BriscMat\n","  YOLO data dir: /kaggle/working/yolo_briscmat\n","  Image size   : 640×640\n","  Epochs       : 15\n","  Classes      : {0: 'No Tumor', 1: 'Meningioma', 2: 'Glioma', 3: 'Pituitary'}\n"]}],"source":["# ─────────────────────────────────────────────\n","# CONFIGURATION\n","# ─────────────────────────────────────────────\n","\n","BASE_PATH   = '/kaggle/input/datasets/vivanrv/briscmat-brain-tumour-mri-dataset-2026/BriscMat'\n","YOLO_DATA   = '/kaggle/working/yolo_briscmat'   # where we write YOLO-format dataset\n","RUNS_DIR    = '/kaggle/working/runs'\n","\n","IMG_SIZE    = 640       # YOLO native size (must be multiple of 32)\n","BATCH_SIZE  = 16\n","EPOCHS      = 15\n","VAL_SPLIT   = 0.20\n","\n","NON_MRI_LABEL   = 4\n","NUM_MRI_CLASSES = 4\n","MRI_CLASS_NAMES = ['No Tumor', 'Meningioma', 'Glioma', 'Pituitary']\n","ALL_CLASS_NAMES = MRI_CLASS_NAMES + ['Non-MRI']\n","CLASS_COLORS    = ['#2196F3','#4CAF50','#FF5722','#9C27B0','#607D8B']\n","\n","# Gate: if max YOLO confidence < this, treat as Non-MRI\n","GATE_CONF_THRESH = 0.25\n","\n","print('Configuration loaded.')\n","print(f'  Dataset root : {BASE_PATH}')\n","print(f'  YOLO data dir: {YOLO_DATA}')\n","print(f'  Image size   : {IMG_SIZE}×{IMG_SIZE}')\n","print(f'  Epochs       : {EPOCHS}')\n","print(f'  Classes      : {dict(enumerate(MRI_CLASS_NAMES))}')"]},{"cell_type":"markdown","id":"869a462b","metadata":{"papermill":{"duration":0.007127,"end_time":"2026-10-14T10:14:56.091871+00:00","exception":false,"start_time":"2026-10-14T10:14:56.084744+00:00","status":"completed"},"tags":[]},"source":["## 4. Load .mat Files & Build Train/Val/Test Split\n","\n","We load all `.mat` files, extract labels, and perform a **stratified 80/20 split** on the Train pool.  \n","The test set is kept completely locked until final evaluation.\n","\n","> **Non-MRI samples** are excluded from YOLO training (YOLO only learns the 4 MRI tumour classes).  \n","> We handle Non-MRI detection separately via a confidence gate at inference time."]},{"cell_type":"code","execution_count":7,"id":"31b237d1","metadata":{"execution":{"iopub.execute_input":"2026-10-14T10:14:56.10789Z","iopub.status.busy":"2026-10-14T10:14:56.107592Z","iopub.status.idle":"2026-10-14T10:16:23.166649Z","shell.execute_reply":"2026-10-14T10:16:23.165769Z"},"papermill":{"duration":87.069076,"end_time":"2026-10-14T10:16:23.168723+00:00","exception":false,"start_time":"2026-10-14T10:14:56.099647+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Train pool : 6314 files\n","Test pool  : 1306 files\n","\n","Reading labels (may take ~30s)...\n"]},{"name":"stderr","output_type":"stream","text":["100%|██████████| 6314/6314 [01:11<00:00, 87.79it/s]\n"]},{"name":"stdout","output_type":"stream","text":["\n","Train class distribution:\n","  Label 0 (No Tumor    ):  1067\n","  Label 1 (Meningioma  ):  1329\n","  Label 2 (Glioma      ):  1147\n","  Label 3 (Pituitary   ):  1457\n","  Label 4 (Non-MRI     ):  1314\n","\n","Reading test labels...\n"]},{"name":"stderr","output_type":"stream","text":["100%|██████████| 1306/1306 [00:14<00:00, 87.49it/s] "]},{"name":"stdout","output_type":"stream","text":["\n","Split summary:\n","  Train (MRI): 4000\n","  Val   (MRI): 1000\n","  Test  (MRI): 1000\n","  Test (NonMRI): 306\n"]},{"name":"stderr","output_type":"stream","text":["\n"]}],"source":["def numeric_sort_key(fp):\n","    nums = re.findall(r'\\d+', fp.split('/')[-1])\n","    return int(nums[0]) if nums else 0\n","\n","def extract_label(mat_path):\n","    try:\n","        data = scipy.io.loadmat(mat_path)\n","        for key in ['cjdata.label', 'label', 'tumorLabel', 'Class']:\n","            if key in data:\n","                val = data[key]\n","                try:    return int(val[0][0])\n","                except: return int(val.flat[0])\n","    except:\n","        pass\n","    return NON_MRI_LABEL\n","\n","def load_mat(mat_path):\n","    \"\"\"Returns (image_np_float32, mask_np_float32, label_int)\"\"\"\n","    data = scipy.io.loadmat(mat_path)\n","    img_key = 'cjdata.image'     if 'cjdata.image'     in data else 'image'\n","    msk_key = 'cjdata.tumorMask' if 'cjdata.tumorMask' in data else 'tumorMask'\n","    lbl_key = 'cjdata.label'     if 'cjdata.label'     in data else 'label'\n","    img  = data[img_key].astype(np.float32)\n","    mask = data[msk_key].astype(np.float32) if msk_key in data else np.zeros_like(img)\n","    lbl  = int(data[lbl_key].flat[0]) if lbl_key in data else NON_MRI_LABEL\n","    return img, mask, lbl\n","\n","# ── Scan files ──\n","all_train_mat = sorted(glob.glob(f'{BASE_PATH}/Train/*.mat'), key=numeric_sort_key)\n","test_mat      = sorted(glob.glob(f'{BASE_PATH}/Test/*.mat'),  key=numeric_sort_key)\n","print(f'Train pool : {len(all_train_mat)} files')\n","print(f'Test pool  : {len(test_mat)} files')\n","\n","# ── Extract labels ──\n","print('\\nReading labels (may take ~30s)...')\n","all_train_labels = [extract_label(f) for f in tqdm(all_train_mat)]\n","\n","dist = dict(sorted(Counter(all_train_labels).items()))\n","print('\\nTrain class distribution:')\n","for lbl, cnt in dist.items():\n","    print(f'  Label {lbl} ({ALL_CLASS_NAMES[lbl]:12s}): {cnt:5d}')\n","\n","# ── Stratified split (MRI only for YOLO training) ──\n","mri_files  = [f for f,l in zip(all_train_mat, all_train_labels) if l < NON_MRI_LABEL]\n","mri_labels = [l for l in all_train_labels if l < NON_MRI_LABEL]\n","\n","train_files, val_files, train_labels, val_labels = train_test_split(\n","    mri_files, mri_labels, test_size=VAL_SPLIT, random_state=42, stratify=mri_labels\n",")\n","\n","# Test MRI files only (for segmentation metrics)\n","print('\\nReading test labels...')\n","test_labels   = [extract_label(f) for f in tqdm(test_mat)]\n","test_mri_files  = [f for f,l in zip(test_mat, test_labels) if l < NON_MRI_LABEL]\n","test_mri_labels = [l for f,l in zip(test_mat, test_labels) if l < NON_MRI_LABEL]\n","test_nonmri_files = [f for f,l in zip(test_mat, test_labels) if l == NON_MRI_LABEL]\n","\n","print(f'\\nSplit summary:')\n","print(f'  Train (MRI): {len(train_files)}')\n","print(f'  Val   (MRI): {len(val_files)}')\n","print(f'  Test  (MRI): {len(test_mri_files)}')\n","print(f'  Test (NonMRI): {len(test_nonmri_files)}')"]},{"cell_type":"markdown","id":"c9fbf94f","metadata":{"papermill":{"duration":0.034261,"end_time":"2026-10-14T10:16:23.241099+00:00","exception":false,"start_time":"2026-10-14T10:16:23.206838+00:00","status":"completed"},"tags":[]},"source":["## 5. Convert BriscMat → YOLO Segmentation Format\n","\n","YOLO segmentation expects each image to have a paired `.txt` label file containing:\n","```\n","<class_id> <x1> <y1> <x2> <y2> ... <xn> <yn>   # polygon coords normalized 0-1\n","```\n","\n","We extract tumour mask contours from the `.mat` ground truth masks and convert them to YOLO polygon format.  \n","For **No Tumor** (label 0) images, we write an **empty label file** — YOLO treats these as background-only images."]},{"cell_type":"code","execution_count":8,"id":"2cddafeb","metadata":{"execution":{"iopub.execute_input":"2026-10-14T10:16:23.310885Z","iopub.status.busy":"2026-10-14T10:16:23.31065Z","iopub.status.idle":"2026-10-14T10:18:13.66264Z","shell.execute_reply":"2026-10-14T10:18:13.661842Z"},"papermill":{"duration":110.389704,"end_time":"2026-10-14T10:18:13.665039+00:00","exception":false,"start_time":"2026-10-14T10:16:23.275335+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Writing YOLO-format dataset...\n"]},{"name":"stderr","output_type":"stream","text":["Writing train: 100%|██████████| 4000/4000 [01:13<00:00, 54.62it/s]\n"]},{"name":"stdout","output_type":"stream","text":["  Done. Skipped 0 corrupt files.\n"]},{"name":"stderr","output_type":"stream","text":["Writing val: 100%|██████████| 1000/1000 [00:18<00:00, 53.74it/s]\n"]},{"name":"stdout","output_type":"stream","text":["  Done. Skipped 0 corrupt files.\n"]},{"name":"stderr","output_type":"stream","text":["Writing test: 100%|██████████| 1000/1000 [00:18<00:00, 54.08it/s]"]},{"name":"stdout","output_type":"stream","text":["  Done. Skipped 0 corrupt files.\n","\n","Dataset written.\n"]},{"name":"stderr","output_type":"stream","text":["\n"]}],"source":["def mask_to_yolo_polygon(mask_np, img_h, img_w, max_points=100):\n","    \"\"\"\n","    Convert binary mask → largest contour → YOLO normalized polygon string.\n","    Returns None if mask is empty.\n","    \"\"\"\n","    mask_u8 = (mask_np > 0).astype(np.uint8)\n","    if mask_u8.sum() == 0:\n","        return None\n","\n","    contours, _ = cv2.findContours(mask_u8, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n","    if not contours:\n","        return None\n","\n","    # Largest contour only\n","    cnt = max(contours, key=cv2.contourArea)\n","    if len(cnt) < 3:\n","        return None\n","\n","    # Downsample polygon if too many points\n","    if len(cnt) > max_points:\n","        step = len(cnt) // max_points\n","        cnt  = cnt[::step]\n","\n","    pts = cnt.squeeze()  # (N, 2)\n","    if pts.ndim == 1:    # only 1 point\n","        return None\n","\n","    # Normalize\n","    pts = pts.astype(np.float32)\n","    pts[:, 0] /= img_w\n","    pts[:, 1] /= img_h\n","    pts = np.clip(pts, 0, 1)\n","\n","    coord_str = ' '.join(f'{x:.6f} {y:.6f}' for x, y in pts)\n","    return coord_str\n","\n","\n","def write_yolo_dataset(file_list, label_list, split_name, out_root, img_size=640):\n","    \"\"\"\n","    Write images + YOLO label files for one split.\n","    Images are saved as uint8 PNG (normalized, 3-channel).\n","    \"\"\"\n","    img_dir = Path(out_root) / 'images' / split_name\n","    lbl_dir = Path(out_root) / 'labels' / split_name\n","    img_dir.mkdir(parents=True, exist_ok=True)\n","    lbl_dir.mkdir(parents=True, exist_ok=True)\n","\n","    skipped = 0\n","    for mat_path, lbl in tqdm(zip(file_list, label_list),\n","                              total=len(file_list),\n","                              desc=f'Writing {split_name}'):\n","        try:\n","            img, mask, _ = load_mat(mat_path)\n","        except Exception as e:\n","            skipped += 1\n","            continue\n","\n","        # Resize\n","        img_rs  = cv2.resize(img,  (img_size, img_size), interpolation=cv2.INTER_LINEAR)\n","        mask_rs = cv2.resize(mask, (img_size, img_size), interpolation=cv2.INTER_NEAREST)\n","\n","        # Normalize → uint8\n","        img_rs = (img_rs - img_rs.min()) / (img_rs.max() - img_rs.min() + 1e-8)\n","        img_u8 = (img_rs * 255).astype(np.uint8)\n","        img_bgr = cv2.cvtColor(img_u8, cv2.COLOR_GRAY2BGR)  # YOLO expects 3 channels\n","\n","        stem = Path(mat_path).stem\n","        cv2.imwrite(str(img_dir / f'{stem}.png'), img_bgr)\n","\n","        # Label file\n","        label_txt = lbl_dir / f'{stem}.txt'\n","        if lbl == 0:  # No Tumor → empty label\n","            label_txt.write_text('')\n","        else:         # Tumor → polygon\n","            poly = mask_to_yolo_polygon(mask_rs, img_size, img_size)\n","            if poly:\n","                label_txt.write_text(f'{lbl - 1} {poly}\\n')  # shift: 1→0, 2→1, 3→2\n","                # ^ YOLO class IDs: 0=Meningioma, 1=Glioma, 2=Pituitary\n","            else:\n","                label_txt.write_text('')  # mask empty → treat as no-tumor\n","\n","    print(f'  Done. Skipped {skipped} corrupt files.')\n","\n","\n","# ── Write all splits ──\n","# YOLO class mapping:\n","#   mat label 0 (No Tumor)   → empty .txt  (background)\n","#   mat label 1 (Meningioma) → class 0\n","#   mat label 2 (Glioma)     → class 1\n","#   mat label 3 (Pituitary)  → class 2\n","\n","print('Writing YOLO-format dataset...')\n","write_yolo_dataset(train_files, train_labels, 'train', YOLO_DATA)\n","write_yolo_dataset(val_files,   val_labels,   'val',   YOLO_DATA)\n","write_yolo_dataset(test_mri_files, test_mri_labels, 'test', YOLO_DATA)\n","print('\\nDataset written.')"]},{"cell_type":"markdown","id":"7480a05d","metadata":{"papermill":{"duration":0.07659,"end_time":"2026-10-14T10:18:13.821071+00:00","exception":false,"start_time":"2026-10-14T10:18:13.744481+00:00","status":"completed"},"tags":[]},"source":["## 6. Write YOLO dataset.yaml\n","\n","The YAML file tells Ultralyti