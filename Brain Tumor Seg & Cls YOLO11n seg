                                                             \nFull image (no segmentation)  0.9797  0.0032  0.9806  0.0030  0.9818  0.0032   \nGT-mask crop (oracle)         0.9593  0.0059  0.9649  0.0051  0.9644  0.0051   \nYOLO-mask crop (pipeline)     0.9323  0.0059  0.9273  0.0054  0.9388  0.0051   \n\n                                 auc          \n                                mean     std  \nsetting                                       \nFull image (no segmentation)  0.9992  0.0004  \nGT-mask crop (oracle)         0.9943  0.0012  \nYOLO-mask crop (pipeline)     0.9806  0.0009  \n","output_type":"stream"}],"execution_count":40},{"cell_type":"code","source":"# Paste each \"# %%\" block as a new cell at the END of your notebook.\n# Needs from the notebook: train_files/train_labels, val_files/val_labels, mat_to_bgr,\n# make_crop, train_one, predict, predict_single, compute_seg_metrics, write_yolo_dataset,\n# full_test, test_items_gt, test_mri_files, test_mri_labels, NUM_CLS, CROP, IMG_SIZE,\n# BATCH_SIZE, RUNS_DIR, MRI_CLASS_NAMES, device, timm, torch, yaml, YOLO.\n#\n# Design: the 5,000 MRI images (train + val) are split into K folds. Each image is\n# predicted once by a model that never saw it (out-of-fold, OOF). The original test\n# set stays locked and is also scored by every fold model.\n# Every fold is saved to disk, so you can stop and resume after a session timeout.\n#\n# Rough time on a T4 (K=5): classifiers ~2 h (full image + GT crop),\n# YOLO per fold ~1.5 h extra (optional, block 6).\n\n# %% 1. Settings\nimport numpy as np, pandas as pd, cv2, gc, os, shutil, scipy.io\nfrom tqdm import tqdm\nfrom pathlib import Path\nfrom sklearn.model_selection import StratifiedGroupKFold, StratifiedKFold\nfrom sklearn.metrics import accuracy_score, f1_score, recall_score, roc_auc_score\nfrom scipy.stats import binomtest\n\nK          = 5\nCV_SEED    = 42\nINNER_VAL  = 10            # inner validation = 1/INNER_VAL of each training part (model selection)\nCV_DIR     = '/kaggle/working/cv'\nFOLDS_TO_RUN = list(range(K))      # e.g. [0, 1] to run only some folds now\nRUN_YOLO_FOLDS = False             # True = also train YOLO per fold (block 6)\nYOLO_EPOCHS    = 15\nos.makedirs(CV_DIR, exist_ok=True)\n\n# %% 2. Build the folds (patient-aware if patient IDs exist)\npool_files  = list(train_files) + list(val_files)\npool_labels = np.array(list(train_labels) + list(val_labels))\nN = len(pool_files)\n\nprint('Keys in one .mat file:', [k for k in scipy.io.loadmat(pool_files[0]).keys()\n                                 if not k.startswith('__')])\n\ndef get_pid(f):\n    try:\n        d = scipy.io.loadmat(f)\n    except Exception:\n        return None\n    for key in ('cjdata.PID', 'PID', 'pid', 'patient_id', 'PatientID'):\n        if key in d:\n            return str(np.array(d[key]).flat[0])\n    return None\n\npids = [get_pid(f) for f in tqdm(pool_files, desc='patient ids')]\nhave_pid = all(p is not None for p in pids)\ngroups = np.array(pids) if have_pid else None\n\nif have_pid:\n    print(f'Patient IDs found: {len(set(pids))} patients for {N} images -> group-aware folds.')\n    splitter = StratifiedGroupKFold(n_splits=K, shuffle=True, random_state=CV_SEED)\n    folds = list(splitter.split(np.zeros(N), pool_labels, groups))\n    for tr, te in folds:\n        assert not (set(groups[tr]) & set(groups[te])), 'patient appears in train and test'\nelse:\n    print('WARNING: no patient IDs found. Folds are image-level, so images from the same '\n          'patient can sit in both train and test. Report this as a limitation.')\n    splitter = StratifiedKFold(n_splits=K, shuffle=True, random_state=CV_SEED)\n    folds = list(splitter.split(np.zeros(N), pool_labels))\n\nfor k, (tr, te) in enumerate(folds):\n    print(f'fold {k}: train {len(tr)}, held-out {len(te)}, held-out per class',\n          np.bincount(pool_labels[te], minlength=NUM_CLS).tolist())\n\ndef inner_split(k):\n    \"\"\"Split fold k's training part into (train, validation). Validation only picks\n    the best epoch; the held-out fold is never used for that.\"\"\"\n    tr = np.asarray(folds[k][0])\n    if have_pid:\n        sp = StratifiedGroupKFold(INNER_VAL, shuffle=True, random_state=CV_SEED + k)\n        a, b = next(sp.split(tr, pool_labels[tr], groups[tr]))\n    else:\n        sp = StratifiedKFold(INNER_VAL, shuffle=True, random_state=CV_SEED + k)\n        a, b = next(sp.split(tr, pool_labels[tr]))\n    return tr[a], tr[b]\n\n# %% 3. Cache full-image and GT-crop inputs once\npool_full, pool_crop = [], []\nfor f, l in tqdm(list(zip(pool_files, pool_labels)), desc='building inputs'):\n    img_bgr, gt, _ = mat_to_bgr(f)\n    pool_full.append((make_crop(img_bgr, None), int(l)))\n    pool_crop.append((make_crop(img_bgr, gt if l > 0 else None), int(l)))\ny_test = np.array([l for _, l in full_test])\n\n# %% 4. Cross-validate the two classifiers (ConvNeXt-V2 Tiny)\ndef run_cv(name, pool_items, test_items):\n    global train_items, val_items, BACKBONE\n    BACKBONE = 'convnextv2_tiny'\n    saved = (train_items, val_items)\n    for k in FOLDS_TO_RUN:\n        path = f'{CV_DIR}/{name}_fold{k}.npz'\n        if os.path.exists(path):\n            print(f'{name} fold {k}: already done, skipping'); continue\n        inner_tr, inner_val = inner_split(k)\n        train_items = [pool_items[i] for i in inner_tr]\n        val_items   = [pool_items[i] for i in inner_val]\n        print(f'===== {name} | fold {k} | train {len(train_items)} val {len(val_items)} =====')\n        m = train_one(CV_SEED + k)\n        te = np.asarray(folds[k][1])\n        _, _, P_oof  = predict(m, [pool_items[i] for i in te])\n        _, _, P_test = predict(m, test_items)\n        torch.save(m.state_dict(), f'{CV_DIR}/{name}_fold{k}.pt')\n        np.savez(path, te=te, P_oof=P_oof, P_test=P_test)\n        del m; gc.collect(); torch.cuda.empty_cache()\n    train_items, val_items = saved\n\nrun_cv('full',   pool_full, full_test)        # whole image in, no segmentation\nrun_cv('oracle', pool_crop, test_items_gt)    # crop from ground-truth mask\n\n# %% 5. Results for the two classifiers (fold-wise mean +/- SD, pooled OOF)\ndef metrics_row(y, P):\n    p = P.argmax(1)\n    return dict(acc=accuracy_score(y, p),\n                f1=f1_score(y, p, average='macro', zero_division=0),\n                recall=recall_score(y, p, average='macro', zero_division=0),\n                auc=roc_auc_score(y, P, multi_class='ovr'))\n\ndef summarize(rows, title):\n    df = pd.DataFrame(rows)\n    out = df.groupby('system')[['acc', 'f1', 'recall', 'auc']].agg(['mean', 'std']).round(4)\n    print(f'\\n{title}\\n', out.to_string())\n    return df, out\n\nrows_oof, rows_test = [], []\nfor name, label in [('full', 'Full image'), ('oracle', 'GT crop (oracle)')]:\n    for k in FOLDS_TO_RUN:\n        d = np.load(f'{CV_DIR}/{name}_fold{k}.npz')\n        rows_oof.append(dict(system=label, fold=k, **metrics_row(pool_labels[d['te']], d['P_oof'])))\n        rows_test.append(dict(system=label, fold=k, **metrics_row(y_test, d['P_test'])))\n\ndf_oof,  tab_oof  = summarize(rows_oof,  f'{K}-fold, held-out folds (each image predicted by a model that never saw it)')\ndf_test, tab_test = summarize(rows_test, 'Locked test set, one score per fold model')\ntab_oof.to_csv('cv_classifiers_oof.csv'); tab_test.to_csv('cv_classifiers_test.csv')\n\n# %% 6. OPTIONAL: YOLO per fold -> real pipeline (crop, routed) with segmentation metrics\n# Set RUN_YOLO_FOLDS = True in block 1 and re-run block 1 first. Each fold trains YOLO\n# on that fold's training images only, so held-out masks are honest.\ndef crops_from_yolo(files, labels, ymodel):\n    items, has, ycls, dice = [], [], [], []\n    for f, l in zip(files, labels):\n        img_bgr, gt, _ = mat_to_bgr(f)\n        pc, _, pm, _ = predict_single(ymodel, img_bgr)\n        if pm is None:\n            box, seg = None, np.zeros((IMG_SIZE, IMG_SIZE), np.float32)\n        else:\n            seg = cv2.resize(pm.astype(np.float32), (IMG_SIZE, IMG_SIZE),\n                             interpolation=cv2.INTER_NEAREST)\n            box = seg > 0.5\n        items.append((make_crop(img_bgr, box), int(l)))\n        has.append(pm is not None); ycls.append(pc)\n        dice.append(compute_seg_metrics(seg, gt)['dice'] if l > 0 else np.nan)\n    return items, np.array(has), np.array(ycls), np.array(dice)\n\ndef load_cls(path):\n    mdl = timm.create_model('convnextv2_tiny', pretrained=False, num_classes=NUM_CLS).to(device)\n    mdl.load_state_dict(torch.load(path, map_location=device))\n    return mdl.eval()\n\nif RUN_YOLO_FOLDS:\n    for k in FOLDS_TO_RUN:\n        path = f'{CV_DIR}/yolo_fold{k}.npz'\n        if os.path.exists(path):\n            print(f'yolo fold {k}: already done, skipping'); continue\n        inner_tr, inner_val = inner_split(k)\n        root = f'/kaggle/working/yolo_cv_fold{k}'\n        write_yolo_dataset([pool_files[i] for i in inner_tr],  pool_labels[inner_tr].tolist(),  'train', root)\n        write_yolo_dataset([pool_files[i] for i in inner_val], pool_labels[inner_val].tolist(), 'val',   root)\n        with open(f'{root}/dataset.yaml', 'w') as fh:\n            yaml.dump(dict(path=root, train='images/train', val='images/val', nc=3,\n                           names=['Meningioma', 'Glioma', 'Pituitary']), fh)\n        res = YOLO('yolo11n-seg.pt').train(\n            data=f'{root}/dataset.yaml', epochs=YOLO_EPOCHS, imgsz=IMG_SIZE, batch=BATCH_SIZE,\n            device=0 if device == 'cuda' else 'cpu', project=RUNS_DIR, name=f'cv_fold{k}',\n            exist_ok=True, optimizer='AdamW', lr0=0.001, lrf=0.01, warmup_epochs=5,\n            weight_decay=0.0005, flipud=0.5, fliplr=0.5, mosaic=1.0, mixup=0.1,\n            copy_paste=0.1, degrees=15, translate=0.1, scale=0.5, overlap_mask=False,\n            patience=20, plots=False, verbose=False, seed=CV_SEED + k)\n        ymodel = YOLO(f'{res.save_dir}/weights/best.pt')\n        shutil.rmtree(root, ignore_errors=True)\n\n        te = np.asarray(folds[k][1])\n        items_oof, has_oof, ycls_oof, dice_oof = crops_from_yolo(\n            [pool_files[i] for i in te], pool_labels[te], ymodel)\n        items_te, has_te, ycls_te, dice_te = crops_from_yolo(\n            test_mri_files, test_mri_labels, ymodel)\n\n        cls_model = load_cls(f'{CV_DIR}/oracle_fold{k}.pt')     # trained on GT crops\n        _, _, P_pipe_oof  = predict(cls_model, items_oof)\n        _, _, P_pipe_test = predict(cls_model, items_te)\n        np.savez(path, te=te, has_oof=has_oof, has_test=has_te, ycls_oof=ycls_oof,\n                 ycls_test=ycls_te, dice_oof=dice_oof, dice_test=dice_te,\n                 P_pipe_oof=P_pipe_oof, P_pipe_test=P_pipe_test)\n        del ymodel, cls_model; gc.collect(); torch.cuda.empty_cache()\n\n# %% 7. All systems side by side (needs block 6 for the pipeline rows)\ndef fold_systems(k, split):\n    key = 'P_oof' if split == 'oof' else 'P_test'\n    out = {'Full image': np.load(f'{CV_DIR}/full_fold{k}.npz')[key],\n           'GT crop (oracle)': np.load(f'{CV_DIR}/oracle_fold{k}.npz')[key]}\n    yp = f'{CV_DIR}/yolo_fold{k}.npz'\n    if os.path.exists(yp):\n        d = np.load(yp); H = d['has_' + ('oof' if split == 'oof' else 'test')][:, None]\n        Pp = d['P_pipe_' + ('oof' if split == 'oof' else 'test')]\n        Pf = out['Full image']\n        out['YOLO crop (pipeline)'] = Pp\n        out['Routed (no mask -> full)'] = np.where(H, Pp, Pf)\n        out['Routed + average'] = np.where(H, (Pp + Pf) / 2, Pf)\n    return out\n\n# pooled out-of-fold predictions: one prediction per image, N images\npooled = {}\nfor k in FOLDS_TO_RUN:\n    te = np.load(f'{CV_DIR}/full_fold{k}.npz')['te']\n    for name, P in fold_systems(k, 'oof').items():\n        pooled.setdefault(name, np.zeros((N, NUM_CLS)))[te] = P\ncovered = np.zeros(N, bool)\nfor k in FOLDS_TO_RUN:\n    covered[np.load(f'{CV_DIR}/full_fold{k}.npz')['te']] = True\ny_cov = pool_labels[covered]\n\nprint(f'\\nPooled out-of-fold results ({covered.sum()} images)')\npool_tab = pd.DataFrame({n: metrics_row(y_cov, P[covered]) for n, P in pooled.items()}).T.round(4)\nprint(pool_tab.to_string()); pool_tab.to_csv('cv_pooled_oof.csv')\n\ndef mcnemar(y, pa, pb):\n    a_ok, b_ok = pa == y, pb == y\n    oa, ob = int((a_ok & ~b_ok).sum()), int((~a_ok & b_ok).sum())\n    return oa, ob, (binomtest(oa, oa + ob, 0.5).pvalue if oa + ob else 1.0)\n\ndef boot_f1_diff(y, pa, pb, n=1000, seed=0):\n    rng = np.random.RandomState(seed); d = []\n    for _ in range(n):\n        i = rng.randint(0, len(y), len(y))\n        d.append(f1_score(y[i], pb[i], average='macro', zero_division=0)\n                 - f1_score(y[i], pa[i], average='macro', zero_division=0))\n    return np.percentile(d, [2.5, 97.5])\n\nbase = pooled['Full image'][covered].argmax(1)\nprint('\\nEach system vs the full-image classifier (pooled OOF)')\nfor name, P in pooled.items():\n    if name == 'Full image': continue\n    p = P[covered].argmax(1)\n    oa, ob, pv = mcnemar(y_cov, base, p)\n    lo, hi = boot_f1_diff(y_cov, base, p)\n    print(f'{name:28s} full-only-right {oa:4d}  system-only-right {ob:4d}  '\n          f'McNemar p={pv:.4f}  macro-F1 change CI [{lo:+.3f}, {hi:+.3f}]')\n\n# fold-wise mean +/- SD for every available system, on held-out folds and locked test\nfor split, label in [('oof', 'held-out folds'), ('test', 'locked test set')]:\n    rows = []\n    for k in FOLDS_TO_RUN:\n        y = pool_labels[np.load(f'{CV_DIR}/full_fold{k}.npz')['te']] if split == 'oof' else y_test\n        for name, P in fold_systems(k, split).items():\n            rows.append(dict(system=name, fold=k, **metrics_row(y, P)))\n    summarize(rows, f'Fold-wise mean and SD on the {label}')\n\n# segmentation quality per fold (only if block 6 was run)\ndice_rows = []\nfor k in FOLDS_TO_RUN:\n    yp = f'{CV_DIR}/yolo_fold{k}.npz'\n    if os.path.exists(yp):\n        d = np.load(yp)\n        dice_rows.append(dict(fold=k, dice_tumour=np.nanmean(d['dice_oof']),\n                              mask_found=d['has_oof'].mean(),\n                              missed_tumours=int(((~d['has_oof']) & (pool_labels[d['te']] > 0)).sum())))\nif dice_rows:\n    dd = pd.DataFrame(dice_rows)\n    print('\\nYOLO per fold (held-out images)\\n', dd.round(4).to_string(index=False))\n    print(f\"Tumour Dice: {dd.dice_tumour.mean():.4f} +/- {dd.dice_tumour.std():.4f}\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Paste each \"# %%\" block as a new cell at the END of your notebook.\n# Needs from the notebook: models, full_train, full_val, full_test, test_items_pred,\n# test_items_gt, test_mri_files, train_one, train_items, val_items, BACKBONE,\n# tf_eval, predict, mat_to_bgr, device, CROP, NUM_CLS, MRI_CLASS_NAMES, timm, torch.\n# No extra pip install: Grad-CAM is implemented here with plain PyTorch hooks.\n\n# %% 1. Imports\nimport os\nimport numpy as np, cv2, torch, torch.nn.functional as F, pandas as pd, timm\nimport matplotlib.pyplot as plt\nfrom tqdm import tqdm\n\n# %% 2. Train and save the full-image model (seed 44) - run ONCE\n# `m` was overwritten by a later cell (it is a numpy array now), so the full-image\n# model is retrained here and saved to disk. The result goes in `full_m`, never `m`.\nFULL_PATH = 'convnextv2_full_seed44.pt'\n\nif os.path.exists(FULL_PATH):\n    print(f'{FULL_PATH} already exists - skipping retraining.')\nelse:\n    _saved = (train_items, val_items, BACKBONE)          # remember current notebook state\n    try:\n        train_items, val_items = full_train, full_val    # full-image data\n        BACKBONE = 'convnextv2_tiny'\n        full_m = train_one(44)                           # must return the trained model\n        assert isinstance(full_m, torch.nn.Module), \\\n            f'train_one returned {type(full_m)}, expected a torch model'\n        torch.save(full_m.state_dict(), FULL_PATH)\n        print('Saved', FULL_PATH)\n        del full_m\n    finally:\n        train_items, val_items, BACKBONE = _saved        # always restore notebook state\n\n# %% 3. Load models and the Grad-CAM class\ndef load_model(timm_name, path):\n    mdl = timm.create_model(timm_name, pretrained=False, num_classes=NUM_CLS).to(device)\n    mdl.load_state_dict(torch.load(path, map_location=device))\n    return mdl.eval()\n\nBB = 'convnextv2_tiny'\nfull_model = load_model(BB, FULL_PATH)\n\nassert isinstance(models[0], torch.nn.Module), \\\n    f'models[0] is {type(models[0])}, not a model - it was overwritten; reload it first'\ncrop_model = models[0].eval()          # ConvNeXt-V2 trained on GT-mask crops\n\ndef target_layer(model, timm_name):\n    \"\"\"Last feature stage of each backbone.\"\"\"\n    if 'convnext' in timm_name:     return model.stages[-1]      # B,C,H,W\n    if 'swin' in timm_name:         return model.layers[-1]      # B,H,W,C (auto-handled)\n    if 'resnet' in timm_name:       return model.layer4[-1]\n    if 'efficientnet' in timm_name: return model.conv_head\n    raise ValueError(f'No target layer defined for {timm_name}')\n\nclass GradCAM:\n    def __init__(self, model, layer):\n        self.model, self.act, self.grad = model.eval(), None, None\n        self.h = layer.register_forward_hook(self._fwd)\n\n    def _fwd(self, mod, inp, out):\n        self.act = out\n        if out.requires_grad:\n            out.register_hook(lambda g: setattr(self, 'grad', g))\n\n    def remove(self):\n        self.h.remove()\n\n    def __call__(self, x, target=None):\n        \"\"\"x: (B,3,H,W) normalised tensor. target=None explains the predicted class.\n        Returns cams (B,CROP,CROP) in [0,1], explained classes, softmax probs.\"\"\"\n        x = x.to(device).requires_grad_(True)\n        self.model.zero_grad(set_to_none=True)\n        logits = self.model(x)\n        probs = logits.softmax(1).detach().cpu().numpy()\n        cls = (logits.argmax(1) if target is None\n               else torch.full((len(x),), int(target), device=device))\n        logits.gather(1, cls[:, None]).sum().backward()\n        a, g = self.act.detach(), self.grad.detach()\n        nf = self.model.num_features\n        if a.shape[1] != nf and a.shape[-1] == nf:     # channels-last (Swin)\n            a, g = a.permute(0, 3, 1, 2), g.permute(0, 3, 1, 2)\n        w = g.mean((2, 3), keepdim=True)\n        cam = F.relu((w * a).sum(1, keepdim=True))\n        cam = F.interpolate(cam, size=(CROP, CROP), mode='bilinear', align_corners=False)[:, 0]\n        cam = cam / (cam.amax((1, 2), keepdim=True) + 1e-8)\n        return cam.cpu().numpy(), cls.cpu().numpy(), probs\n\n# %% 4. Ground-truth tumour masks for the test set (at classifier resolution)\ndef load_gt(files):\n    out = []\n    for f in tqdm(files, desc='GT masks'):\n        _, gt, _ = mat_to_bgr(f)\n        out.append(cv2.resize(gt, (CROP, CROP), interpolation=cv2.INTER_NEAREST) > 0.5)\n    return out\n\ntest_gts = load_gt(test_mri_files)\nassert len(test_gts) == len(full_test), 'file/item mismatch: a file was skipped'\ntest_labels = np.array([l for _, l in full_test])\n\n# %% 5. Quantitative attention score: how much Grad-CAM falls inside the tumour?\n# inside   = share of total Grad-CAM energy that lies inside the GT tumour mask\n# area     = share of the image covered by the tumour (the chance level)\n# enrich   = inside / area  (above 1 means attention is concentrated on the tumour)\n# pointing = does the single hottest pixel fall inside the tumour?\ndef cam_scores(cam, gt):\n    area = float(gt.mean())\n    inside = float(cam[gt].sum() / (cam.sum() + 1e-8))\n    pt = bool(gt[np.unravel_index(cam.argmax(), cam.shape)])\n    return inside, area, pt\n\ndef eval_cam(model, timm_name, items, gts, bs=32):\n    cg = GradCAM(model, target_layer(model, timm_name))\n    rows, preds = [], []\n    for s in tqdm(range(0, len(items), bs), desc='Grad-CAM'):\n        batch = items[s:s + bs]\n        x = torch.stack([tf_eval(c) for c, _ in batch])\n        cams, cls, _ = cg(x)\n        for j, (_, l) in enumerate(batch):\n            i = s + j\n            preds.append(int(cls[j]))\n            gt = gts[i]\n            if l > 0 and gt.any():\n                ins, area, pt = cam_scores(cams[j], gt)\n                rows.append(dict(idx=i, cls=int(l), correct=int(cls[j] == l),\n                                 inside=ins, area=area, enrich=ins / max(area, 1e-8),\n                                 pointing=int(pt)))\n    cg.remove()\n    return pd.DataFrame(rows), np.array(preds)\n\ndef summarize(df, name):\n    g = df.groupby('cls').agg(n=('idx', 'count'), inside=('inside', 'mean'),\n                              area=('area', 'mean'), enrich=('enrich', 'median'),\n                              pointing=('pointing', 'mean'))\n    g.index = [MRI_CLASS_NAMES[i] for i in g.index]\n    g.loc['All tumours'] = [len(df), df.inside.mean(), df.area.mean(),\n                            df.enrich.median(), df.pointing.mean()]\n    g.insert(0, 'model', name)\n    return g.round(3)\n\ndf_full, preds_full = eval_cam(full_model, BB, full_test, test_gts)\ntab_full = summarize(df_full, 'Full image')\nprint(tab_full)\nprint('Full-image test accuracy:', round(float((preds_full == test_labels).mean()), 4))\n\n# Correct vs wrong predictions: does the model look elsewhere when it fails?\nprint(df_full.groupby('correct')[['inside', 'enrich', 'pointing']].mean().round(3))\n\n# %% 6. Save scores (reuse eval_cam/summarize for another model to compare)\n# Example (once you have a new model and its test items):\n#   df_new, _ = eval_cam(new_model, 'convnextv2_tiny', new_test_items, test_gts)\n#   tab_full = pd.concat([tab_full, summarize(df_new, 'Fusion')])\ntab_full.to_csv('gradcam_attention_scores.csv')\n\n# %% 7. Visualisation helpers\ndef overlay(crop_bgr, cam, gt=None):\n    rgb = cv2.cvtColor(crop_bgr, cv2.COLOR_BGR2RGB)\n    heat = cv2.cvtColor(cv2.applyColorMap((cam * 255).astype(np.uint8), cv2.COLORMAP_JET),\n                        cv2.COLOR_BGR2RGB)\n    out = (0.55 * rgb + 0.45 * heat).astype(np.uint8)\n    if gt is not None and gt.any():\n        cnts, _ = cv2.findContours(gt.astype(np.uint8), cv2.RETR_EXTERNAL,\n                                   cv2.CHAIN_APPROX_SIMPLE)\n        cv2.drawContours(out, cnts, -1, (255, 255, 255), 1)    # white = GT tumour outline\n    return out\n\ndef show_cases(model, timm_name, items, idxs, gts=None, title='', fname=None, ncols=4):\n    if len(idxs) == 0:\n        print('No cases to show.'); return\n    cg = GradCAM(model, target_layer(model, timm_name))\n    x = torch.stack([tf_eval(items[i][0]) for i in idxs])\n    cams, cls, probs = cg(x)\n    cg.remove()\n    nrows = int(np.ceil(len(idxs) / ncols))\n    fig_h = 4.6                      # height per row (inches)\n    top_gap = 0.6                    # inches reserved above the grid for the main title\n    fig, axes = plt.subplots(nrows, ncols, figsize=(4 * ncols, fig_h * nrows + top_gap))\n    for ax in np.atleast_1d(axes).flat:\n        ax.axis('off')\n    for k, i in enumerate(idxs):\n        ax = np.atleast_1d(axes).flat[k]\n        gt = gts[i] if gts is not None else None\n        ax.imshow(overlay(items[i][0], cams[k], gt))\n        true, pred = MRI_CLASS_NAMES[items[i][1]], MRI_CLASS_NAMES[cls[k]]\n        ax.set_title(f'True: {true}\\nPred: {pred} ({probs[k][cls[k]]:.2f})', fontsize=10,\n                     pad=8, color='#2E7D32' if true == pred else '#C62828')\n    total_h = fig_h * nrows + top_gap\n    fig.suptitle(title, fontsize=13, fontweight='bold', y=0.995)\n    fig.tight_layout(rect=[0, 0, 1, 1 - top_gap / total_h])\n    if fname:\n        plt.savefig(fname, dpi=150, bbox_inches='tight')\n    plt.show()\n\n# %% 8. Pre-selected examples (fixed random seed, so the choice is not cherry-picked)\nrng = np.random.RandomState(0)\n\ndef pick(preds, labels, per=2):\n    sel = []\n    for c in range(NUM_CLS):\n        ok  = [i for i in range(len(labels)) if labels[i] == c and preds[i] == c]\n        bad = [i for i in range(len(labels)) if labels[i] == c and preds[i] != c]\n        for pool in (ok, bad):\n            if pool:\n                sel += rng.choice(pool, min(per, len(pool)), replace=False).tolist()\n    return sel\n\nsel = pick(preds_full, test_labels)\nshow_cases(full_model, BB, full_test, sel, gts=test_gts,\n           title='Grad-CAM, full-image ConvNeXt-V2 (white outline = GT tumour)',\n           fname='gradcam_full_image.png')\n\n# %% 9. Failure analysis: glioma predicted as No Tumor by the real pipeline\n# Uses the crop-trained model on the YOLO-mask inputs (what the pipeline sees).\n# No GT overlay here: when YOLO finds a mask the input is a crop, so the outline\n# would not line up with the image.\nnames = [str(n).lower() for n in MRI_CLASS_NAMES]\nGLIOMA = next(i for i, n in enumerate(names) if 'glioma' in n)\nNOTUM  = next(i for i, n in enumerate(names) if 'no' in n and 'tumor' in n.replace('tumour', 'tumor'))\n\ny_pipe, p_pipe, _ = predict(crop_model, test_items_pred)\nfail = np.where((y_pipe == GLIOMA) & (p_pipe == NOTUM))[0]\nprint(f'Glioma -> No Tumor failures: {len(fail)}')\nshow_cases(crop_model, BB, test_items_pred, fail[:8].tolist(),\n           title='Pipeline failures: glioma predicted as No Tumor',\n           fname='gradcam_glioma_failures.png')\n\n# %% 10. Shortcut check for the oracle model (No Tumor vs tumour crops)\n# If heatmaps for No Tumor images sit on borders or background instead of brain\n# tissue, the model may be using \"uncropped\" as the cue for No Tumor.\ny_gt, p_gt, _ = predict(crop_model, test_items_gt)\nnt = np.where(y_gt == NOTUM)[0]\nshow_cases(crop_model, BB, test_items_gt,\n           rng.choice(nt, min(8, len(nt)), replace=False).tolist(),\n           title='Oracle crop model: No Tumor images',\n           fname='gradcam_notumor_shortcut.png')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-14T08:37:59.928476Z","iopub.execute_input":"2026-10-14T08:37:59.92932Z","iopub.status.idle":"2026-10-14T08:38:56.27307Z","shell.execute_reply.started":"2026-10-14T08:37:59.9