= torch.optim.lr_scheduler.CosineAnnealingLR(opt, T_max=epochs)\n","        for ep in range(epochs):\n","            model.train()\n","            for x, y in tl:\n","                x, y = x.to(device), y.to(device)\n","                opt.zero_grad()\n","                with torch.autocast(device_type='cuda', enabled=(device == 'cuda')):\n","                    loss = crit(model(x), y)\n","                scaler.scale(loss).backward(); scaler.step(opt); scaler.update()\n","            sched.step()\n","            f1 = val_f1(model, val_items)\n","            if f1 > best:\n","                best = f1\n","                best_state = {k: v.detach().clone() for k, v in model.state_dict().items()}\n","            print(f'{BACKBONE} | seed {seed} | {phase} ep {ep+1:02d} | '\n","                  f'val macro-F1 {f1:.4f} (best {best:.4f})')\n","    model.load_state_dict(best_state)\n","    return model\n","\n","# %% 9. Run the comparison\n","BACKBONES = {\n","    'ConvNeXt-V2 Tiny'   : 'convnextv2_tiny',\n","    'Swin-T'             : 'swin_tiny_patch4_window7_224',\n","    'EfficientNetV2-S'   : 'tf_efficientnetv2_s',\n","    'ResNet50'           : 'resnet50',\n","}\n","CMP_SEEDS = [42]            # 1 seed to save time; use SEEDS for all three\n","\n","cmp_rows = []\n","for label, timm_name in BACKBONES.items():\n","    BACKBONE = timm_name                     # build_model reads this global\n","    for s in CMP_SEEDS:\n","        t0 = time.time()\n","        m = train_one(s)\n","        n_params = sum(p.numel() for p in m.parameters()) / 1e6\n","        for items, setting in [(test_items_gt,   'GT-mask crop (oracle)'),\n","                               (test_items_pred, 'YOLO-mask crop (pipeline)')]:\n","            r, _ = evaluate(m, items, setting)\n","            r.update(model=label, seed=s, params_M=round(n_params, 1),\n","                     minutes=round((time.time() - t0) / 60, 1))\n","            cmp_rows.append(r)\n","        torch.save(m.state_dict(), f'best_{timm_name}_seed{s}.pt')\n","        del m; gc.collect(); torch.cuda.empty_cache()\n","\n","cmp = pd.DataFrame(cmp_rows)\n","table = (cmp.groupby(['model', 'setting'])[['acc', 'f1', 'recall', 'auc', 'params_M', 'minutes']]\n","            .mean().round(4))\n","print(table)\n","table.to_csv('classifier_comparison.csv')"]},{"cell_type":"code","execution_count":27,"id":"d33851fd","metadata":{"execution":{"iopub.execute_input":"2026-10-14T11:43:22.843476Z","iopub.status.busy":"2026-10-14T11:43:22.843188Z","iopub.status.idle":"2026-10-14T11:44:07.590144Z","shell.execute_reply":"2026-10-14T11:44:07.589264Z"},"papermill":{"duration":45.178346,"end_time":"2026-10-14T11:44:07.591797+00:00","exception":false,"start_time":"2026-10-14T11:43:22.413451+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Collected predictions for 8 model/setting pairs\n"]},{"data":{"image/png":"\n","text/plain":["<Figure size 1840x880 with 8 Axes>"]},"metadata":{},"output_type":"display_data"},{"name":"stdout","output_type":"stream","text":["                                            accuracy  precision  recall  \\\n","model            setting                                                  \n","ConvNeXt-V2 Tiny GT-mask crop (oracle)         0.960     0.9664  0.9651   \n","                 YOLO-mask crop (pipeline)     0.934     0.9251  0.9399   \n","Swin-T           GT-mask crop (oracle)         0.960     0.9651  0.9647   \n","                 YOLO-mask crop (pipeline)     0.937     0.9274  0.9423   \n","EfficientNetV2-S GT-mask crop (oracle)         0.920     0.9311  0.9306   \n","                 YOLO-mask crop (pipeline)     0.895     0.8881  0.9073   \n","ResNet50         GT-mask crop (oracle)         0.922     0.9312  0.9315   \n","                 YOLO-mask crop (pipeline)     0.894     0.8895  0.9057   \n","\n","                                                f1     auc  \n","model            setting                                    