f=0.25, iou=0.45):\n","    \"\"\"\n","    Run YOLOv11n-seg on one image.\n","    Returns:\n","        pred_class    : int  (0-3 MRI class, or 4 for Non-MRI)\n","        max_conf      : float\n","        seg_mask      : np.ndarray (H, W) binary, or None\n","        raw_result    : ultralytics Result object\n","    \"\"\"\n","    results = model.predict(\n","        source     = img_path_or_np,\n","        conf       = conf,\n","        iou        = iou,\n","        imgsz      = IMG_SIZE,\n","        verbose    = False,\n","        save       = False,\n","    )\n","    r = results[0]\n","\n","    # No detection at all → No Tumor (class 0)\n","    if r.boxes is None or len(r.boxes) == 0:\n","        return 0, 0.0, None, r\n","\n","    # Pick highest-confidence detection\n","    confs   = r.boxes.conf.cpu().numpy()\n","    classes = r.boxes.cls.cpu().numpy().astype(int)\n","    best_i  = int(np.argmax(confs))\n","    best_cls = classes[best_i]      # 0=Meningioma, 1=Glioma, 2=Pituitary\n","    best_conf = float(confs[best_i])\n","\n","    # Remap YOLO class → mat label\n","    # YOLO: 0→Meningioma(1), 1→Glioma(2), 2→Pituitary(3)\n","    pred_mat_class = best_cls + 1  # 1, 2, or 3\n","\n","    # Extract mask for best detection\n","    seg_mask = None\n","    if r.masks is not None:\n","        masks_np = r.masks.data.cpu().numpy()   # (N, H, W) binary\n","        seg_mask = masks_np[best_i]             # (H, W)\n","\n","    return pred_mat_class, best_conf, seg_mask, r\n","\n","\n","print('predict_single() helper defined.')"]},{"cell_type":"markdown","id":"f38c5bbe","metadata":{"papermill":{"duration":0.376738,"end_time":"2026-10-14T10:37:12.127053+00:00","exception":false,"start_time":"2026-10-14T10:37:11.750315+00:00","status":"completed"},"tags":[]},"source":["## 11. Helper — Gate Function\n","\n","Since YOLO only knows the 4 MRI classes, we need a lightweight **Non-MRI gate**:  \n","if YOLO's maximum detection confidence across all predictions is below `GATE_CONF_THRESH`, we label the image as Non-MRI.\n","\n","This works because real MRI tumour scans produce confident detections, while random/non-MRI images produce only low-confidence noise."]},{"cell_type":"markdown","id":"e2154533","metadata":{"papermill":{"duration":0.458682,"end_time":"2026-10-14T10:37:12.960022+00:00","exception":false,"start_time":"2026-10-14T10:37:12.50134+00:00","status":"completed"},"tags":[]},"source":["## 12. Test Set Inference\n","\n","Full gated pipeline on the locked test set:\n","\n","1. Load image from `.mat`  \n","2. Run YOLOv11n-seg  \n","3. Gate: low confidence → Non-MRI  \n","4. Collect predictions, segmentation masks, and ground truth for metrics"]},{"cell_type":"code","execution_count":17,"id":"3fb86916","metadata":{"execution":{"iopub.execute_input":"2026-10-14T10:37:13.719517Z","iopub.status.busy":"2026-10-14T10:37:13.718556Z","iopub.status.idle":"2026-10-14T10:37:38.565259Z","shell.execute_reply":"2026-10-14T10:37:38.564395Z"},"papermill":{"duration":25.230337,"end_time":"2026-10-14T10:37:38.566888+00:00","exception":false,"start_time":"2026-10-14T10:37:13.336551+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["Running inference on test set...\n","  MRI samples  : 1000\n","  NonMRI samples: 306\n"]},{"name":"stderr","output_type":"stream","text":["100%|██████████| 1000/1000 [00:19<00:00, 50.35it/s]\n","NonMRI: 100%|██████████| 306/306 [00:04<00:00, 61.59it/s]"]},{"name":"stdout","output_type":"stream","text":["\n","Inference complete on 1306 test images.\n"]},{"name":"stderr","output_type":"stream","text":["\n"]}],"source":["# ── Helper to prep image for inference ──\n","def mat_to_bgr(mat_path, size=640):\n","    img, mask, lbl = load_mat(mat_path)\n","    img_rs   = cv2.resize(img,  (size, size), interpolation=cv2.INTER_LINEAR)\n","    mask_rs  = cv2.resize(mask, (size, size), interpolation=cv2.INTER_NEAREST)\n","    img_norm = (img_rs - img_rs.min()) / (img_rs.max() - img_rs.min() + 1e-8)\n","    img_u8   = (img_norm * 255).astype(np.uint8)\n","    img_bgr  = cv2.cvtColor(img_u8, cv2.COLOR_GRAY2BGR)\n","    return img_bgr, (mask_rs > 0).astype(np.float32), lbl\n","\n","def compute_seg_metrics(pred_mask, gt_mask):\n","    \"\"\"Compute Dice, IoU, sensitivity, specificity on binary masks.\"\"\"\n","    p = (pred_mask > 0.5).astype(np.float32).flatten()\n","    t = (gt_mask   > 0.5).astype(np.float32).flatten()\n","    inter = (p * t).sum()\n","    TP = inter\n","    FP = p.sum() - TP\n","    FN = t.sum() - TP\n","    TN = len(p) - TP - FP - FN\n","    dice = (2*TP + 1e-6) / (p.sum() + t.sum() + 1e-6)\n","    iou  = (TP + 1e-6) / (TP + FP + FN + 1e-6)\n","    sens = (TP + 1e-6) / (TP + FN + 1e-6)\n","    spec = (TN + 1e-6) / (TN + FP + 1e-6)\n","    prec = (TP + 1e-6) / (TP + FP + 1e-6)\n","    return dict(dice=dice, iou=iou, sensitivity=sens, specificity=spec, precision=prec)\n","\n","# ── Full test inference ──\n","print('Running inference on test set...')\n","print(f'  MRI samples  : {len(test_mri_files)}')\n","print(f'  NonMRI samples: {len(test_nonmri_files)}')\n","\n","all_true, all_pred   = [], []\n","mri_true, mri_pred   = [], []\n","seg_metrics_list     = []\n","conf_list            = []\n","viz_samples          = {}\n","\n","# ── MRI test samples ──\n","for mat_path, true_lbl in tqdm(zip(test_mri_files, test_mri_labels), total=len(test_mri_files)):\n","    try:\n","        img_bgr, gt_mask, _ = mat_to_bgr(mat_path)\n","    except:\n","        continue\n","\n","    pred_cls, max_conf, seg_mask, raw_r = predict_single(model_best, img_bgr)\n","    conf_list.append(max_conf)\n","\n","    all_true.append(true_lbl)\n","    all_pred.append(pred_cls)\n","    mri_true.append(true_lbl)\n","    mri_pred.append(pred_cls)\n","\n","    # Resize predicted mask to match GT size\n","    if seg_mask is not None:\n","        seg_resized = cv2.resize(seg_mask.astype(np.float32),\n","                                 (IMG_SIZE, IMG_SIZE),\n","                                 interpolation=cv2.INTER_NEAREST)\n","    else:\n","        seg_resized = np.zeros((IMG_SIZE, IMG_SIZE), dtype=np.float32)\n","\n","    m = compute_seg_metrics(seg_resized, gt_mask)\n","    m['true_class'] = true_lbl\n","    seg_metrics_list.append(m)\n","\n","    # Store one sample per class for visualization\n","    if true_lbl not in viz_samples:\n","        viz_samples[true_lbl] = {\n","            'img'     : img_bgr,\n","            'gt_mask' : gt_mask,\n","            'pred_mask': seg_resized,\n","            'pred_cls': pred_cls,\n","            'conf'    : max_conf,\n","        }\n","\n","# ── NonMRI test samples ──\n","for mat_path in tqdm(test_nonmri_files, desc='NonMRI'):\n","    try:\n","        img_bgr, _, _ = mat_to_bgr(mat_path)\n","    except:\n","        continue\n","    _, max_conf, _, _ = predict_single(model_best, img_bgr)\n","    # Gate: low confidence → Non-MRI\n","    pred_cls = NON_MRI_LABEL if max_conf < GATE_CONF_THRESH else 0\n","    all_true.append(NON_MRI_LABEL)\n","    all_pred.append(pred_cls)\n","\n","print(f'\\nInference complete on {len(all_true)} test images.')"]},{"cell_type":"markdown","id":"722fcd97","metadata":{"papermill":{"duration":0.485561,"end_time":"2026-10-14T10:37:39.473523+00:00","exception":false,"start_time":"2026-10-14T10:37:38.987962+00:00","status":"completed"},"tags":[]},"source":["## 13. Classification Metrics"]},{"cell_type":"code","execution_count":18,"id":"8fe30326","metadata":{"execution":{"iopub.execute_input":"2026-10-14T10:37:40.298301Z","iopub.status.busy":"2026-10-14T10:37:40.297975Z","iopub.status.idle":"2026-10-14T10:37:40.339675Z","shell.execute_reply":"2026-10-14T10:37:40.338888Z"},"papermill":{"duration":0.443575,"end_time":"2026-10-14T10:37:40.341394+00:00","exception":false,"start_time":"2026-10-14T10:37:39.897819+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["=================================================================\n","  FINAL TEST RESULTS — YOLOv11n-seg on BriscMat\n","=================================================================\n","\n","  GATE (MRI vs NonMRI):\n","    Accuracy : 0.9449\n","    F1       : 0.9653\n","\n","  OVERALL (5-class gated pipeline):\n","    Accuracy : 0.9043\n","    F1 Macro : 0.8912\n","\n","  MRI CLASSIFICATION (4-class):\n","    Accuracy  : 0.9470\n","    F1 Macro  : 0.9404\n","    Precision : 0.9374\n","    Recall    : 0.9500\n","    Kappa     : 0.9279\n","    MCC       : 0.9293\n","=================================================================\n","\n","  Per-class report (MRI 4-class):\n","              precision    recall  f1-score   support\n","\n","    No Tumor       0.83      1.00      0.91       140\n","  Meningioma       0.94      0.98      0.96       306\n","      Glioma       0.99      0.85      0.91       254\n","   Pituitary       0.99      0.97      0.98       300\n","\n","    accuracy                           0.95      1000\n","   macro avg       0.94      0.95      0.94      1000\n","weighted avg       0.95      0.95      0.95      1000\n","\n"]}],"source":["# ── Gate (MRI vs NonMRI) ──\n","gate_true = [1 if l < NON_MRI_LABEL else 0 for l in all_true]\n","gate_pred = [1 if p < NON_MRI_LABEL else 0 for p in all_pred]\n","gate_acc  = accuracy_score(gate_true, gate_pred)\n","gate_f1   = f1_score(gate_true, gate_pred, zero_division=0)\n","\n","# ── 4-class MRI ──\n","acc_4  = accuracy_score(mri_true, mri_pred)\n","f1_4   = f1_score(mri_true, mri_pred, average='macro', zero_division=0)\n","prec_4 = precision_score(mri_true, mri_pred, average='macro', zero_division=0)\n","rec_4  = recall_score(mri_true, mri_pred, average='macro', zero_division=0)\n","kappa  = cohen_kappa_score(mri_true, mri_pred)\n","mcc    = matthews_corrcoef(mri_true, mri_pred)\n","\n","# ── 5-class overall ──\n","oa5 = accuracy_score(all_true, all_pred)\n","of5 = f1_score(all_true, all_pred, average='macro',\n","               labels=list(range(5)), zero_division=0)\n","\n","print('='*65)\n","print('  FINAL TEST RESULTS — YOLOv11n-seg on BriscMat')\n","print('='*65)\n","print(f'\\n  GATE (MRI vs NonMRI):')\n","print(f'    Accuracy : {gate_acc:.4f}')\n","print(f'    F1       : {gate_f1:.4f}')\n","print(f'\\n  OVERALL (5-class gated pipeline):')\n","print(f'    Accuracy : {oa5:.4f}')\n","print(f'    F1 Macro : {of5:.4f}')\n","print(f'\\n  MRI CLASSIFICATION (4-class):')\n","print(f'    Accuracy  : {acc_4:.4f}')\n","print(f'    F1 Macro  : {f1_4:.4f}')\n","print(f'    Precision : {prec_4:.4f}')\n","print(f'    Recall    : {rec_4:.4f}')\n","print(f'    Kappa     : {kappa:.4f}')\n","print(f'    MCC       : {mcc:.4f}')\n","print('='*65)\n","\n","print('\\n  Per-class report (MRI 4-class):')\n","# Remap: mri_pred uses labels 0,1,2,3\n","print(classification_report(mri_true, mri_pred,\n","                             target_names=MRI_CLASS_NAMES,\n","                             labels=[0,1,2,3],\n","                             zero_division=0))"]},{"cell_type":"markdown","id":"ad456c8c","metadata":{"papermill":{"duration":0.385297,"end_time":"2026-10-14T10:37:41.136022+00:00","exception":false,"start_time":"2026-10-14T10:37:40.750725+00:00","status":"completed"},"tags":[]},"source":["## 14. Confusion Matrices"]},{"cell_type":"code","execution_count":19,"id":"4202c025","metadata":{"execution":{"iopub.execute_input":"2026-10-14T10:37:42.004067Z","iopub.status.busy":"2026-10-14T10:37:42.003172Z","iopub.status.idle":"2026-10-14T10:37:42.361286Z","shell.execute_reply":"2026-10-14T10:37:42.360557Z"},"papermill":{"duration":0.752872,"end_time":"2026-10-14T10:37:42.363075+00:00","exception":false,"start_time":"2026-10-14T10:37:41.610203+00:00","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"\n","text/plain":["<Figure size 1600x600 with 4 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["fig, axes = plt.subplots(1, 2, figsize=(16, 6))\n","\n","# Gate\n","cm_gate = confusion_matrix(gate_true, gate_pred)\n",