(device == 'cuda'))\n    best, best_state = -1, None\n    tl = loader(train_items, True)\n\n    for phase, epochs, lr in [('head', EP_HEAD, 1e-3), ('full', EP_FT, 1e-4)]:\n        for p in model.parameters():\n            p.requires_grad = (phase == 'full')\n        for p in model.get_classifier().parameters():\n            p.requires_grad = True\n        opt = torch.optim.AdamW([p for p in model.parameters() if p.requires_grad],\n                                lr=lr, weight_decay=0.05)\n        sched = torch.optim.lr_scheduler.CosineAnnealingLR(opt, T_max=epochs)\n        for ep in range(epochs):\n            model.train()\n            for x, y in tl:\n                x, y = x.to(device), y.to(device)\n                opt.zero_grad()\n                with torch.autocast(device_type='cuda', enabled=(device == 'cuda')):\n                    loss = crit(model(x), y)\n                scaler.scale(loss).backward(); scaler.step(opt); scaler.update()\n            sched.step()\n            f1 = val_f1(model, val_items)\n            if f1 > best:\n                best = f1\n                best_state = {k: v.detach().clone() for k, v in model.state_dict().items()}\n            print(f'{BACKBONE} | seed {seed} | {phase} ep {ep+1:02d} | '\n                  f'val macro-F1 {f1:.4f} (best {best:.4f})')\n    model.load_state_dict(best_state)\n    return model\n\n# %% 9. Run the comparison\nBACKBONES = {\n    'ConvNeXt-V2 Tiny'   : 'convnextv2_tiny',\n    'Swin-T'             : 'swin_tiny_patch4_window7_224',\n    'EfficientNetV2-S'   : 'tf_efficientnetv2_s',\n    'ResNet50'           : 'resnet50',\n}\nCMP_SEEDS = [42]            # 1 seed to save time; use SEEDS for all three\n\ncmp_rows = []\nfor label, timm_name in BACKBONES.items():\n    BACKBONE = timm_name                     # build_model reads this global\n    for s in CMP_SEEDS:\n        t0 = time.time()\n        m = train_one(s)\n        n_params = sum(p.numel() for p in m.parameters()) / 1e6\n        for items, setting