c_auc_score, confusion_matrix)\n\n# %% 2. Did YOLO find a mask? (same files, same order as test_items_pred / full_test)\nhas_mask, yolo_cls = [], []\nfor f in tqdm(test_mri_files, desc='YOLO masks'):\n    img_bgr, _, _ = mat_to_bgr(f)\n    pc, _, pm, _ = predict_single(model_best, img_bgr)\n    has_mask.append(pm is not None)\n    yolo_cls.append(pc)                       # 0 = no detection, 1-3 = tumour class\nhas_mask, yolo_cls = np.array(has_mask), np.array(yolo_cls)\n\nassert len(has_mask) == len(test_items_pred) == len(full_test), 'order mismatch'\ny = np.array([l for _, l in full_test])\n\nprint(f'YOLO found a mask in {has_mask.mean():.1%} of test images')\nct = pd.crosstab(pd.Series(y, name='true').map(dict(enumerate(MRI_CLASS_NAMES))),\n                 pd.Series(has_mask, name='mask found'))\nprint(ct)\n\n# %% 3. Class probabilities from both classifiers (same test images)\n_, _, P_crop = predict(crop_model, test_items_pred)   # input = YOLO crop, or full image if no mask\n_, _, P_full = predict(full_model, full_test)         # input = full image\n\n# %% 4. The systems to compare\nH = has_mask[:, None]\nsystems = {\n    'Crop only (current pipeline)'            : P_crop,\n    'Full image only'                         : P_full,\n    'Routed: mask -> crop, no mask -> full'   : np.where(H, P_crop, P_full),\n    'Routed + average when a mask is found'   : np.where(H, (P_crop + P_full) / 2, P_full),\n}\n\ndef metrics(y, P):\n    p = P.argmax(1)\n    pc = f1_score(y, p, average=None, labels=list(range(len(MRI_CLASS_NAMES))), zero_division=0)\n    row = dict(acc=accuracy_score(y, p),\n               f1=f1_score(y, p, average='macro', zero_division=0),\n               recall=recall_score(y, p, average='macro', zero_division=0),\n               auc=roc_auc_score(y, P, multi_class='ovr'),\n               glioma_as_NoTumor=int(((y == 2) & (p == 0)).sum()))\n    row.update({f'F1 {n}': v for n, v in zip(MRI_CLASS_NAMES, pc)})\n    return row\n\ntab = pd.DataFrame({k: metrics(y, P) for k, P in systems.items()}).T\nprint(tab.round(4).to_string())\ntab.round(4).to_csv('routing_results.csv')\n\n# %% 5. Is the difference real? McNemar test and bootstrap CI on macro-F1\ndef mcnemar(y, pa, pb):\n    a_ok, b_ok = pa == y, pb == y\n    only_a = int((a_ok & ~b_ok).sum())        # A right, B wrong\n    only_b = int((~a_ok & b_ok).sum())        # B right, A wrong\n    n = only_a + only_b\n    return only_a, only_b, (binomtest(only_a, n, 0.5).pvalue if n else 1.0)\n\ndef boot_f1_diff(y, pa, pb, n=1000, seed=0):\n    rng = np.random.RandomState(seed)\n    d = []\n    for _ in range(n):\n        i = rng.randint(0, len(y), len(y))\n        d.append(f1_score(y[i], pb[i], average='macro', zero_division=0)\n                 - f1_score(y[i], pa[i], average='macro', zero_division=0))\n    return np.percentile(d, [2.5, 97.5])\n\nnames = list(systems)\npred = {k: P.argmax(1) for k, P in systems.items()}\npairs = [(names[0], names[2]),     # current pipeline vs routed\n         (names[2], names[1]),     # routed vs full image only\n         (names[0], names[1])]     # current pipeline vs full image only\nfor a, b in pairs:\n    oa, ob, pv = mcnemar(y, pred[a], pred[b])\n    lo, hi = boot_f1_diff(y, pred[a], pred[b])\n    print(f'{a}  ->  {b}\\n   only-A-right {oa}, only-B-right {ob}, McNemar p = {pv:.4f}, '\n          f'macro-F1 change 95% CI [{lo:+.3f}, {hi:+.3f}]\\n')\n\n# %% 6. Confusion matrix of the routed system\nPr = pred[names[2]]\ncm = confusion_matrix(y, Pr, labels=list(range(len(MRI_CLASS_NAMES))))\nprint(pd.DataFrame(cm, index=[f'true {n}' for n in MRI_CLASS_NAMES],\n                   columns=[f'pred {n}' for n in MRI_CLASS_NAMES]))\n\n# Accuracy split by whether YOLO found a mask: where does each classifier win?\nfor name, P in systems.items():\n    p = P.argmax(1)\n    print(f'{name:42s}  mask found: {np.mean(p[has_mask] == y[has_mask]):.3f}'\n          f'   no mask: {np.mean(p[~has_mask] == y[~has_mask]):.3f}')\n\n# %% 7. Optional: report the YOLO-only classifier next to these (no probabilities, so no AUC)\np_yolo = yolo_cls\nprint(f'YOLO top-box class: acc {accuracy_score(y, p_yolo):.4f}, '\n      f'macro-F1 {f1_score(y, p_yolo, average=\"macro\", zero_division=0):.4f}')","metadata":{"trusted":true},"outputs":[{"name":"stderr","text":"YOLO masks: 100%|██████████| 1000/1000 [00:18<00:00, 55.31it/s]","output_type":"stream"},{"name":"stdout","text":"YOLO found a mask in 82.7% of test images\nmask found  False  True \ntrue                    \nGlioma         24    230\nMeningioma      1    305\nNo Tumor      140      0\nPituitary       8    292\n","output_type":"stream"},{"name":"stderr","text":"\n","output_type":"stream"},{"name":"stdout","text":"                                         acc      f1  recall     auc  glioma_as_NoTumor  F1 No Tumor  F1 Meningioma  F1 Glioma  F1 Pituitary\nCrop only (current pipeline)           0.930  0.9252  0.9369  0.9813               24.0       0.8974         0.9496     0.9132        0.9406\nFull image only                        0.982  0.9829  0.9841  0.9993                0.0       0.9894         0.9738     0.9802        0.9884\nRouted: mask -> crop, no mask -> full  0.961  0.9663  0.9662  0.9945                0.0       1.0000         0.9496     0.9625        0.9532\nRouted + average when a mask is found  0.982  0.9842  0.9839  0.9988                0.0       1.0000         0.9772     0.9762        0.9834\nCrop only (current pipeline)  ->  Routed: mask -> crop, no mask -> full\n   only-A-right 0, only-B-right 31, McNemar p = 0.0000, macro-F1 change 95% CI [+0.028, +0.055]\n\nRouted: mask -> crop, no mask -> full  ->  Full image only\n   only-A-right 7, only-B-right 28, McNemar p = 0.0005, macro-F1 change 95% CI [+0.005, +0.027]\n\nCrop only (current pipeline)  ->  Full image only\n   only-A-right 7, only-B-right 59, McNemar p = 0.0000, macro-F1 change 95% CI [+0.041, +0.076]\n\n                 pred No Tumor  pred Meningioma  pred Glioma  pred Pituitary\ntrue No Tumor              140                0            0               0\ntrue Meningioma              0              292            7               7\ntrue Glioma                  0                4          244               6\ntrue Pituitary               0               13            2             285\nCrop only (current pipeline)                mask found: 0.954   no mask: 0.815\nFull image only                             mask found: 0.979   no mask: 0.994\nRouted: mask -> crop, no mask -> full       mask found: 0.954   no mask: 0.994\nRouted + average when a mask is found       mask found: 0.979   no mask: 0.994\nYOLO top-box class: acc 0.9400, macro-F1 0.9329\n","output_type":"stream"}],"execution_count":42},{"cell_type":"code","source":"# ============================================================\n# LIME + SHAP (with Grad-CAM comparison) - single cell\n# Run AFTER the Grad-CAM cells. Needs: full_model, full_train, full_test,\n# test_gts, test_labels, df_full, preds_full, GradCAM, target_layer,\n# cam_scores, overlay, pick, tf_eval, BB, NUM_CLS, MRI_CLASS_NAMES, device\n# ============================================================\nimport subprocess, sys, inspect\nsubprocess.run([sys.executable, '-m', 'pip', 'install', 'lime', 'shap', 'scikit-image', '-q'])\n\nimport numpy as np, cv2, torch, pandas as pd\nimport matplotlib.pyplot as plt\nfrom tqdm import tqdm\nfrom skimage.segmentation import slic\nfrom lime import lime_image\nimport shap\n\n# ---------------- Settings ----------------\nLIME_SAMPLES  = 1000     # perturbed images per explanation\nLIME_SEGMENTS = 60       # approx. number of superpixels\nLIME_COMPACT  = 0.1      # SLIC compactness (try 0.01-1)\nSHAP_BG       = 64       # background images for SHAP\nSHAP_NSAMPLES = 100      # expected-gradients samples per image\nSHAP_SIGMA    = 2        # Gaussian smoothing of SHAP map (0 = off)\nXAI_BATCH     = 64\nN_PER_CLASS   = 30       # tumour test images per class (use 3 for a quick test)\n\n# ---------------- LIME ----------------\nlime_explainer = lime_image.LimeImageExplainer(random_state=0)\n_lime_params = inspect.signature(lime_explainer.explain_instance).parameters\n_slic_params = inspect.signature(slic).parameters\n\ndef lime_segments(im):\n    kw = dict(n_segments=LIME_SEGMENTS, compactness=LIME_COMPACT)\n    if 'start_label' in _slic_params:\n        kw['start_label'] = 0\n    if 'channel_axis' in _slic_params:\n        kw['channel_axis'] = -1\n    elif 'multichannel' in _slic_params:\n        kw['multichannel'] = True\n    return slic(im, **kw)\n\ndef lime_predict_fn(model):\n    @torch.no_grad()\n    def fn(imgs):\n        out = []\n        for s in range(0, len(imgs), XAI_BATCH):\n            x = torch.stack([tf_eval(np.clip(im, 0, 255).astype(np.uint8))\n                             for im in imgs[s:s + XAI_BATCH]])\n            out.append(model(x.to(device)).softmax(1).cpu().numpy())\n        return np.concatenate(out)\n    return fn\n\ndef lime_map(model, crop):\n    kw = dict(top_labels=1, hide_color=0, num_samples=LIME_SAMPLES,\n              batch_size=XAI_BATCH, segmentation_fn=lime_segments)\n    if 'progress_bar' in _lime_params:        # only newer LIME versions have this\n        kw['progress_bar'] = False\n    exp = lime_explainer.explain_instance(crop, lime_predict_fn(model), **kw)\n    c = exp.top_labels[0]\n    w = np.zeros(exp.segments.max() + 1, np.float32)\n    for sid, wt in exp.local_exp[c]:\n        w[sid] = wt\n    m = np.maximum(w[exp.segments], 0)\n    return m / (m.max() + 1e-8), c\n\n# ---------------- SHAP ----------------\ndef make_shap_explainer(model, items, n=SHAP_BG, seed=0):\n    idx = np.random.RandomState(seed).choice(len(items), min(n, len(items)), replace=False)\n    bg = torch.stack([tf_eval(items[i][0]) for i in idx]).to(device)\n    return shap.GradientExplainer(model.eval(), bg)\n\ndef shap_maps(model, explainer, crops):\n    x = torch.stack([tf_eval(c) for c in crops]).to(device)\n    with torch.no_grad():\n        pred = model(x).argmax(1).cpu().numpy()\n    sv = explainer.shap_values(x, nsamples=SHAP_NSAMPLES, rseed=0)\n    maps = []\n    for j, c in enumerate(pred):\n        a = sv[c][j] if isinstance(sv, list) else sv[j, ..., c]   # old/new shap formats\n        m = np.asarray(a).sum(0).astype(np.float32)\n        if SHAP_SIGMA:\n            m = cv2.GaussianBlur(m, (0, 0), SHAP_SIGMA)\n        m = np.maximum(m, 0)\n        maps.append(m / (m.max() + 1e-8))\n    return np.stack(maps), pred\n\nshap_expl = make_shap_explainer(full_model, full_train)\n\n# ---------------- Quantitative comparison ----------------\nrng_x = np.random.RandomState(1)\nsub = []\nfor c in range(1, NUM_CLS):\n    pool = [i for i in range(len(test_labels)) if test_labels[i] == c and test_gts[i].any()]\n    sub += rng_x.choice(pool, min(N_PER_CLASS, len(pool)), replace=False).tolist()\nprint(f'{len(sub)} tumour test images')\n\ndef score_row(i, m, pred):\n    ins, area, pt = cam_scores(m, test_gts[i])\n    l = int(full_test[i][1])\n    return dict(idx=i, cls=l, correct=int(pred == l), inside=ins, area=area,\n                enrich=ins / max(area, 1e-8), pointing=int(pt))\n\nrows = []\nfor i in tqdm(sub, desc='LIME'):\n    m, c = lime_map(full_model, full_test[i][0])\n    rows.append(score_row(i, m, c))\ndf_lime = pd.DataFrame(rows)\n\nrows = []\nfor s in tqdm(range(0, len(sub), 8), desc='SHAP'):\n    ids = sub[s:s + 8]\n    maps, pred = shap_maps(full_model, shap_expl, [full_test[i][0] for i in ids])\n    for k, i in enumerate(ids):\n        rows.append(score_row(i, maps[k], pred[k]))\ndf_shap = pd.DataFrame(rows)\n\ndf_gc = df_full.set_index('idx').loc[sub].reset_index()\n\ndef summ(df, name):\n    return dict(method=name, n=len(df), inside=df.inside.mean(), area=df.area.mean(),\n                enrich_median=df.enrich.median(), pointing=df.pointing.mean())\n\nxai_tab = pd.DataFrame([summ(df_gc, 'Grad-CAM'), summ(df_lime, 'LIME'),\n                        summ(df_shap, 'SHAP')]).round(3)\nprint(xai_tab.to_string(index=False))\n\nper_class = {}\nfor name, df in [('Grad-CAM', df_gc), ('LIME', df_lime), ('SHAP', df_shap)]:\n    g = df.groupby('cls').agg({'inside': 'mean', 'enrich': 'median', 'pointing': 'mean'})\n    g.index = [MRI_CLASS_NAMES[i] for i in g.index]\n    per_class[name] = g\nper_class = pd.concat(per_class, axis=1).round(3)\nprint('\\n', per_class)\n\nfor name, df in [('Grad-CAM', df_gc), ('LIME', df_lime), ('SHAP', df_shap)]:\n    print(f'\\n{name}: correct vs wrong')\n    print(df.groupby('correct')[['inside', 'enrich', 'pointing']].mean().round(3))\n\nxai_tab.to_csv('xai_attention_scores.csv', index=False)\nper_class.to_csv('xai_attention_scores_per_class.csv')\n\n# ---------------- Side-by-side figure ----------------\ndef outline(crop_bgr, gt):\n    out = cv2.cvtColor(crop_bgr, cv2.COLOR_BGR2RGB).copy()\n    if gt is not None and gt.any():\n        cnts, _ = cv2.findContours(gt.astype(np.uint8), cv2.RETR_EXTERNAL,\n                                   cv2.CHAIN_APPROX_SIMPLE)\n        cv2.drawContours(out, cnts, -1, (255, 255, 255), 1)\n    return out\n\ndef show_xai(model, items, idxs, gts, title, fname):\n    crops = [items[i][0] for i in idxs]\n    cg = GradCAM(model, target_layer(model, BB))\n    cams, cls, probs = cg(torch.stack([tf_eval(c) for c in crops]))\n    cg.remove()\n    smaps, _ = shap_maps(model, shap_expl, crops)\n    lmaps = [lime_map(model, c)[0] for c in tqdm(crops, desc='LIME figure')]\n\n    cols = ['Input', 'Grad-CAM', 'LIME', 'SHAP']\n    row_h, top_gap = 3.6, 0.7          # row height and space above the grid (inches)\n    total_h = row_h * len(idxs) + top_gap\n    fig, axes = plt.subplots(len(idxs), 4, figsize=(14, total_h))\n    axes = np.atleast_2d(axes)\n    for k, i in enumerate(idxs):\n        gt = gts[i] if gts is not None else None\n        panels = [outline(crops[k], gt),\n                  overlay(crops[k], cams[k], gt),\n                  overlay(crops[k], lmaps[k], gt),\n                  overlay(crops[k], sm