ri}')\n","        print(f'  Prediction: {ALL_CLASS_NAMES[final_cls]}  (conf={max_conf:.3f})')\n","        if true_lbl is not None:\n","            correct = (final_cls == true_lbl)\n","            print(f'  True label: {ALL_CLASS_NAMES[true_lbl]}')\n","            print(f'  Correct   : {\"✓\" if correct else \"✗\"}')\n","\n","        # Quick plot\n","        img_gray = cv2.cvtColor(img_bgr, cv2.COLOR_BGR2GRAY) / 255.0\n","        n_panels = 3 if seg_mask is None else 4\n","        fig, axes = plt.subplots(1, n_panels, figsize=(5*n_panels, 4))\n","        axes[0].imshow(img_gray, cmap='gray')\n","        axes[0].set_title(f'Input\\nConf={max_conf:.3f}', fontweight='bold')\n","        if gt_mask is not None:\n","            axes[1].imshow(gt_mask, cmap='hot'); axes[1].set_title('GT Mask')\n","        else:\n","            axes[1].axis('off')\n","        if seg_mask is not None:\n","            seg_r = cv2.resize(seg_mask.astype(np.float32), (IMG_SIZE, IMG_SIZE))\n","            axes[2].imshow(seg_r, cmap='hot'); axes[2].set_title('Pred Mask')\n","            ov = np.stack([img_gray]*3, -1)\n","            ov[seg_r > 0.5] = [1.0, 0.2, 0.2]\n","            axes[3].imshow(ov)\n","            axes[3].set_title(f'Overlay\\n{ALL_CLASS_NAMES[final_cls]}')\n","        for ax in axes: ax.axis('off')\n","        plt.tight_layout(); plt.show()\n","\n","    return result\n","\n","\n","# ── Demo on first test file ──\n","if test_mri_files:\n","    print(f'Demo: {test_mri_files[0]}')\n","    r = predict_image_yolo(test_mri_files[0], verbose=True)"]},{"cell_type":"markdown","id":"0422ec8c","metadata":{"papermill":{"duration":0.409632,"end_time":"2026-10-14T10:38:13.592746+00:00","exception":false,"start_time":"2026-10-14T10:38:13.183114+00:00","status":"completed"},"tags":[]},"source":["## 19. Comprehensive Metrics Summary"]},{"cell_type":"code","execution_count":24,"id":"497905c5","metadata":{"execution":{"iopub.execute_input":"2026-10-14T10:38:14.449327Z","iopub.status.busy":"2026