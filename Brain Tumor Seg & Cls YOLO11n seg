mg_gray = cv2.cvtColor(img_bgr, cv2.COLOR_BGR2GRAY) / 255.0\n        n_panels = 3 if seg_mask is None else 4\n        fig, axes = plt.subplots(1, n_panels, figsize=(5*n_panels, 4))\n        axes[0].imshow(img_gray, cmap='gray')\n        axes[0].set_title(f'Input\\nConf={max_conf:.3f}', fontweight='bold')\n        if gt_mask is not None:\n            axes[1].imshow(gt_mask, cmap='hot'); axes[1].set_title('GT Mask')\n        else:\n            axes[1].axis('off')\n        if seg_mask is not None:\n            seg_r = cv2.resize(seg_mask.astype(np.float32), (IMG_SIZE, IMG_SIZE))\n            axes[2].imshow(seg_r, cmap='hot'); axes[2].set_title('Pred Mask')\n            ov = np.stack([img_gray]*3, -1)\n            ov[seg_r > 0.5] = [1.0, 0.2, 0.2]\n            axes[3].imshow(ov)\n            axes[3].set_title(f'Overlay\\n{ALL_CLASS_NAMES[final_cls]}')\n        for ax in axes: ax.axis('off')\n        plt.tight_layout(); plt.show()\n\n    return result\n\n\n# ── Demo on first test file ──\nif test_mri_files:\n    print(f'Demo: {test_mri_files[0]}')\n    r = predict_image_yolo(test_mri_files[0], verbose=True)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-14T05:27:07.056859Z","iopub.execute_input":"2026-10-14T05:27:07.057217Z","iopub.status.idle":"2026-10-14T05:27:07.576399Z","shell.execute_reply.started":"2026-10-14T05:27:07.057174Z","shell.execute_reply":"2026-10-14T05:27:07.575496Z"}},"outputs":[{"name":"stdout","text":"Demo: /kaggle/input/datasets/vivanrv/briscmat-brain-tumour-mri-dataset-2026/BriscMat/Test/test_1.mat\n  Is MRI    : True\n  Prediction: Glioma  (conf=0.809)\n  True label: Glioma\n  Correct   : ✓\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 2000x400 with 4 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":35},{"cell_type":"markdown","source":"## 19. Comprehensive Metrics Summary","metadata":{}},{"cell_type":"code","source":"print('='*70)\nprint('  FINAL SUMMARY — YOLOv11n-seg on BriscMat Test Set')\nprint('='*70)\n\nrows = [\n    ('MODEL', '', ''),\n    ('  Architecture',   'YOLOv11n-seg (pretrained)',     'Fine-tuned from COCO weights'),\n    ('  Parameters',     '~1.9M',                        'Nano variant, fastest/lightest'),\n    ('GATE (MRI vs NonMRI)', '', ''),\n    ('  Accuracy',       f'{gate_acc:.4f}',               ''),\n    ('  F1',             f'{gate_f1:.4f}',                ''),\n    ('5-CLASS OVERALL', '', ''),\n    ('  Accuracy',       f'{oa5:.4f}',                    ''),\n    ('  F1 Macro',       f'{of5:.4f}',                    ''),\n    ('4-CLASS MRI CLASSIFICATION', '', ''),\n    ('  Accuracy',       f'{acc_4:.4f}',                  ''),\n    ('  F1 Macro',       f'{f1_4:.4f}',                   ''),\n    ('  Precision',      f'{prec_4:.4f}',                 ''),\n    ('  Recall',         f'{rec_4:.4f}',                  ''),\n    ('  Cohen Kappa',    f'{kappa:.4f}',                  '>0.6 = substantial agreement'),\n    ('  MCC',            f'{mcc:.4f}',                    'Balanced metric'),\n    ('SEGMENTATION (MRI)', '', ''),\n    ('  Dice (mean)',    f\"{seg_df['dice'].mean():.4f}\",   ''),\n    ('  IoU (mean)',     f\"{seg_df['iou'].mean():.4f}\",    ''),\n    ('  Sensitivity',   f\"{seg_df['sensitivity'].mean():.4f}\", ''),\n    ('  Specificity',   f\"{seg_df['specificity'].mean():.4f}\", ''),\n    ('  Precision',     f\"{seg_df['precision'].mean():.4f}\",   ''),\n]\n\nfor metric, value, note in rows:\n    if value == '':\n        print(f'\\n  ── {metric} ──')\n    else:\n        note_str = f'   # {note}' if note else ''\n        print(f'  {metric:<30} {value:<12}{note_str}')\n\nprint('\\n' + '='*70)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-14T05:27:10.74645Z","iopub.execute_input":"2026-10-14T05:27:10.747245Z","iopub.status.idle":"2026-10-14T05:27:10.756935Z","shell.execute_reply.started":"2026-10-14T05:27:10.747213Z","shell.execute_reply":"2026-10-14T05:27:10.75584Z"}},"outputs":[{"name":"stdout","text":"======================================================================\n  FINAL SUMMARY — YOLOv11n-seg on BriscMat Test Set\n======================================================================\n\n  ── MODEL ──\n    Architecture                 YOLOv11n-seg (pretrained)   # Fine-tuned from COCO weights\n    Parameters                   ~1.9M          # Nano variant, fastest/lightest\n\n  ── GATE (MRI vs NonMRI) ──\n    Accuracy                     0.9648      \n    F1                           0.9775      \n\n  ── 5-CLASS OVERALL ──\n    Accuracy                     0.9188      \n    F1 Macro                     0.9071      \n\n  ── 4-CLASS MRI CLASSIFICATION ──\n    Accuracy                     0.9400      \n    F1 Macro                     0.9329      \n    Precision                    0.9275      \n    Recall                       0.9448      \n    Cohen Kappa                  0.9185         # >0.6 = substantial agreement\n    MCC                          0.9197         # Balanced metric\n\n  ── SEGMENTATION (MRI) ──\n    Dice (mean)                  0.8182      \n    IoU (mean)                   0.7370      \n    Sensitivity                  0.8843      \n    Specificity                  0.9975      \n    Precision                    0.8162      \n\n======================================================================\n","output_type":"stream"}],"execution_count":36},{"cell_type":"code","source":"# Paste each \"# %%\" block as a new cell at the END of your YOLO notebook.\n# Needs from the notebook: model_best, predict_single, mat_to_bgr, device,\n# train_files/train_labels, val_files/val_labels, test_mri_files/test_mri_labels,\n# MRI_CLASS_NAMES, IMG_SIZE.\n\n# %% 1. Install (run once, in its own cell)\n# !pip install timm -q\n\n# %% 2. Imports and settings\nimport numpy as np, cv2, torch, torch.nn as nn, timm, pandas as pd\nimport torchvision.transforms as T\nfrom torch.utils.data import Dataset, DataLoader\nfrom sklearn.metrics import (accuracy_score, f1_score, recall_score,\n                             roc_auc_score, classification_report,\n                             confusion_matrix)\nfrom tqdm import tqdm\n\nCROP      = 224\nPAD       = 0.15\nSEEDS     = [42, 43, 44]\nEP_HEAD   = 3\nEP_FT     = 12\nBATCH     = 32\nBACKBONE  = 'convnextv2_tiny'\nNUM_CLS   = 4             # 0 No Tumor, 1 Meningioma, 2 Glioma, 3 Pituitary\nMEAN, STD = [0.485, 0.456, 0.406], [0.229, 0.224, 0.225]\n\n# %% 3. Crop stage\ndef bbox_from_mask(mask, pad=PAD, min_size=48):\n    ys, xs = np.where(mask > 0.5)\n    if len(ys) == 0:\n        return None\n    H, W = mask.shape\n    y0, y1, x0, x1 = ys.min(), ys.max() + 1, xs.min(), xs.max() + 1\n    py, px = int((y1 - y0) * pad), int((x1 - x0) * pad)\n    y0, y1, x0, x1 = max(0, y0 - py), min(H, y1 + py), max(0, x0 - px), min(W, x1 + px)\n    if (y1 - y0) < min_size or (x1 - x0) < min_size:\n        cy, cx = (y0 + y1) // 2, (x0 + x1) // 2\n        h = min_size // 2\n        y0, y1, x0, x1 = max(0, cy - h), min(H, cy + h), max(0, cx - h), min(W, cx + h)\n    return y0, y1, x0, x1\n\ndef make_crop(img_bgr, box_mask):\n    box = bbox_from_mask(box_mask) if box_mask is not None else None\n    if box is not None:\n        y0, y1, x0, x1 = box\n        img_bgr = img_bgr[y0:y1, x0:x1]\n    return cv2.resize(img_bgr, (CROP, CROP), interpolation=cv2.INTER_LINEAR)\n\ndef build_items(files, labels, use_pred):\n    \"\"\"use_pred=False: crop from GT mask (training / oracle test).\n       use_pred=True : crop from YOLO prediction (real pipeline).\"\"\"\n    items = []\n    for f, l in tqdm(list(zip(files, labels)), desc=f'crops pred={use_pred}'):\n        try:\n            img_bgr, gt, _ = mat_to_bgr(f)\n        except Exception:\n            continue\n        if use_pred:\n            _, _, pm, _ = predict_single(model_best, img_bgr)\n            box_mask = None if pm is None else (\n                cv2.resize(pm.astype(np.float32), (IMG_SIZE, IMG_SIZE),\n                           interpolation=cv2.INTER_NEAREST) > 0.5)\n        else:\n            box_mask = gt if l > 0 else None\n        items.append((make_crop(img_bgr, box_mask), int(l)))\n    return items\n\ntrain_items     = build_items(train_files, train_labels, use_pred=False)\nval_items       = build_items(val_files,   val_labels,   use_pred=False)\ntest_items_gt   = build_items(test_mri_files, test_mri_labels, use_pred=False)\ntest_items_pred = build_items(test_mri_files, test_mri_labels, use_pred=True)\n\n# %% 4. Dataset and loaders\ntf_train = T.Compose([T.ToPILImage(), T.RandomHorizontalFlip(),\n                      T.RandomRotation(10), T.ColorJitter(0.2, 0.2),\n                      T.ToTensor(), T.Normalize(MEAN, STD)])\ntf_eval  = T.Compose([T.ToTensor(), T.Normalize(MEAN, STD)])\n\nclass CropDS(Dataset):\n    def __init__(self, items, train):\n        self.items, self.tf = items, (tf_train if train else tf_eval)\n    def __len__(self): return len(self.items)\n    def __getitem__(self, i):\n        crop, lbl = self.items[i]\n        return self.tf(crop), lbl\n\ndef loader(items, train):\n    return DataLoader(CropDS(items, train), batch_size=BATCH, shuffle=train,\n                      num_workers=2, pin_memory=True)\n\n# %% 5. Model, training and evaluation\ndef build_model():\n    return timm.create_model(BACKBONE, pretrained=True, num_classes=NUM_CLS).to(device)\n\n@torch.no_grad()\ndef predict(model, items):\n    model.eval()\n    ys, ps, pr = [], [], []\n    for x, y in loader(items, False):\n        p = torch.softmax(model(x.to(device)), 1).cpu().numpy()\n        ys += y.tolist(); ps += p.argmax(1).tolist(); pr.append(p)\n    return np.array(ys), np.array(ps), np.concatenate(pr)\n\ndef val_f1(model, items):\n    y, p, _ = predict(model, items)\n    return f1_score(y, p, average='macro', zero_division=0)\n\ndef train_one(seed):\n    torch.manual_seed(seed); np.random.seed(seed)\n    model = build_model()\n    counts = np.bincount([l for _, l in train_items], minlength=NUM_CLS)\n    w = torch.tensor(counts.sum() / (NUM_CLS * counts), dtype=torch.float32, device=device)\n    crit = nn.CrossEntropyLoss(weight=w, label_smoothing=0.1)\n    scaler = torch.cuda.amp.GradScaler(enabled=(device == 'cuda'))\n    best, best_state = -1, None\n    tl = loader(train_items, True)\n\n    for phase, epochs, lr in [('head', EP_HEAD, 1e-3), ('full', EP_FT, 1e-4)]:\n        for n, p in model.named_parameters():\n            p.requires_grad = True if phase == 'full' else n.startswith('head')\n        opt = torch.optim.AdamW([p for p in model.parameters() if p.requires_grad],\n                                lr=lr, weight_decay=0.05)\n        sched = torch.optim.lr_scheduler.CosineAnnealingLR(opt, T_max=epochs)\n        for ep in range(epochs):\n            model.train()\n            for x, y in tl:\n                x, y = x.to(device), y.to(device)\n                opt.zero_grad()\n                with torch.autocast(device_type='cuda', enabled=(device == 'cuda')):\n                    loss = crit(model(x), y)\n                scaler.scale(loss).backward(); scaler.step(opt); scaler.update()\n            sched.step()\n            f1 = val_f1(model, val_items)\n            if f1 > best:\n                best = f1\n                best_state = {k: v.detach().clone() for k, v in model.state_dict().items()}\n            print(f'seed {seed} | {phase} ep {ep+1:02d} | val macro-F1 {f1:.4f} (best {best:.4f})')\n    model.load_state_dict(best_state)\n    return model\n\ndef evaluate(model, items, name):\n    y, p, pr = predict(model, items)\n    r = dict(setting=name,\n             acc=accuracy_score(y, p),\n             f1=f1_score(y, p, average='macro', zero_division=0),\n             recall=recall_score(y, p, average='macro', zero_division=0),\n             auc=roc_auc_score(y, pr, multi_class='ovr'))\n    return r, (y, p)\n\nmodels, rows = [], []\nfor s in SEEDS:\n    m = train_one(s)\n    models.append(m)\n    for items, name in [(test_items_gt, 'GT-mask crop (oracle)'),\n                        (test_items_pred, 'YOLO-mask crop (pipeline)')]:\n        r, _ = evaluate(m, items, name); r['seed'] = s; rows.append(r)\n\nres = pd.DataFrame(rows)\nprint(res.groupby('setting')[['acc', 'f1', 'recall', 'auc']].agg(['mean', 'std']).round(4))\n\n# %% 6. Per-class report and confusion matrix (first seed, real pipeline)\ny, p = evaluate(models[0], test_items_pred, 'pipeline')[1]\nprint(classification_report(y, p, target_names=MRI_CLASS_NAMES, zero_division=0))\nprint(confusion_matrix(y, p, labels=list(range(NUM_CLS))))\ntorch.save(models[0].state_dict(), 'convnextv2_tiny_best.pt')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-14T05:27:14.202161Z","iopub.execute_input":"2026-10-14T05:27:14.203054Z","iopub.status.idle":"2026-10-14T06:03:00.710284Z","shell.execute_reply.started":"2026-10-14T05:27:14.203021Z","shell.execute_reply":"2026-10-14T06:03:00.709291Z"}},"outputs":[{"name":"stderr","text":"crops pred=False: 100%|██████████| 4000/4000 [00:23<00:00, 168.45it/s]\ncrops pred=False: 100%|██████████| 1000/1000 [00:06<00:00, 163.67it/s]\ncrops pred=False: 100%|██████████| 1000/1000 [00:06<00:00, 164.60it/s]\ncrops pred=True: 100%|██████████| 1000/1000 [00:20<00:00, 49.24it/s]\n","output_type":"stream"},{"name":"stdout","text":"seed 42 | head ep 01 | val macro-F1 0.8180 (best 0.8180)\nseed 42 | head ep 02 | val macro-F1 0.8027 (best 0.8180)\nseed 42 | head ep 03 | val macro-F1 0.8525 (best 0.8525)\nseed 42 | full ep 01 | val macro-F1 0.9343 (best 0.9343)\nseed 42 | full ep 02 | val macro-F1 0.9610 (best 0.9610)\nseed 42 | full ep 03 | val macro-F1 0.9323 (best 0.9610)\nseed 42 | full ep 04 | val macro-F1 0.9518 (best 0.9610)\nseed 42 | full ep 05 | val macro-F1 0.9741 (best 0.9741)\nseed 42 | full ep 06 | val macro-F1 0.9825 (best 0.9825)\nseed 42 | full ep 07 | val macro-F1 0.9704 (best 0.9825)\nseed 42 | full ep 08 | val macro-F1 0.9778 (best 0.9825)\nseed 42 | full ep 09 | val macro-F1 0.9759 (best 0.9825)