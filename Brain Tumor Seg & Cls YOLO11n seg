e":"2026-10-14T04:23:57.887234Z","shell.execute_reply.started":"2026-10-14T04:23:57.853877Z","shell.execute_reply":"2026-10-14T04:23:57.886626Z"}},"outputs":[{"name":"stdout","text":"Patching: /usr/local/lib/python3.12/dist-packages/ultralytics/utils/callbacks/raytune.py\n✅ raytune.py patched on disk\n","output_type":"stream"}],"execution_count":4},{"cell_type":"markdown","source":"## 2. Imports & Environment","metadata":{}},{"cell_type":"code","source":"import os, re, glob, random, shutil, time, warnings, yaml\nwarnings.filterwarnings('ignore')\n\nimport numpy as np\nimport scipy.io\nimport cv2\nfrom collections import Counter\nfrom pathlib import Path\nfrom sklearn.model_selection import train_test_split\nfrom sklearn.metrics import (\n    accuracy_score, f1_score, precision_score, recall_score,\n    classification_report, confusion_matrix,\n    roc_auc_score, cohen_kappa_score, matthews_corrcoef\n)\nimport matplotlib.pyplot as plt\nimport matplotlib.patches as mpatches\nimport seaborn as sns\nfrom tqdm import tqdm\n\nimport torch\nfrom ultralytics import YOLO\n\nprint(f'PyTorch   : {torch.__version__}')\nprint(f'CUDA      : {torch.cuda.is_available()}')\ndevice = 'cuda' if torch.cuda.is_available() else 'cpu'\nprint(f'Device    : {device}')\n\ntorch.manual_seed(42)\nnp.random.seed(42)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-14T04:23:57.888138Z","iopub.execute_input":"2026-10-14T04:23:57.888322Z","iopub.status.idle":"2026-10-14T04:23:59.427189Z","shell.execute_reply.started":"2026-10-14T04:23:57.888302Z","shell.execute_reply":"2026-10-14T04:23:59.426474Z"}},"outputs":[{"name":"stdout","text":"PyTorch   : 2.10.0+cu128\nCUDA      : True\nDevice    : cuda\n","output_type":"stream"}],"execution_count":5},{"cell_type":"markdown","source":"## 3. Configuration\n\nAll paths and hyperparameters in one place.  \nAdjust `BASE_PATH` to point to your BriscMat dataset root.","metadata":{}},{"cell_type":"code","source":"# ─────────────────────────────────────────────\n# CONFIGURATION\n# ─────────────────────────────────────────────\n\nBASE_PATH   = '/kaggle/input/datasets/vivanrv/briscmat-brain-tumour-mri-dataset-2026/BriscMat'\nYOLO_DATA   = '/kaggle/working/yolo_briscmat'   # where we write YOLO-format dataset\nRUNS_DIR    = '/kaggle/working/runs'\n\nIMG_SIZE    = 640       # YOLO native size (must be multiple of 32)\nBATCH_SIZE  = 16\nEPOCHS      = 15\nVAL_SPLIT   = 0.20\n\nNON_MRI_LABEL   = 4\nNUM_MRI_CLASSES = 4\nMRI_CLASS_NAMES = ['No Tumor', 'Meningioma', 'Glioma', 'Pituitary']\nALL_CLASS_NAMES = MRI_CLASS_NAMES + ['Non-MRI']\nCLASS_COLORS    = ['#2196F3','#4CAF50','#FF5722','#9C27B0','#607D8B']\n\n# Gate: if max YOLO confidence < this, treat as Non-MRI\nGATE_CONF_THRESH = 0.25\n\nprint('Configuration loaded.')\nprint(f'  Dataset root : {BASE_PATH}')\nprint(f'  YOLO data dir: {YOLO_DATA}')\nprint(f'  Image size   : {IMG_SIZE}×{IMG_SIZE}')\nprint(f'  Epochs       : {EPOCHS}')\nprint(f'  Classes      : {dict(enumerate(MRI_CLASS_NAMES))}')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-14T04:23:59.428063Z","iopub.execute_input":"2026-10-14T04:23:59.428352Z","iopub.status.idle":"2026-10-14T04:23:59.43442Z","shell.execute_reply.started":"2026-10-14T04:23:59.42833Z","shell.execute_reply":"2026-10-14T04:23:59.433536Z"}},"outputs":[{"name":"stdout","text":"Configuration loaded.\n  Dataset root : /kaggle/input/datasets/vivanrv/briscmat-brain-tumour-mri-dataset-2026/BriscMat\n  YOLO data dir: /kaggle/working/yolo_briscmat\n  Image size   : 640×640\n  Epochs       : 15\n  Classes      : {0: 'No Tumor', 1: 'Meningioma', 2: 'Glioma', 3: 'Pituitary'}\n","output_type":"stream"}],"execution_count":6},{"cell_type":"markdown","source":"## 4. Load .mat Files & Build Train/Val/Test Split\n\nWe load all `.mat` files, extract labels, and perform a **stratified 80/20 split** on the Train pool.  \nThe test set is kept completely locked until final evaluation.\n\n> **Non-MRI samples** are excluded from YOLO training (YOLO only learns the 4 MRI tumour classes).  \n> We handle Non-MRI detection separately via a confidence gate at inference time.","metadata":{}},{"cell_type":"code","source":"def numeric_sort_key(fp):\n    nums = re.findall(r'\\d+', fp.split('/')[-1])\n    return int(nums[0]) if nums else 0\n\ndef extract_label(mat_path):\n    try:\n        data = scipy.io.loadmat(mat_path)\n        for key in ['cjdata.label', 'label', 'tumorLabel', 'Class']:\n            if key in data:\n                val = data[key]\n                try:    return int(val[0][0])\n                except: return int(val.flat[0])\n    except:\n        pass\n    return NON_MRI_LABEL\n\ndef load_mat(mat_path):\n    \"\"\"Returns (image_np_float32, mask_np_float32, label_int)\"\"\"\n    data = scipy.io.loadmat(mat_path)\n    img_key = 'cjdata.image'     if 'cjdata.image'     in data else 'image'\n    msk_key = 'cjdata.tumorMask' if 'cjdata.tumorMask' in data else 'tumorMask'\n    lbl_key = 'cjdata.label'     if 'cjdata.label'     in data else 'label'\n    img  = data[img_key].astype(np.float32)\n    mask = data[msk_key].astype(np.float32) if msk_key in data else np.zeros_like(img)\n    lbl  = int(data[lbl_key].flat[0]) if lbl_key in data else NON_MRI_LABEL\n    return img, mask, lbl\n\n# ── Scan files ──\nall_train_mat = sorted(glob.glob(f'{BASE_PATH}/Train/*.mat'), key=numeric_sort_key)\ntest_mat      = sorted(glob.glob(f'{BASE_PATH}/Test/*.mat'),  key=numeric_sort_key)\nprint(f'Train pool : {len(all_train_mat)} files')\nprint(f'Test pool  : {len(test_mat)} files')\n\n# ── Extract labels ──\nprint('\\nReading labels (may take ~30s)...')\nall_train_labels = [extract_label(f) for f in tqdm(all_train_mat)]\n\ndist = dict(sorted(Counter(all_train_labels).items()))\nprint('\\nTrain class distribution:')\nfor lbl, cnt in dist.items():\n    print(f'  Label {lbl} ({ALL_CLASS_NAMES[lbl]:12s}): {cnt:5d}')\n\n# ── Stratified split (MRI only for YOLO training) ──\nmri_files  = [f for f,l in zip(all_train_mat, all_train_labels) if l < NON_MRI_LABEL]\nmri_labels = [l for l in all_train_labels if l < NON_MRI_LABEL]\n\ntrain_files, val_files, train_labels, val_labels = train_test_split(\n    mri_files, mri_labels, test_size=VAL_SPLIT, random_state=42, stratify=mri_labels\n)\n\n# Test MRI files only (for segmentation metrics)\nprint('\\nReading test labels...')\ntest_labels   = [extract_label(f) for f in tqdm(test_mat)]\ntest_mri_files  = [f for f,l in zip(test_mat, test_labels) if l < NON_MRI_LABEL]\ntest_mri_labels = [l for f,l in zip(test_mat, test_labels) if l < NON_MRI_LABEL]\ntest_nonmri_files = [f for f,l in zip(test_mat, test_labels) if l == NON_MRI_LABEL]\n\nprint(f'\\nSplit summary:')\nprint(f'  Train (MRI): {len(train_files)}')\nprint(f'  Val   (MRI): {len(val_files)}')\nprint(f'  Test  (MRI): {len(test_mri_files)}')\nprint(f'  Test (NonMRI): {len(test_nonmri_files)}')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-14T04:23:59.435447Z","iopub.execute_input":"2026-10-14T04:23:59.435773Z","iopub.status.idle":"2026-10-14T04:24:32.995112Z","shell.execute_reply.started":"2026-10-14T04:23:59.435733Z","shell.execute_reply":"2026-10-14T04:24:32.99431Z"}},"outputs":[{"name":"stdout","text":"Train pool : 6314 files\nTest pool  : 1306 files\n\nReading labels (may take ~30s)...\n","output_type":"stream"},{"name":"stderr","text":"100%|██████████| 6314/6314 [00:28<00:00, 224.22it/s]\n","output_type":"stream"},{"name":"stdout","text":"\nTrain class distribution:\n  Label 0 (No Tumor    ):  1067\n  Label 1 (Meningioma  ):  1329\n  Label 2 (Glioma      ):  1147\n  Label 3 (Pituitary   ):  1457\n  Label 4 (Non-MRI     ):  1314\n\nReading test labels...\n","output_type":"stream"},{"name":"stderr","text":"100%|██████████| 1306/1306 [00:05<00:00, 248.17it/s]","output_type":"stream"},{"name":"stdout","text":"\nSplit summary:\n  Train (MRI): 4000\n  Val   (MRI): 1000\n  Test  (MRI): 1000\n  Test (NonMRI): 306\n","output_type":"stream"},{"name":"stderr","text":"\n","output_type":"stream"}],"execution_count":7},{"cell_type":"markdown","source":"## 5. Convert BriscMat → YOLO Segmentation Format\n\nYOLO segmentation expects each image to have a paired `.txt` label file containing:\n```\n<class_id> <x1> <y1> <x2> <y2> ... <xn> <yn>   # polygon coords normalized 0-1\n```\n\nWe extract tumour mask contours from the `.mat` ground truth masks and convert them to YOLO polygon format.  \nFor **No Tumor** (label 0) images, we write an **empty label file** — YOLO treats these as background-only images.","metadata":{}},{"cell_type":"code","source":"def mask_to_yolo_polygon(mask_np, img_h, img_w, max_points=100):\n    \"\"\"\n    Convert binary mask → largest contour → YOLO normalized polygon string.\n    Returns None if mask is empty.\n    \"\"\"\n    mask_u8 = (mask_np > 0).astype(np.uint8)\n    if mask_u8.sum() == 0:\n        return None\n\n    contours, _ = cv2.findContours(mask_u8, cv2.RETR_EXTERNAL, cv2.CHAIN_APPROX_SIMPLE)\n    if not contours:\n        return None\n\n    # Largest contour only\n    cnt = max(contours, key=cv2.contourArea)\n    if len(cnt) < 3:\n        return None\n\n    # Downsample polygon if too many points\n    if len(cnt) > max_points:\n        step = len(cnt) // max_points\n        cnt  = cnt[::step]\n\n    pts = cnt.squeeze()  # (N, 2)\n    if pts.ndim == 1:    # only 1 point\n        return None\n\n    # Normalize\n    pts = pts.astype(np.float32)\n    pts[:, 0] /= img_w\n    pts[:, 1] /= img_h\n    pts = np.clip(pts, 0, 1)\n\n    coord_str = ' '.join(f'{x:.6f} {y:.6f}' for x, y in pts)\n    return coord_str\n\n\ndef write_yolo_dataset(file_list, label_list, split_name, out_root, img_size=640):\n    \"\"\"\n    Write images + YOLO label files for one split.\n    Images are saved as uint8 PNG (normalized, 3-channel).\n    \"\"\"\n    img_dir = Path(out_root) / 'images' / split_name\n    lbl_dir = Path(out_root) / 'labels' / split_name\n    img_dir.mkdir(parents=True, exist_ok=True)\n    lbl_dir.mkdir(parents=True, exist_ok=True)\n\n    skipped = 0\n    for mat_path, lbl in tqdm(zip(file_list, label_list),\n                              total=len(file_list),\n                              desc=f'Writing {split_name}'):\n        try:\n            img, mask, _ = load_mat(mat_path)\n        except Exception as e:\n            skipped += 1\n            continue\n\n        # Resize\n        img_rs  = cv2.resize(img,  (img_size, img_size), interpolation=cv2.INTER_LINEAR)\n        mask_rs = cv2.resize(mask, (img_size, img_size), interpolation=cv2.INTER_NEAREST)\n\n        # Normalize → uint8\n        img_rs = (img_rs - img_rs.min()) / (img_rs.max() - img_rs.min() + 1e-8)\n        img_u8 = (img_rs * 255).astype(np.uint8)\n        img_bgr = cv2.cvtColor(img_u8, cv2.COLOR_GRAY2BGR)  # YOLO expects 3 channels\n\n        stem = Path(mat_path).stem\n        cv2.imwrite(str(img_dir / f'{stem}.png'), img_bgr)\n\n        # Label file\n        label_txt = lbl_dir / f'{stem}.txt'\n        if lbl == 0:  # No Tumor → empty label\n            label_txt.write_text('')\n        else:         # Tumor → polygon\n            poly = mask_to_yolo_polygon(mask_rs, img_size, img_size)\n            if poly:\n                label_txt.write_text(f'{lbl - 1} {poly}\\n')  # shift: 1→0, 2→1, 3→2\n                # ^ YOLO class IDs: 0=Meningioma, 1=Glioma, 2=Pituitary\n            else:\n                label_txt.write_text('')  # mask empty → treat as no-tumor\n\n    print(f'  Done. Skipped {skipped} corrupt files.')\n\n\n# ── Write all splits ──\n# YOLO class mapping:\n#   mat label 0 (No Tumor)   → empty .txt  (background)\n#   mat label 1 (Meningioma) → class 0\n#   mat label 2 (Glioma)     → class 1\n#   mat label 3 (Pituitary)  → class 2\n\nprint('Writing YOLO-format dataset...')\nwrite_yolo_dataset(train_files, train_labels, 'train', YOLO_DATA)\nwrite_yolo_dataset(val_files,   val_labels,   'val',   YOLO_DATA)\nwrite_yolo_dataset(test_mri_files, test_mri_labels, 'test', YOLO_DATA)\nprint(