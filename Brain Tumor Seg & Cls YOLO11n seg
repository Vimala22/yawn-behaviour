                             \n","GT-mask crop (oracle)      0.9593  0.0059  0.9649  0.0051  0.9644  0.0051   \n","YOLO-mask crop (pipeline)  0.9333  0.0058  0.9291  0.0049  0.9394  0.0050   \n","\n","                              auc          \n","                             mean     std  \n","setting                                    \n","GT-mask crop (oracle)      0.9943  0.0012  \n","YOLO-mask crop (pipeline)  0.9789  0.0019  \n","              precision    recall  f1-score   support\n","\n","    No Tumor       0.83      1.00      0.91       140\n","  Meningioma       0.94      0.95      0.94       306\n","      Glioma       0.96      0.86      0.91       254\n","   Pituitary       0.95      0.94      0.94       300\n","\n","    accuracy                           0.93      1000\n","   macro avg       0.92      0.94      0.93      1000\n","weighted avg       0.93      0.93      0.93      1000\n","\n","[[140   0   0   0]\n"," [  1 291   7   7]\n"," [ 23   6 218   7]\n"," [  4  14   1 281]]\n"]}],"source":["# Paste each \"# %%\" block as a new cell at the END of your YOLO notebook.\n","# Needs from the notebook: model_best, predict_single, mat_to_bgr, device,\n","# train_files/train_labels, val_files/val_labels, test_mri_files/test_mri_labels,\n","# MRI_CLASS_NAMES, IMG_SIZE.\n","\n","# %% 1. Install (run once, in its own cell)\n","# !pip install timm -q\n","\n","# %% 2. Imports and settings\n","import numpy as np, cv2, torch, torch.nn as nn, timm, pandas as pd\n","import torchvision.transforms as T\n","from torch.utils.data import Dataset, DataLoader\n","from sklearn.metrics import (accuracy_score, f1_score, recall_score,\n","                             roc_auc_score, classification_report,\n","                             confusion_matrix)\n","from tqdm import tqdm\n","\n","CROP      = 224\n","PAD       = 0.15\n","SEEDS     = [42, 43, 44]\n","EP_HEAD   = 3\n","EP_FT     = 12\n","BATCH     = 32\n","BACKBONE  = 'convnextv2_tiny'\n","NUM_CLS   = 4             # 0 No Tumor, 1 Meningioma, 2 Glioma, 3 Pituitary\n","MEAN, STD = [0.485, 0.456, 0.406], [0.229, 0.224, 0.225]\n","\n","# %% 3. Crop stage\n","def bbox_from_mask(mask, pad=PAD, min_size=48):\n","    ys, xs = np.where(mask > 0.5)\n","    if len(ys) == 0:\n","        return None\n","    H, W = mask.shape\n","    y0, y1, x0, x1 = ys.min(), ys.max() + 1, xs.min(), xs.max() + 1\n","    py, px = int((y1 - y0) * pad), int((x1 - x0) * pad)\n","    y0, y1, x0, x1 = max(0, y0 - py), min(H, y1 + py), max(0, x0 - px), min(W, x1 + px)\n","    if (y1 - y0) < min_size or (x1 - x0) < min_size:\n","        cy, cx = (y0 + y1) // 2, (x0 + x1) // 2\n","        h = min_size // 2\n","        y0, y1, x0, x1 = max(0, cy - h), min(H, cy + h), max(0, cx - h), min(W, cx + h)\n","    return y0, y1, x0, x1\n","\n","def make_crop(img_bgr, box_mask):\n","    box = bbox_from_mask(box_mask) if box_mask is not None else None\n","    if box is not None:\n","        y0, y1, x0, x1 = box\n","        img_bgr = img_bgr[y0:y1, x0:x1]\n","    return cv2.resize(img_bgr, (CROP, CROP), interpolation=cv2.INTER_LINEAR)\n","\n","def build_items(files, labels, use_pred):\n","    \"\"\"use_pred=False: crop from GT mask (training / oracle test).\n","       use_pred=True : crop from YOLO prediction (real pipeline).\"\"\"\n","    items = []\n","    for f, l in tqdm(list(zip(files, labels)), desc=f'crops pred={use_pred}'):\n","        try:\n","            img_bgr, gt, _ = mat_to_bgr(f)\n","        except Exception:\n","            continue\n","        if use_pred:\n","            _, _, pm, _ = predict_single(model_best, img_bgr)\n","            box_mask = None if pm is None else (\n","                cv2.resize(pm.astype(np.float32), (IMG_SIZE, IMG_SIZE),\n","                           interpolation=cv2.INTER_NEAREST) > 0.5)\n","        else:\n","            box_mask = gt if l > 0 else None\n","        items.append((make_crop(img_bgr, box_mask), int(l)))\n","    return items\n","\n","train_items     = build_items(train_files, train_labels, use_pred=False)\n","val_items       = build_items(val_files,   val_labels,   use_pred=False)\n","test_items_gt   = build_items(test_mri_files, test_mri_labels, use_pred=False)\n","test_items_pred = build_items(test_mri_files, test_mri_labels, use_pred=True)\n","\n","# %% 4. Dataset and loaders\n","tf_train = T.Compose([T.ToPILImage(), T.RandomHorizontalFlip(),\n","                      T.RandomRotation(10), T.ColorJitter(0.2, 0.2),\n","                      T.ToTensor(), T.Normalize(MEAN, STD)])\n","tf_eval  = T.Compose([T.ToTensor(), T.Normalize(MEAN, STD)])\n","\n","class CropDS(Dataset):\n","    def __init__(self, items, train):\n","        self.items, self.tf = items, (tf_train if train else tf_eval)\n","    def __len__(self): return len(self.items)\n","    def __getitem__(self, i):\n","        crop, lbl = self.items[i]\n","        return self.tf(crop), lbl\n","\n","def loader(items, train):\n","    return DataLoader(CropDS(items, train), batch_size=BATCH, shuffle=train,\n","                      num_workers=2, pin_memory=True)\n","\n","# %% 5. Model, training and evaluation\n","def build_model():\n","    return timm.create_model(BACKBONE, pretrained=True, num_classes=NUM_CLS).to(device)\n","\n","@torch.no_grad()\n","def predict(model, items):\n","    model.eval()\n","    ys, ps, pr = [], [], []\n","    for x, y in loader(items, False):\n","        p = torch.softmax(model(x.to(device)), 1).cpu().numpy()\n","        ys += y.tolist(); ps += p.argmax(1).tolist(); pr.append(p)\n","    return np.array(ys), np.array(ps), np.concatenate(pr)\n","\n","def val_f1(model, items):\n","    y, p, _ = predict(model, items)\n","    return f1_score(y, p, average='macro', zero_division=0)\n","\n","def train_one(seed):\n","    torch.manual_seed(seed); np.random.seed(seed)\n","    model = build_model()\n","    counts = np.bincount([l for _, l in train_items], minlength=NUM_CLS)\n","    w = torch.tensor(counts.sum() / (NUM_CLS * counts), dtype=torch.float32, device=device)\n","    crit = nn.CrossEntropyLoss(weight=w, label_smoothing=0.1)\n","    scaler = torch.cuda.amp.GradScaler(enabled=(device == 'cuda'))\n","    best, best_state = -1, None\n","    tl = loader(train_items, True)\n","\n","    for phase, epochs, lr in [('head', EP_HEAD, 1e-3), ('full', EP_FT, 1e-4)]:\n","        for n, p in model.named_parameters():\n","            p.requires_grad = True if phase == 'full' else n.startswith('head')\n","        opt = torch.optim.AdamW([p for p in model.parameters() if p.requires_grad],\n","                                lr=lr, weight_decay=0.05)\n","        sched = torch.optim.lr_scheduler.CosineAnnealingLR(opt, T_max=epochs)\n","        for ep in range(epochs):\n","            model.train()\n","            for x, y in tl:\n","                x, y = x.to(device), y.to(device)\n","                opt.zero_grad()\n","                with torch.autocast(device_type='cuda', enabled=(device == 'cuda')):\n","                    loss = crit(model(x), y)\n","                scaler.scale(loss).backward(); scaler.step(opt); scaler.update()\n","            sched.step()\n","            f1 = val_f1(model, val_items)\n","            if f1 > best:\n","                best = f1\n","                best_state = {k: v.detach().clone() for k, v in model.state_dict().items()}\n","            print(f'seed {seed} | {phase} ep {ep+1:02d} | val macro-F1 {f1:.4f} (best {best:.4f})')\n","    model.load_state_dict(best_state)\n","    return model\n","\n","def evaluate(model, items, name):\n","    y, p, pr = predict(model, items)\n","    r = dict(setting=name,\n","             acc=accuracy_score(y, p),\n","             f1=f1_score(y, p, average='macro', zero_division=0),\n","             recall=recall_score(y, p, average='macro', zero_division=0),\n","             auc=roc_auc_score(y, pr, multi_class='ovr'))\n","    return r, (y, p)\n","\n","models, rows = [], []\n","for s in SEEDS:\n","    m = train_one(s)\n","    models.append(m)\n","    for items, name in [(test_items_gt, 'GT-mask crop (oracle)'),\n","                        (test_items_pred, 'YOLO-mask crop (pipeline)')]:\n","        r, _ = evaluate(m, items, name); r['seed'] = s; rows.append(r)\n","\n","res = pd.DataFrame(rows)\n","print(res.groupby('setting')[['acc', 'f1', 'recall', 'auc']].agg(['mean', 'std']).round(4))\n","\n","# %% 6. Per-class report and confusion matrix (first seed, real pipeline)\n","y, p = evaluate(models[0], test_items_pred, 'pipeline')[1]\n","print(classification_report(y, p, target_names=MRI_CLASS_NAMES, zero_division=0))\n","print(confusion_matrix(y, p, labels=list(range(NUM_CLS))))\n","torch.save(models[0].state_dict(), 'convnextv2_tiny_best.pt')"]},{"cell_type":"code","execution_count":26,"id":"e406cf88","metadata":{"execution":{"iopub.execute_input":"2026-10-14T11:12:36.476348Z","iopub.status.busy":"2026-10-14T11:12:36.475747Z","iopub.status.idle":"2026-10-14T11:43:21.900625Z","shell.execute_reply":"2026-10-14T11:43:21.899753Z"},"papermill":{"duration":1845.945977,"end_time":"2026-10-14T11:43:21.902232+00:00","exception":false,"start_time":"2026-10-14T11:12:35.956255+00:00","status":"completed"},"tags":[]},"outputs":[{"name":"stdout","output_type":"stream","text":["convnextv2_tiny | seed 42 | head ep 01 | val macro-F1 0.8209 (best 0.8209)\n","convnextv2_tiny | seed 42 | head ep 02 | val macro-F1 0.8013 (best 0.8209)\n","convnextv2_tiny | seed 42 | head ep 03 | val macro-F1 0.8545 (best 0.8545)\n","convnextv2_tiny | seed 42 | full ep 01 | val macro-F1 0.9400 (best 0.9400)\n","convnextv2_tiny | seed 42 | full ep 02 | val macro-F1 0.9581 (best 0.9581)\n","convnextv2_tiny | seed 42 | full ep 03 | val macro-F1 0.9582 (best 0.9582)\n","convnextv2_tiny | seed 42 | full ep 04 | val macro-F1 0.9590 (best 0.9590)\n","convnextv2_tiny | seed 42 | full ep 05 | val macro-F1 0.9358 (best 0.9590)\n","convnextv2_tiny | seed 42 | full ep 06 | val macro-F1 0.9779 (best 0.9779)\n","convnextv2_tiny | seed 42 | full ep 07 | val macro-F1 0.9696 (bes