axis=1, keepdims=True).clip(min=1)\n        sns.heatmap(cm_norm, annot=cm, fmt='d', cmap='Blues', vmin=0, vmax=1,\n                    cbar=False, ax=axes[i, j],\n                    xticklabels=MRI_CLASS_NAMES, yticklabels=MRI_CLASS_NAMES)\n        acc = accuracy_score(y, p)\n        axes[i, j].set_title(f'{name}\\n{setting}\\nacc {acc:.3f}', fontsize=10, fontweight='bold')\n        axes[i, j].set_xlabel('Predicted'); axes[i, j].set_ylabel('True')\n        axes[i, j].tick_params(axis='x', rotation=30)\nplt.tight_layout(); plt.savefig('confusion_matrices.png', dpi=150, bbox_inches='tight'); plt.show()\n\n# %% 12. Overall metrics table and bar chart\ndef metric_row(y, p, pr):\n    return dict(accuracy=accuracy_score(y, p),\n                precision=precision_score(y, p, average='macro', zero_division=0),\n                recall=recall_score(y, p, average='macro', zero_division=0),\n                f1=f1_score(y, p, average='macro', zero_division=0),\n                auc=roc_auc_score(y, pr, multi_class='ovr'))\n\nrows_ = []\nfor (name, setting), (y, p, pr) in preds.items():\n    r = metric_row(y, p, pr); r.update(model=name, setting=setting); rows_.append(r)\nmt = pd.DataFrame(rows_).set_index(['model', 'setting']).round(4)\nprint(mt)\nmt.to_csv('all_model_metrics.csv')\n\npipe = mt.xs(SETTINGS[1], level='setting')\nlo = max(0.0, np.floor((pipe.values.min() - 0.02) * 20) / 20)    # truncated y-axis\nax = pipe.plot(kind='bar', figsize=(10, 4.5), rot=0, width=0.8, edgecolor='white')\nax.set_ylim(lo, 1.0); ax.set_ylabel('Score')\nax.set_title(f'Test metrics, YOLO-mask crops (y-axis starts at {lo:.2f})', fontweight='bold')\nax.grid(axis='y', alpha=0.3); ax.legend(ncol=5, loc='lower center', fontsize=9)\nplt.tight_layout(); plt.savefig('metrics_comparison.png', dpi=150); plt.show()\n\n# %% 13. Per-class F1 and the cost of segmentation errors\npc = {}\nfor (name, setting), (y, p, _) in preds.items():\n    pc[(name, setting)] = f1_score(y, p, average=None, labels=list(range(NUM_CLS)),\n                                   zero_division=0)\npc = pd.DataFrame(pc, index=MRI_CLASS_NAMES).T.round(4)\npc.index.names = ['model', 'setting']\nprint(pc)\n\nfig, ax = plt.subplots(figsize=(7, 4))\nsns.heatmap(pc.xs(SETTINGS[1], level='setting'), annot=True, fmt='.3f',\n            cmap='YlGnBu', vmin=0.5, vmax=1, ax=ax)\nax.set_title('Per-class F1 (YOLO-mask crops)', fontweight='bold')\nplt.tight_layout(); plt.savefig('per_class_f1.png', dpi=150); plt.show()\n\ndrop = (mt['f1'].xs(SETTINGS[0], level='setting')\n        - mt['f1'].xs(SETTINGS[1], level='setting')).round(4)\nprint('\\nMacro-F1 lost when using YOLO masks instead of GT masks:\\n', drop)\n\n# %% 14. Micro-average ROC curves (YOLO-mask crops)\nfig, ax = plt.subplots(figsize=(6, 5))\nfor name in models_:\n    y, _, pr = preds[(name, SETTINGS[1])]\n    yb = label_binarize(y, classes=list(range(NUM_CLS)))\n    fpr, tpr, _ = roc_curve(yb.ravel(), pr.ravel())\n    ax.plot(fpr, tpr, lw=2, label=f'{name} (AUC {auc(fpr, tpr):.3f})')\nax.plot([0, 1], [0, 1], 'k--', lw=1)\nax.set_xlabel('False positive rate'); ax.set_ylabel('True positive rate')\nax.set_title('Micro-average ROC', fontweight='bold'); ax.legend(loc='lower right')\nax.grid(alpha=0.3); plt.tight_layout(); plt.savefig('roc_comparison.png', dpi=150); plt.show()\n\n# %% 15. Full image vs crops (only if you ran baseline_full_image_comparison.py)\nif 'res' in globals() and 'Full image (no segmentation)' in set(res['setting']):\n    order = ['Full image (no segmentation)', 'GT-mask crop (oracle)', 'YOLO-mask crop (pipeline)']\n    g = res.groupby('setting')[['acc', 'f1', 'recall', 'auc']].agg(['mean', 'std']).loc[order]\n    means = g.xs('mean', axis=1, level=1)\n    stds  = g.xs('std',  axis=1, level=1).fillna(0)\n    lo2 = max(0.0, np.floor((means.values.min() - 0.02) * 20) / 20)\n    ax = means.plot(kind='bar', yerr=stds, capsize=3, figsize=(9, 4.5), rot=10, width=0.8)\n    ax.set_ylim(lo2, 1.0); ax.grid(axis='y', alpha=0.3)\n    ax.set_title(f'ConvNeXt-V2 Tiny by input type, mean ± std (y-axis starts at {lo2:.2f})',\n                 fontweight='bold')\n    plt.tight_layout(); plt.savefig('input_comparison.png', dpi=150); plt.show()\nelse:\n    print('Skipped: run baseline_full_image_comparison.py first to compare input types.')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-14T05:06:24.010005Z","iopub.status.idle":"2026-10-14T05:06:24.010418Z","shell.execute_reply.started":"2026-10-14T05:06:24.0102Z","shell.execute_reply":"2026-10-14T05:06:24.010223Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"BACKBONE = 'convnextv2_tiny'\nrows = [r for r in rows if r['setting'] != 'Full image (no segmentation)']\n\ndef build_full(files, labels):\n    items = []\n    for f, l in tqdm(list(zip(files, labels)), desc='full images'):\n        try:\n            img_bgr, _, _ = mat_to_bgr(f)\n        except Exception:\n            continue\n        items.append((make_crop(img_bgr, None), int(l)))\n    return items\n\nfull_train = build_full(train_files, train_labels)\nfull_val   = build_full(val_files,   val_labels)\nfull_test  = build_full(test_mri_files, test_mri_labels)\n\ncrop_train, crop_val = train_items, val_items\n\ntrain_items, val_items = full_train, full_val\nfor s in SEEDS:\n    m = train_one(s)\n    r, _ = evaluate(m, full_test, 'Full image (no segmentation)')\n    r['seed'] = s\n    rows.append(r)\n\ntrain_items, val_items = crop_train, crop_val\n\nres = pd.DataFrame(rows)\norder = ['Full image (no segmentation)',\n         'GT-mask crop (oracle)',\n         'YOLO-mask crop (pipeline)']\nsummary = (res.groupby('setting')[['acc', 'f1', 'recall', 'auc']]\n              .agg(['mean', 'std']).round(4).loc[order])\nprint(summary)\nsummary.to_csv('input_comparison.csv')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-14T06:47:09.349979Z","iopub.execute_input":"2026-10-14T06:47:09.350813Z","iopub.status.idle":"2026-10-14T07:22:09.43298Z","sh