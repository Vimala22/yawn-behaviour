1]),\n    ('train/cls_loss',    'Train Cls Loss',    '#1E88E5', axes[0,2]),\n    ('train/dfl_loss',    'Train DFL Loss',    '#FF6F00', axes[0,3]),\n    ('metrics/mAP50(B)',  'mAP@50 (Box)',      '#8E24AA', axes[1,0]),\n    ('metrics/mAP50-95(B)','mAP@50-95 (Box)', '#1565C0', axes[1,1]),\n    ('metrics/mAP50(M)',  'mAP@50 (Mask)',     '#00897B', axes[1,2]),\n    ('val/seg_loss',      'Val Seg Loss',      '#E53935', axes[1,3]),\n]\n\nfor col, title, color, ax in plots:\n    if col in df.columns:\n        ax.plot(df[col].values, color=color, linewidth=2)\n        ax.set_title(title, fontweight='bold')\n        ax.set_xlabel('Epoch'); ax.grid(True, alpha=0.3)\n    else:\n        ax.set_title(f'{title}\\n(not available)', fontweight='bold', color='gray')\n        ax.axis('off')\n\nplt.suptitle('YOLOv11n-seg Training History', fontsize=14, fontweight='bold')\nplt.tight_layout(); plt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-14T05:06:30.835186Z","iopub.execute_input":"2026-10-14T05:06:30.83592Z","iopub.status.idle":"2026-10-14T05:06:31.831244Z","shell.execute_reply.started":"2026-10-14T05:06:30.835889Z","shell.execute_reply":"2026-10-14T05:06:31.830419Z"}},"outputs":[{"name":"stdout","text":"Available columns: ['epoch', 'train/box_loss', 'train/seg_loss', 'train/cls_loss', 'train/dfl_loss', 'metrics/precision(B)', 'metrics/recall(B)', 'metrics/mAP50(B)', 'metrics/mAP50-95(B)', 'metrics/precision(M)', 'metrics/recall(M)', 'metrics/mAP50(M)', 'metrics/mAP50-95(M)', 'val/box_loss', 'val/seg_loss', 'val/cls_loss', 'val/dfl_loss', 'lr/pg0', 'lr/pg1', 'lr/pg2']\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 2400x900 with 8 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":27},{"cell_type":"code","source":"def predict_single(model, img_path_or_np, conf=0.25, iou=0.45):\n    \"\"\"\n    Run YOLOv11n-seg on one image.\n    Returns:\n        pred_class    : int  (0-3 MRI class, or 4 for Non-MRI)\n        max_conf      : float\n        seg_mask      : np.ndarray (H, W) binary, or None\n        raw_result    : ultralytics Result object\n    \"\"\"\n    results = model.predict(\n        source     = img_path_or_np,\n        conf       = conf,\n        iou        = iou,\n        imgsz      = IMG_SIZE,\n        verbose    = False,\n        save       = False,\n    )\n    r = results[0]\n\n    # No detection at all → No Tumor (class 0)\n    if r.boxes is None or len(r.boxes) == 0:\n        return 0, 0.0, None, r\n\n    # Pick highest-confidence detection\n    confs   = r.boxes.conf.cpu().numpy()\n    classes = r.boxes.cls.cpu().numpy().astype(int)\n    best_i  = int(np.argmax(confs))\n    best_cls = classes[best_i]      # 0=Meningioma, 1=Glioma, 2=Pituitary\n    best_conf = float(confs[best_i])\n\n    # Remap YOLO class → mat label\n    # YOLO: 0→Meningioma(1), 1→Glioma(2), 2→Pituitary(3)\n    pred_mat_class = best_cls + 1  # 1, 2, or 3\n\n    # Extract mask for best detection\n    seg_mask = None\n    if r.masks is not None:\n        masks_np = r.masks.data.cpu().numpy()   # (N, H, W) binary\n        seg_mask = masks_np[best_i]             # (H, W)\n\n    return pred_mat_class, best_conf, seg_mask, r\n\n\nprint('predict_single() helper defined.')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-14T05:06:35.986964Z","iopub.execute_input":"2026-10-14T05:06:35.987485Z","iopub.status.idle":"2026-10-14T05:06:35.994425Z","shell.execute_reply.started":"2026-10-14T05:06:35.987454Z","shell.execute_reply":"2026-10-14T05:06:35.993611Z"}},"outputs":[{"name":"stdout","text":"predict_single() helper defined.\n","output_type":"stream"}],"execution_count":28},{"cell_type":"markdown","source":"## 11. Helper — Gate Function\n\nSince YOLO only knows the 4 MRI classes, we need a lightweight **Non-MRI gate**:  \nif YOLO's maximum detection confidence across all predictions is below `GATE_CONF_THRESH`, we label the image as Non-MRI.\n\nThis works because real MRI tumour scans produce confident detections, while random/non-MRI images produce only low-confidence noise.","metadata":{}},{"cell_type":"markdown","source":"## 12. Test Set Inference\n\nFull gated pipeline on the locked test set:\n\n1. Load image from `.mat`  \n2. Run YOLOv11n-seg  \n3. Gate: low confidence → Non-MRI  \n4. Collect predictions, segmentation masks, and ground truth for metrics","metadata":{}},{"cell_type":"code","source":"# ── Helper to prep image for inference ──\ndef mat_to_bgr(mat_path, size=640):\n    img, mask, lbl = load_mat(mat_path)\n    img_rs   = cv2.resize(img,  (size, size), interpolation=cv2.INTER_LINEAR)\n    mask_rs  = cv2.resize(mask, (size, size), interpolation=cv2.INTER_NEAREST)\n    img_norm = (img_rs - img_rs.min()) / (img_rs.max() - img_rs.min() + 1e-8)\n    img_u8   = (img_norm * 255).astype(np.uint8)\n    img_bgr  = cv2.cvtColor(img_u8, cv2.COLOR_GRAY2BGR)\n    return img_bgr, (mask_rs > 0).astype(np.float32), lbl\n\ndef compute_seg_metrics(pred_mask, gt_mask):\n    \"\"\"Compute Dice, IoU, sensitivity, specificity on binary masks.\"\"\"\n    p = (pred_mask > 0.5).astype(np.float32).flatten()\n    t = (gt_mask   > 0.5).astype(np.float32).flatten()\n    inter = (p * t).sum()\n    TP = inter\n    FP = p.sum() - TP\n    FN = t.sum() - TP\n    TN = len(p) - TP - FP - FN\n    dice = (2*TP + 1e-6) / (p.sum() + t.sum() + 1e-6)\n    iou  = (TP + 1e-6) / (TP + FP + FN + 1e-6)\n    sens = (TP + 1e-6) / (TP + FN + 1e-6)\n    spec = (TN + 1e-6) / (TN + FP + 1e-6)\n    prec = (TP + 1e-6) / (TP + FP + 1e-6)\n    return dict(dice=dice, iou=iou, sensitivity=sens, specificity=spec, precision=prec)\n\n# ── Full test inference ──\nprint('Running inference on test set...')\nprint(f'  MRI samples  : {len(test_mri_files)}')\nprint(f'  NonMRI samples: {len(test_nonmri_files)}')\n\nall_true, all_pred   = [], []\nmri_true, mri_pred   = [], []\nseg_metrics_list     = []\nconf_list            = []\nviz_samples          = {}\n\n# ── MRI test samples ──\nfor mat_path, true_lbl in tqdm(zip(test_mri_files, test_mri_labels), total=len(test_mri_files)):\n    try:\n        img_bgr, gt_mask, _ = mat_to_bgr(mat_path)\n    except:\n        continue\n\n    pred_cls, max_conf, seg_mask, raw_r = predict_single(model_best, img_bgr)\n    conf_list.append(max_conf)\n\n    all_true.append(true_lbl)\n    all_pred.append(pred_cls)\n    mri_true.append(true_lbl)\n    mri_pred.append(pred_cls)\n\n    # Resize predicted mask to match GT size\n    if seg_mask is not None:\n        seg_resized = cv2.resize(seg_mask.astype(np.float32),\n                                 (IMG_SIZE, IMG_SIZE),\n                                 interpolation=cv2.INTER_NEAREST)\n    else:\n        seg_resized = np.zeros((IMG_SIZE, IMG_SIZE), dtype=np.float32)\n\n    m = compute_seg_metrics(seg_resized, gt_mask)\n    m['true_class'] = true_lbl\n    seg_metrics_list.append(m)\n\n    # Store one sample per class for visualization\n    if true_lbl not in viz_samples:\n        viz_samples[true_lbl] = {\n            'img'     : img_bgr,\n            'gt_mask' : gt_mask,\n            'pred_mask': seg_resized,\n            'pred_cls': pred_cls,\n            'conf'    : max_conf,\n        }\n\n# ── NonMRI test samples ──\nfor mat_path in tqdm(test_nonmri_files, desc='NonMRI'):\n    try:\n        img_bgr, _, _ = mat_to_bgr(mat_path)\n    except:\n        continue\n    _, max_conf, _, _ = predict_single(model_best, img_bgr)\n    # Gate: low confidence → Non-MRI\n    pred_cls = NON_MRI_LABEL if max_conf < GATE_CONF_THRESH else 0\n    all_true.append(NON_MRI_LABEL)\n    all_pred.append(pred_cls)\n\nprint(f'\\nInference complete on {len(all_true)} test images.')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-10-14T05:06:40.707154Z","iopub.execute_input":"2026-10-14T05:06:40.707771Z","iopub.status.idle":"2026-10-14T05:07:06.655921Z","shell.execute_reply.started":"2026-10-14T05:06:40.70774Z","shell.execute_reply":"2026-10-14T05:07:06.655135Z"}},"outputs":[{