; gc.collect(); torch.cuda.empty_cache()\n","print('Collected predictions for', len(preds), 'model/setting pairs')\n","\n","# %% 11. Confusion matrices (rows = true class, colour = row-normalised, text = counts)\n","models_ = list(BACKBONES.keys())\n","fig, axes = plt.subplots(len(SETTINGS), len(models_),\n","                         figsize=(4.6 * len(models_), 4.4 * len(SETTINGS)))\n","for i, setting in enumerate(SETTINGS):\n","    for j, name in enumerate(models_):\n","        y, p, _ = preds[(name, setting)]\n","        cm = confusion_matrix(y, p, labels=list(range(NUM_CLS)))\n","        cm_norm = cm / cm.sum(axis=1, keepdims=True).clip(min=1)\n","        sns.heatmap(cm_norm, annot=cm, fmt='d', cmap='Blues', vmin=0, vmax=1,\n","                    cbar=False, ax=axes[i, j],\n","                    xticklabels=MRI_CLASS_NAMES, yticklabels=MRI_CLASS_NAMES)\n","        acc = accuracy_score(y, p)\n","        axes[i, j].set_title(f'{name}\\n{setting}\\nacc {acc:.3f}', fontsize=10, fontweight='bold')\n","        axes[i, j].set_xlabel('Predicted'); axes[i, j].set_ylabel('True')\n","        axes[i, j].tick_params(axis='x', rotation=30)\n","plt.tight_layout(); plt.savefig('confusion_matrices.png', dpi=150, bbox_inches='tight'); plt.show()\n","\n","# %% 12. Overall metrics table and bar chart\n","def metric_row(y, p, pr):\n","    return dict(accuracy=accuracy_score(y, p),\n","                precision=precision_score(y, p, average='macro', zero_division=0),\n","                recall=recall_score(y, p, average='macro', zero_division=0),\n","                f1=f1_score(y, p, average='macro', zero_division=0),\n","                auc=roc_auc_score(y, pr, multi_class='ovr'))\n","\n","rows_ = []\n","for (name, setting), (y, p, pr) in preds.items():\n","    r = metric_row(y, p, pr); r.update(model=name, setting=setting); rows_.append(r)\n","mt = pd.DataFrame(rows_).set_index(['model', 'setting']).round(4)\n","print(mt)\n","mt.to_csv('all_model_metrics.csv')\n","\n","pipe = mt.